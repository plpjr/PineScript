// =============================================================================
// GENERATED FILE -- DO NOT EDIT
//
// Built from Structure_Break_Signals.pine by tools/build_strategy.py.
// Edit the indicator (for detection) or tools/strategy_tail.pine (for trade
// logic), then re-run:
//
//     python3 tools/build_strategy.py
//
// Everything below is the indicator source verbatim except the declaration
// line and the removal of alertcondition() calls, which Pine rejects in
// strategy scripts. The trade logic is appended at the end.
//
// EXPECTED WARNINGS: two barstate.islast warnings, from the live-level lines
// and the status table. Both are chart furniture that take no part in any
// trade decision, and a backtest runs on confirmed bars where barstate.islast
// behaves normally. Do NOT "fix" them with calc_on_every_tick = true -- that
// makes the strategy evaluate intrabar, which produces backtests that cannot
// be reproduced, and contradicts process_orders_on_close = true below.
// =============================================================================
// =============================================================================
// Structure Break Signals  —  v7.10
//
// NEW IN v7.10 — SIGNAL QUALITY DIAGNOSTIC (⑬):
//   * Answers the one question a backtest structurally cannot: are the BREAKS
//     THEMSELVES any good, separately from how you trade them? A backtest
//     measures detection, entry timing, exit rules and costs simultaneously,
//     so a bad result there could come from any of the four and you cannot
//     see through the stack to find out which.
//   * Measures forward excursion after each break: how far price travelled in
//     the signal's favour (MFE) versus against it (MAE) over the next N bars,
//     in ATR. No entries, stops, targets or fees involved.
//   * Split into HIGH and LOW score buckets and shown in the status table, so
//     the question "does the confidence score actually rank breaks?" reads
//     straight off the chart rather than needing a spreadsheet.
//       MFE > MAE          -> breaks lead somewhere; losses are a TRADING
//                             problem (entry timing, exits, costs)
//       MFE ~= MAE         -> breaks are coin flips; no trade rule fixes that
//       hi bucket > lo     -> the score ranks correctly, a threshold helps
//       no difference      -> the score is decoration
//   * Also exported per-sample for spreadsheet analysis.
//   * OFF by default — it costs a little performance and is a diagnostic, not
//     something to leave running.
//   * Looks at no future data: a break is only recorded once its whole N-bar
//     window has elapsed, so results lag by that many bars.
//
// NEW IN v7.9 — FOLLOW-THROUGH ACTUALLY MEASURES SOMETHING:
//   * "Confirmation bars after break" now DEFAULTS TO 1 (was 0).
//     v7.7 added a follow-through score component, but follow-through is
//     measured across the confirmation window — and at 0 confirmation bars
//     the break fires on the same bar it happens, so there is structurally
//     no "after" to look at. The component was returning its neutral
//     half-score for every single break: a constant, contributing zero
//     ability to tell breaks apart. Anyone on defaults was carrying the
//     weight of a measure that could not do anything.
//   * What this costs: every signal now arrives ONE BAR LATER. That is a
//     real price and it applies on every timeframe.
//   * What else changes: the pending state machine becomes the default code
//     path, so the unconfirmed-break preview (⑤, already on by default)
//     starts drawing its faint ghost line — a chart element most users will
//     not have seen before. It marks a break waiting out confirmation.
//   * Scores shift again, on top of the v7.6/v7.7 shifts: follow-through
//     goes from a flat constant to a real 0-10 contribution that varies per
//     break. RE-CHECK "Minimum score to signal" if you had tuned it.
//   * To keep the old behaviour: set Confirmation bars back to 0, and set
//     "Weight · follow-through" (⑩) to 0 so its share redistributes to the
//     measures that still work rather than sitting inert.
//   * COMPILE FIX: the retest markers never compiled. plotshape's `size`
//     argument requires a CONST string, but it was being handed a value
//     derived from the "Retest marker size" input — an input string. This
//     has been broken since the setting was added in v7.3, meaning the
//     script would not load at all with the retest markers present. Now
//     resolved with one gated plotshape per size constant.
//   * Internal-structure pivots are computed unconditionally and gated
//     afterwards, matching the swing engine. A ta.* call behind a condition
//     is not guaranteed to run every bar; harmless while the toggle is a
//     static input, but Pine warns on it.
//
// ALSO NEW IN v7.9 — THE SCORE CAN NOW LEAVE THE CHART:
//   * Seven data_window plots added: break score, break type (1=HH 2=LL
//     3=LH 4=HL), break level, signed clearance, retest flag, ATR and bias.
//     Nothing in this script was ever plotted, so the documented calibration
//     workflow — "run at minimum score 0 for two weeks and log every break"
//     — meant transcribing numbers off the chart by hand, which is why it
//     probably never happened.
//   * Chart menu -> "Export chart data..." now writes a CSV with those
//     columns, populated on break bars and na elsewhere. Join against your
//     own outcome column and the score cutoff falls out of the data.
//   * Alert messages can interpolate them: {{plot("Break score")}}.
//   * They are display.data_window, so they stay off the chart and out of
//     the price scale while remaining exportable and alert-addressable.
//
// NEW IN v7.8 — ADAPTIVE SWING ENGINE:
//   * New SWING ENGINE choice. The pivot detector's confirmation lag is a
//     fixed bar count: at swing length 5, every swing confirms exactly 5
//     bars later whether the market moved 3 ticks or 30 points in between.
//     The new DIRECTIONAL CHANGE engine instead confirms an extreme once
//     price retraces a volatility-scaled distance from it, so the trigger is
//     the market actually turning rather than a clock. Sharp reversals
//     confirm almost immediately; slow drifts take as long as they take.
//     Pivot mode remains the default and is unchanged.
//   * Retest proximity is now an input (was hardcoded at 0.20 x ATR).
//   * Levels can retest more than once, gated by a per-level cooldown
//     instead of a one-shot flag. A level that holds a SECOND retest is
//     stronger evidence than one that held once; retiring it after the first
//     threw away the better signal. Toggle off for the old behaviour.
//
// NEW IN v7.7 — STRONGER STATISTICS:
//   * Volume baseline is selectable, and defaults to TIME OF DAY. Intraday
//     volume is strongly U-shaped, so the old trailing mean was contaminated
//     by the opening surge at 10:00 and sat in the lunch lull at 12:00 — the
//     filter was measuring what time it was as much as participation. Each
//     bar is now compared against the same slot on previous days, with older
//     days decaying in weight. Median is also offered (spike-robust, still
//     time-biased), as is the original simple average.
//   * Volatility measure is selectable: ATR (Wilder) or MEDIAN TRUE RANGE.
//     ATR is a mean of a right-skewed variable, so one 10x news bar lifts it
//     for many bars and quietly tightens every ATR-scaled threshold at once.
//     NOTE: median true range reads ~10-20% lower than ATR on the same data,
//     so every multiple becomes effectively looser when you switch.
//   * Sixth score component: FOLLOW-THROUGH (default weight 10). Clearance,
//     displacement and body conviction all describe the same candle from
//     different angles and move together; follow-through measures how far
//     price actually ran past the level during the confirmation window,
//     which none of them can see. Needs Confirmation bars > 0 to be
//     measurable and returns a neutral half-score otherwise, exactly like
//     the volume component on feeds without real volume. The minimum-score
//     gate applies the same neutral allowance so tuned cutoffs don't shift.
//
// NEW IN v7.6 — CORRECTNESS FIXES (no new settings, no new features):
//   * HH/LL/LH/HL is now decided by the PIVOT SEQUENCE, not by `bias`.
//     Previously the label came from the direction of the previous break, so
//     a break of a genuinely LOWER high printed "HH" whenever bias was still
//     bullish from an earlier move. The label is now true by construction:
//     a break above a high is HH only if that high sits above the swing high
//     before it. Internal structure (i-HH/i-LL/i-LH/i-HL) got the same fix.
//   * Alerts moved onto that same decision. In v7.5 labels and alerts both
//     read `bias`, so they agreed with each other while both being open to
//     the mislabelling above; repointing only the labels would have split
//     them, so both now read one shared classification.
//   * The swing-size filter is no longer bypassed after every break. Both
//     refHigh and refLow used to reset to na on a break, and `na(refLow)`
//     short-circuits the min-swing-size test to true — so the first pivot
//     after every break skipped filtering entirely. Each break now advances
//     its own side's reference and KEEPS the opposite one.
//   * The score's leg-size component works in trends again. It reads the
//     opposite reference, which the reset above kept wiping, so it silently
//     fell back to a neutral half-score whenever a trend produced
//     consecutive highs without an intervening pivot low.
//   * Wick-rejection filter measures the right two quantities. It compared
//     the ENTIRE upper wick against the close's clearance; it now compares
//     wick-beyond-the-level against body-beyond-the-level. The old form was
//     accidentally correct for plain bullish breakout candles and wrong for
//     candles closing above the level while bearish, or opening above it.
//   * Internal structure no longer eats main structure. Its lines and labels
//     were created untracked and never deleted; because max_lines_count is
//     one shared pool per script, that silently evicted the oldest
//     HH/LL/LH/HL drawings. They are now tracked and capped separately.
//   * max_bars_back raised 100 -> 500, and every lookback input capped
//     (swing 50, ATR 200, volume 200, EMA 500, internal swing 20). Swing
//     length 60 or volume length 200 were both legal and both threw
//     "requested historical offset is beyond the historical buffer's limit".
//
// NEW IN v7.5 — HH / LL / LH / HL TERMINOLOGY:
//   * BOS and CHoCH labels/settings renamed throughout to classic Dow
//     Theory swing terminology:
//       Continuation up   (was "BOS Bullish")  -> HH  (Higher High)
//       Continuation down (was "BOS Bearish")  -> LL  (Lower Low)
//       Reversal up       (was "CHoCH Bullish") -> LH  (the Lower High
//         that just broke — first sign of a reversal off a downtrend)
//       Reversal down     (was "CHoCH Bearish") -> HL  (the Higher Low
//         that just broke — first sign of a reversal off an uptrend)
//   * The two are still styled independently — what was "⑦ BOS lines" is
//     now "⑦ HH/LL lines (continuation)", and "⑧ CHoCH lines" is now
//     "⑧ LH/HL lines (reversal)" — same settings, same colors by default,
//     new names throughout: inputs, tooltips, group headers, chart labels,
//     alert titles/messages, and internal structure's i-HH/i-LL/i-LH/i-HL.
//   * No behavior change — this is a terminology rename only, every filter,
//     score, and setting works exactly as before.
//
// NEW IN v7.4 — INDEPENDENT ENABLE/DISABLE PER SIDE:
//   * "Live (unbroken) levels" split into separate high/low toggles.
//   * Internal structure now has its own BOS/CHoCH show toggles (mirroring
//     the main structure's Draw BOS/CHoCH lines split) — the swing
//     detection master switch stays, this just lets you show one event
//     type without the other.
//   * The retest marker split into separate support/resistance toggles.
//
// NEW IN v7.3 — FULL LINE CUSTOMIZATION + RETEST MARKER:
//   * Vertical marker (BOS/CHoCH), internal structure, and the unconfirmed
//     preview line all now have independent style/width controls instead
//     of being hardcoded dotted/1px.
//   * NEW: retest events (price returning to a broken level and holding)
//     now draw a small triangle marker on the chart, not just an alert —
//     toggle in ⑤ Display & history ("Show retest marker on chart").
//   * Status table position is now a dropdown (Top/Bottom, Left/Right)
//     instead of locked to top-right.
//
// NEW IN v7.2 — RENAMED, MORE LINE CONTROL:
//   * Renamed from "BOS / CHoCH Structure" to "Structure Break Signals" — same
//     script, clearer name for what it actually does.
//   * Live (unbroken) level lines now have their own width/style/extend
//     controls instead of being hardcoded — see ⑤ Display & history.
//   * Internal structure (i-BOS/i-CHoCH) lines now have independent colors
//     instead of being forced to reuse the main BOS/CHoCH colors — see
//     ⑥ Internal structure.
//
// NEW IN v7.1 — FEATURE TOGGLES FULLY DISABLE THEIR FEATURE:
//   * "Draw BOS lines" / "Draw CHoCH lines" now also hide that type's LABEL,
//     not just its line. Previously, turning off BOS lines still left BOS
//     labels printing with no line under them — turning a type off now
//     fully removes it, matching what the toggles already said they'd do.
//
// NEW IN v7.0 — SPLIT INTO TWO SCRIPTS:
//   * Zones (swing zones, order blocks, fair value gaps, liquidity pools,
//     confluence scoring, historical hit-rate) have moved to a companion
//     script: "Support/Resistance Zones." This script keeps the original
//     job — grading individual structure BREAK EVENTS — and drops everything
//     that was really about mapping ZONES, which had grown to ~15 input
//     groups covering two different jobs in one indicator.
//   * No behavior change to what remains: presets, filters, confidence
//     score, BOS/CHoCH lines, internal structure, and alerts are untouched.
//   * max_boxes_count dropped from the indicator() declaration — this script
//     no longer draws any boxes.
//
// NEW IN v5.3 — TIMEFRAME ADAPTATION:
//   * "Auto-adapt to timeframe" (① Sensitivity presets) rescales every
//     extend-right and lookback window — BOS/CHoCH line length, all four zone
//     box widths, order-block search depth, liquidity pivot memory, retest
//     window — so each represents the SAME slice of real time on every chart,
//     instead of a fixed bar count that means 50 minutes on a 1-minute chart
//     and over a week on a 4-hour chart.
//   * Every scaled value is clamped to that setting's own manual min/max, so
//     auto-adapt can never reach a value you couldn't have picked by hand.
//   * Deliberately does NOT touch swing pivot length, filter thresholds, or
//     score weights — those stay under the Preset/Fine-tune dial, since what
//     COUNTS as a valid break is a different decision from how far to draw or
//     look back once one fires.
//
// NEW IN v5.2 — SMART MONEY ZONES:
//   * Swing zones: the live watched high/low is now a shaded wick-to-body box
//     instead of a thin line, so the exact area price must clear is obvious.
//   * Order blocks: the last opposite-coloured candle before a confirmed break,
//     drawn as a box. Grows while untested, fades on first touch, deletes once
//     price closes all the way through it (invalidated).
//   * Fair value gaps: classic 3-candle imbalances, ATR-filtered for size.
//     Fades on first partial fill, deletes once fully filled.
//   * Liquidity zones: equal highs/lows within an ATR tolerance, marking
//     resting buy-side/sell-side liquidity. Fades on a sweep (wick through),
//     deletes once a close confirms the level was actually consumed.
//   * All four share one box-history cap (Zones — shared style) so the chart
//     stays under TradingView's object limits automatically.
//
// NEW IN v5.1 — CONFIDENCE SCORING:
//   * Every break is graded 0-100 across five independent measures: clearance
//     beyond the level, displacement, body conviction, volume participation,
//     and the size of the leg broken. Shown on the label and in the table.
//   * Optional minimum-score gate, and optional fading of low-score breaks so
//     strong structure reads at a glance.
//   * Every component is user-adjustable: each measure has a weight and a
//     "full marks" threshold. Weights are auto-normalised to 100, so zeroing
//     one (e.g. volume on a synthetic feed) redistributes its share instead of
//     silently capping the score and shifting every threshold you had tuned.
//   * Why scoring rather than more filters: the existing filters are binary, so
//     a break clearing by 0.21 ATR and one clearing by 1.4 ATR both just read
//     "BOS". Tightening filters gives you FEWER signals; scoring tells you
//     which of them are actually good, and lets the chart show you where your
//     own cutoff should be.
//
//   Bugfixes in v5.1:
//   * Retest alerts no longer re-fire every bar while price sits on a level.
//   * Retest arrays no longer grow without bound (single shift per bar could
//     not keep up with bursts of breaks).
//   * Retest no longer stores an na level when a break fires without one.
//   * Divide-by-zero guard on clearance when confirmBars = 0, matching the
//     guard the other two call sites already had.
//
// IMPROVEMENTS OVER v4:
//   * Alerts: BOS/CHoCH up/down + retest alerts for TradingView notifications.
//   * Bugfix: lastBrokenHigh/Low now reset on opposite breaks — no more false
//     duplicate filtering across trend reversals.
//   * Bugfix: refHigh/refLow reset after breaks so ATR size filter works
//     correctly in new legs.
//   * Smart pending confirmation: opposite breaks cancel pending; upgrades to
//     more extreme levels replace stale pending breaks instead of waiting.
//   * Max history: auto-cleans old lines/labels so you never hit the 500 cap.
//   * Unconfirmed break preview: ghost markers when confirmBars > 0.
//   * Verbose labels: shows ATR clearance on each break.
//   * Configurable line extension: set how many bars BOS/CHoCH lines extend
//     right instead of running forever.
//   * Optional candle coloring by bias.
//   * Optional internal structure (faster swing length, thinner lines).
// =============================================================================
//@version=5
// max_bars_back must cover the deepest historical reference any setting can
// request. The binding constraints are ta.pivothigh(high, n, n) — which needs
// 2n bars — and ta.sma(volume, n). With every lookback input now capped
// (swing 50 -> 100 bars, volume 200), 500 leaves comfortable headroom. The
// previous value of 100 was below what the inputs already permitted and threw
// "requested historical offset is beyond the historical buffer's limit".
// process_orders_on_close matters here: the break conditions evaluate
// against close, so filling on the next bar's open would systematically
// report entries the signal never actually offered.
strategy("Structure Break Strategy v7.10", overlay = true, max_bars_back = 500, max_lines_count = 500, max_labels_count = 500,
     initial_capital = 100000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     commission_type = strategy.commission.percent, commission_value = 0.01,
     slippage = 1,
     calc_on_every_tick = false, process_orders_on_close = true)

// =============================================================================
// SENSITIVITY MASTER CONTROLS
// =============================================================================
grpP = "① Sensitivity presets"

preset = input.string("Balanced", "Preset", group = grpP,
     options = ["Very Loose", "Loose", "Balanced", "Strict", "Very Strict", "Custom"],
     tooltip = "One control that sets every filter at once.\n\n" +
       "VERY LOOSE — catches almost every structure break. Many signals, many false ones. Use to see raw structure or on very slow instruments.\n\n" +
       "LOOSE — slightly filtered. Good for scalping lower timeframes where you accept noise for earlier entries.\n\n" +
       "BALANCED — sensible default for intraday futures on 5M–15M. Starting point for most people.\n\n" +
       "STRICT — only well-defined breaks with real displacement. Fewer signals, later, higher quality.\n\n" +
       "VERY STRICT — only major structure. Use on higher timeframes or when you only want A+ setups.\n\n" +
       "CUSTOM — ignores the preset and uses every manual value you set in the sections below.")

sensDial = input.int(5, "Fine tune (1 = strictest, 10 = loosest)", minval = 1, maxval = 10, group = grpP,
     tooltip = "Nudges the preset up or down without changing preset.\n\n" +
       "5 = the preset exactly as designed.\n" +
       "Above 5 = progressively looser (more signals, earlier, noisier).\n" +
       "Below 5 = progressively stricter (fewer signals, later, cleaner).\n\n" +
       "Ignored when Preset = Custom.\n\n" +
       "Practical use: if a preset is close but gives slightly too many signals on your instrument, drop this to 3–4 rather than switching preset entirely.")

useAutoTF = input.bool(true, "Auto-adapt to timeframe", group = grpP,
     tooltip = "Scales every 'extend right' and 'lookback' window (HH/LL/LH/HL line length, retest window) so it represents the SAME slice of real time on every chart, instead of a fixed bar count that means 50 minutes on a 1-minute chart and over a week on a 4-hour chart.\n\nEach scaled value is capped at whatever that setting's own manual maximum already is, so auto-adapt can never reach a value you couldn't have picked by hand.\n\nDoes NOT touch swing pivot length, filter thresholds, or score weights — those stay under the Preset/Fine-tune dial above, since changing what COUNTS as a valid break based on timeframe is a different decision from how far to draw or look back once one fires.\n\nOFF = every bar-count setting below means exactly what you typed, unscaled.")

// Preset base values ----------------------------------------------------------
int   pSwing    = preset == "Very Loose" ? 3   : preset == "Loose" ? 4    : preset == "Balanced" ? 5    : preset == "Strict" ? 7    : preset == "Very Strict" ? 10 : 5
float pAtrMult  = preset == "Very Loose" ? 0.0 : preset == "Loose" ? 0.25 : preset == "Balanced" ? 0.5  : preset == "Strict" ? 0.8  : preset == "Very Strict" ? 1.2  : 0.5
float pStrength = preset == "Very Loose" ? 0.0 : preset == "Loose" ? 0.05 : preset == "Balanced" ? 0.10 : preset == "Strict" ? 0.20 : preset == "Very Strict" ? 0.35 : 0.10
float pDisplace = preset == "Very Loose" ? 0.0 : preset == "Loose" ? 0.35 : preset == "Balanced" ? 0.60 : preset == "Strict" ? 0.90 : preset == "Very Strict" ? 1.30 : 0.60
float pEqualTol = preset == "Very Loose" ? 0.0 : preset == "Loose" ? 0.10 : preset == "Balanced" ? 0.15 : preset == "Strict" ? 0.25 : preset == "Very Strict" ? 0.35 : 0.15
int   pCooldown = preset == "Very Loose" ? 0   : preset == "Loose" ? 2    : preset == "Balanced" ? 3    : preset == "Strict" ? 5    : preset == "Very Strict" ? 8    : 3

// Dial scaling: 5 = neutral. Loosen (>5) shrinks thresholds, tighten (<5) grows them.
float dialScale = math.pow(0.82, sensDial - 5)   // >5 → <1 (looser), <5 → >1 (stricter)
float dialSwing = math.pow(0.90, sensDial - 5)

// =============================================================================
// CORE STRUCTURE SETTINGS
// =============================================================================
grpS = "② Core structure"

swingEngine = input.string("Pivot (fixed bars)", "Swing engine", options = ["Pivot (fixed bars)", "Directional change (adaptive)"], group = grpS,
     tooltip = "HOW a swing high/low gets confirmed. This is the deepest choice in the indicator — everything downstream is built on the swings this produces.\n\n" +
       "PIVOT (FIXED BARS) — the classic: a bar is a swing high once N bars on each side are lower. Simple and predictable, but it carries an unavoidable, FIXED confirmation lag: at a swing length of 5, every swing is confirmed exactly 5 bars after it actually formed, whether the market moved 3 ticks or 30 points in between. The lag is a bar count, so it means completely different things in a dead lunch hour and a news release.\n\n" +
       "DIRECTIONAL CHANGE (ADAPTIVE) — confirms an extreme the moment price retraces a set multiple of ATR away from it, rather than after a set number of bars. A sharp reversal confirms almost immediately; a slow drift takes as long as it needs. The confirmation trigger is a real market event (price actually turned) instead of a clock, and because the threshold is ATR-scaled it automatically means the same thing across timeframes and volatility regimes.\n\n" +
       "Which to use: directional change generally gets you the same swings EARLIER, which matters most on fast reversals. Pivot mode is more familiar and easier to eyeball against a chart. Swing pivot length is ignored in directional-change mode; the reversal threshold below replaces it.\n\n" +
       "Internal structure (⑥) always uses the pivot engine — it exists to read a faster, smaller scale, which is exactly what a fixed short pivot length already does well.")

dcMult = input.float(1.5, "  Reversal threshold (× ATR)", minval = 0.1, maxval = 10.0, step = 0.1, group = grpS,
     tooltip = "How far price must pull back from an extreme, in ATR, before that extreme is confirmed as a swing. Directional-change mode only — this is what replaces Swing pivot length.\n\n" +
       "LOWER (0.5–1.0) = confirms quickly, detects small swings. More structure points, more signals, more noise — the analogue of a short pivot length, but adaptive.\n" +
       "1.5 = balanced starting point.\n" +
       "HIGHER (2.5–4.0) = only real reversals confirm a swing. Far fewer, larger structural swings.\n\n" +
       "Unlike a bar count, this is volatility-scaled: the same value keeps meaning 'a genuine turn' whether the instrument is quiet or moving.")

mSwingLen = input.int(5, "Swing pivot length", minval = 1, maxval = 50, group = grpS,
     tooltip = "THE MOST IMPORTANT SETTING.\n\n" +
       "How many bars must sit on each side of a candle for it to count as a swing high/low.\n\n" +
       "LOWER (2–4) = detects small swings. More structure points, more signals, more noise. Also less confirmation lag.\n" +
       "HIGHER (7–12) = only major swings. Cleaner structure, far fewer signals, more lag.\n\n" +
       "This directly sets your confirmation delay: a swing cannot be confirmed until this many bars after it forms. At 5, labels appear ~5 bars late. That lag is unavoidable with pivot detection.\n\n" +
       "Only used when Preset = Custom.")

volMeasure = input.string("ATR (Wilder)", "Volatility measure", options = ["ATR (Wilder)", "Median true range"], group = grpS,
     tooltip = "Which estimate of 'normal bar size' every ATR-scaled threshold in this indicator is built on — break clearance, displacement, min swing size, equal-level tolerance, and all five score thresholds.\n\n" +
       "ATR (WILDER) — the standard: a running average of true range. Simple and familiar, but it is a MEAN, and true range is a right-skewed variable. One news bar at 10x normal size lifts it for many bars afterward, which quietly tightens every threshold at once — so the indicator goes quiet right after the most informative move of the session.\n\n" +
       "MEDIAN TRUE RANGE — the middle bar of the lookback instead of the average. A single outlier moves it barely at all, so thresholds stay put through spikes and reflect what a typical bar actually looks like.\n\n" +
       "IMPORTANT: median true range reads roughly 10-20% LOWER than ATR on the same data, because it ignores the fat right tail that pulls a mean upward. Every ATR-multiple setting therefore becomes effectively LOOSER when you switch. Expect more signals, and raise your multiples by about 15% if you want to hold sensitivity constant.")

mAtrLen = input.int(14, "  Volatility lookback", minval = 1, maxval = 200, group = grpS,
     tooltip = "Lookback for the ATR used by every size-based filter below.\n\n" +
       "SHORTER (7–10) = ATR reacts fast to volatility changes, so filters tighten and loosen quickly. Good for sessions with sharp volatility shifts.\n" +
       "LONGER (20–50) = smoother, more stable thresholds. Less reactive to a single volatile bar.\n\n" +
       "14 is standard and fine for most futures intraday work. This is used in all presets.")

mUseAtrFilter = input.bool(true, "Filter minor swings by size", group = grpS,
     tooltip = "Ignores swing points that are too small to be real structure.\n\n" +
       "ON = a pivot only counts if it moved far enough from the last opposite swing. Removes the tiny wiggles inside consolidation that would otherwise be labelled as structure.\n" +
       "OFF = every detected pivot counts, including micro-swings inside chop.\n\n" +
       "Recommend leaving ON. Turn off only if you want to see raw unfiltered pivot structure.")

mAtrMult = input.float(0.5, "  Min swing size (× ATR)", minval = 0.0, step = 0.05, group = grpS,
     tooltip = "How far a pivot must be from the previous opposite swing to count as structure, measured in ATR.\n\n" +
       "0.0–0.2 = almost nothing filtered. Very sensitive.\n" +
       "0.4–0.6 = balanced. Filters obvious chop, keeps real swings.\n" +
       "1.0+ = only large structural swings survive.\n\n" +
       "MOVE UP if consolidation is being labelled as structure.\n" +
       "MOVE DOWN if it's missing swings you'd clearly mark by hand.\n\n" +
       "Only used when Preset = Custom.")

// =============================================================================
// BREAK-QUALITY FILTERS
// =============================================================================
grpF = "③ Break quality filters"

mUseStrength = input.bool(true, "Require break strength", group = grpF,
     tooltip = "Requires price to close BEYOND the level by a meaningful amount, not just one tick past it.\n\n" +
       "ON = filters out marginal breaks that clear the level by a hair and immediately fail back inside. This is one of the highest-value filters.\n" +
       "OFF = any close past the level counts, even by a single tick.\n\n" +
       "Strongly recommend ON.")

mStrength = input.float(0.10, "  Min clearance beyond level (× ATR)", minval = 0.0, step = 0.05, group = grpF,
     tooltip = "How far past the level the close must be, in ATR.\n\n" +
       "0.05 = barely filtered, catches nearly everything.\n" +
       "0.10–0.20 = balanced. Removes tick-through fakeouts.\n" +
       "0.30+ = only decisive breaks. Notably fewer signals and later entries.\n\n" +
       "TRADEOFF: raising this improves quality but you enter later and miss breaks that were real but shallow.\n\n" +
       "Only used when Preset = Custom.")

mUseDisplace = input.bool(true, "Require displacement candle", group = grpF,
     tooltip = "Requires the candle that breaks the level to have real size relative to recent volatility.\n\n" +
       "ON = a break on a tiny indecision candle is rejected. Genuine institutional breaks usually come with expansion.\n" +
       "OFF = any candle can break structure, including dojis.\n\n" +
       "Recommend ON. This is the second-highest-value filter after break strength.")

mDisplace = input.float(0.6, "  Min candle range (× ATR)", minval = 0.0, step = 0.1, group = grpF,
     tooltip = "How large the breaking candle's full range must be, in ATR.\n\n" +
       "0.3 = permissive, most candles qualify.\n" +
       "0.6–0.8 = balanced. Requires visible expansion.\n" +
       "1.2+ = only strong impulsive candles qualify. Few signals.\n\n" +
       "MOVE UP if you're seeing weak breaks that stall immediately.\n" +
       "MOVE DOWN if real breaks are being skipped in low-volatility sessions.\n\n" +
       "Only used when Preset = Custom.")

mUseBodyRatio = input.bool(false, "  Also require body > 50% of range", group = grpF,
     tooltip = "Adds a conviction test on top of the range test.\n\n" +
       "ON = the candle body must be more than half its total range, so a long-wicked rejection candle won't count as a break even if its range is large.\n" +
       "OFF = only total range matters.\n\n" +
       "Turn ON if you're getting breaks on candles that spiked through and closed back near their open.")

mUseWickReject = input.bool(false, "Reject long-wick breaks", group = grpF,
     tooltip = "Rejects breaks where the candle left a large wick BEYOND the level, which suggests the move was rejected rather than accepted.\n\n" +
       "ON = if the wick past the level is bigger than the body past the level, the break is skipped. Useful for filtering liquidity sweeps that get labelled as breaks.\n" +
       "OFF = wick shape is ignored.\n\n" +
       "TRADEOFF: this can filter out genuine sweep-then-reverse setups that you may actually want to trade. Turn on only if wick-fakeouts are your main problem.")

mUseVolume = input.bool(false, "Require volume expansion", group = grpF,
     tooltip = "Requires the breaking candle to trade above its recent average volume.\n\n" +
       "ON = breaks on thin volume are rejected. Real structure breaks usually come with participation.\n" +
       "OFF = volume ignored.\n\n" +
       "IMPORTANT: only meaningful on instruments with reliable volume data. On futures this generally works well; on some CFDs and forex feeds volume is synthetic and this filter will behave unpredictably. Verify your feed before trusting it.")

mVolMult = input.float(1.2, "  Min volume (× average)", minval = 0.1, step = 0.1, group = grpF,
     tooltip = "How much above average volume the breaking candle must be.\n\n" +
       "1.0 = merely average volume.\n" +
       "1.2–1.5 = clear expansion. Balanced.\n" +
       "2.0+ = only high-participation breaks. Very restrictive.\n\n" +
       "Only applies when 'Require volume expansion' is ON.")

volBaseline = input.string("Time of day", "  Volume baseline", options = ["Simple average", "Median", "Time of day"], group = grpF,
     tooltip = "What 'normal volume' means for this bar. This feeds BOTH the volume filter above and the volume component of the confidence score.\n\n" +
       "SIMPLE AVERAGE — a rolling mean of the last N bars. The classic choice, and the weakest one intraday: volume is strongly U-shaped through a session, so at 10:00 the trailing mean is contaminated by the opening surge and almost nothing passes, while at 12:00 it sits in the lunch lull and almost everything does. The filter ends up measuring what TIME it is as much as it measures participation.\n\n" +
       "MEDIAN — same rolling window, middle value instead of the mean. One block print or halt-reopen bar stops dragging the baseline around. Still carries the time-of-day bias, just less noisily.\n\n" +
       "TIME OF DAY (default) — compares this bar against the SAME slot on previous days, so 10:00 is judged against other 10:00s. This is the construction that actually removes the U-shape, and it's what 'relative volume' means everywhere else. Older days decay in weight, so the baseline follows changes in the instrument's activity instead of averaging over its whole history.\n\n" +
       "Time of day needs a few sessions of history to warm up, and falls back to the median on non-intraday charts where the concept doesn't apply.")

mVolLen = input.int(20, "  Volume lookback (average/median)", minval = 1, maxval = 200, group = grpF,
     tooltip = "Lookback for the Simple average and Median baselines. Ignored by the Time of day baseline, which uses its own per-slot history instead.\n\n" +
       "SHORTER (10) = compares against very recent activity, adapts quickly within a session.\n" +
       "LONGER (50) = compares against a broader baseline, less affected by a single busy period.\n\n" +
       "20 is a reasonable default for intraday.")

mUseEqualTol = input.bool(true, "Merge near-equal levels", group = grpF,
     tooltip = "Treats levels that sit within a small band of each other as the SAME level.\n\n" +
       "ON = prevents the indicator printing two labels for what is really one double top or double bottom.\n" +
       "OFF = each pivot is treated as a distinct level even if they're nearly identical.\n\n" +
       "Recommend ON. Equal highs/lows are common and double-labelling them clutters the chart.")

mEqualTol = input.float(0.15, "  Equal-level tolerance (× ATR)", minval = 0.0, step = 0.05, group = grpF,
     tooltip = "How close two levels must be to be considered the same level, in ATR.\n\n" +
       "0.05 = only near-identical prices merge.\n" +
       "0.15 = balanced.\n" +
       "0.30+ = aggressively merges nearby levels, which can suppress genuine separate breaks.\n\n" +
       "Only used when Preset = Custom.")

mCooldown = input.int(3, "Min bars between breaks", minval = 0, maxval = 100, group = grpF,
     tooltip = "Forces a gap between labelled breaks.\n\n" +
       "0 = no cooldown, breaks can print on consecutive bars.\n" +
       "3–5 = balanced. Stops rapid-fire labelling during chop.\n" +
       "8+ = heavily throttled, only well-separated structure shifts appear.\n\n" +
       "TRADEOFF: a high cooldown can suppress a genuine fast reversal that legitimately breaks structure twice in quick succession.\n\n" +
       "Only used when Preset = Custom.")

mConfirmBars = input.int(1, "Confirmation bars after break", minval = 0, maxval = 5, group = grpF,
     tooltip = "Waits N bars after a break and only labels it if price is STILL beyond the level.\n\n" +
       "0 = label immediately on the breaking candle's close.\n" +
       "1 = default. One bar of follow-through required.\n" +
       "2 = cuts fakeouts noticeably harder.\n" +
       "3–5 = very conservative, but the label arrives well after the move started.\n\n" +
       "TRADEOFF: this is the most direct quality-vs-lag dial in the indicator. Every bar you add here is a bar of entry you give up. Use it if fakeouts cost you more than late entries do.\n\n" +
       "ALSO CONTROLS THE FOLLOW-THROUGH SCORE. The waiting period is where follow-through is measured — how far price actually ran past the level after clearing it. At 0 there is no 'after' to look at, so that component returns a flat neutral half-score for every break and contributes nothing to telling breaks apart. This is why the default is 1 rather than 0: at 0 you are paying for a score component that cannot do anything.\n\n" +
       "Set this to 0 only if entry timing matters more to you than the extra measure, and consider zeroing 'Weight · follow-through' (⑩) at the same time so its share redistributes to measures that still work.")

mStrictBreak = input.bool(false, "Strict: full body beyond level", group = grpF,
     tooltip = "Requires BOTH the open and the close to be beyond the level, not just the close.\n\n" +
       "ON = the entire candle body must clear the level. Very restrictive, meaningfully later.\n" +
       "OFF = a close beyond the level is enough (standard).\n\n" +
       "Most people should leave this OFF and use break strength instead, which achieves a similar goal with less lag.")

// =============================================================================
// CONTEXT FILTERS
// =============================================================================
grpX = "④ Context filters"

mUseTrendFilter = input.bool(false, "Only signal with EMA trend", group = grpX,
     tooltip = "Suppresses breaks that go against a longer-term EMA.\n\n" +
       "ON = bullish breaks only print when price is above the EMA, bearish breaks only when below. Aligns signals with the prevailing trend.\n" +
       "OFF = all breaks print regardless of trend context.\n\n" +
       "IMPORTANT TRADEOFF: this will suppress the very first LH/HL reversal signal, because that's precisely the signal that fires against the trend. If you trade reversals, leave this OFF.")

mTrendLen = input.int(50, "  EMA length", minval = 1, maxval = 500, group = grpX,
     tooltip = "Length of the trend EMA used by the filter above.\n\n" +
       "SHORTER (20) = follows price closely, filter flips often.\n" +
       "LONGER (100–200) = defines a slower, more structural trend.\n\n" +
       "Only applies when 'Only signal with EMA trend' is ON.")

mUseSession = input.bool(false, "Restrict to a session", group = grpX,
     tooltip = "Only detects structure breaks inside a chosen time window.\n\n" +
       "ON = ignores overnight and low-liquidity chop, which produces a lot of low-quality structure.\n" +
       "OFF = analyses all bars.\n\n" +
       "Useful if you trade a specific window, since breaks outside your session aren't actionable anyway.")

mSession = input.session("0930-1600", "  Session window", group = grpX,
     tooltip = "The time window to analyse, in exchange time.\n\n" +
       "Examples:\n" +
       "0930-1600 = US regular cash session\n" +
       "0830-1130 = US morning only\n" +
       "0200-0500 = London session\n\n" +
       "Set your chart timezone correctly or this window won't land where you expect.")

// =============================================================================
// DISPLAY & HISTORY SETTINGS
// =============================================================================
grpD = "⑤ Display & history"

showLabels = input.bool(true, "HH / LL / LH / HL labels", group = grpD,
     tooltip = "Text labels on each break. Turn off for a cleaner chart if the coloured lines are enough.")
labelSize  = input.string("Small", "Label size", options = ["Tiny", "Small", "Normal"], group = grpD,
     tooltip = "Text size for break labels. Use Tiny on dense lower-timeframe charts.")
verboseLabels = input.bool(false, "Verbose labels (show ATR clearance)", group = grpD,
     tooltip = "ON = labels show 'HH +0.3' or 'LH -0.2' indicating how many ATR the break cleared beyond the level. Useful for quickly judging break quality.")
showLiveHigh = input.bool(true, "Live (unbroken) high level", group = grpD,
     tooltip = "Dotted line showing the swing HIGH price is CURRENTLY working against, before any break.\n\nThis is the most useful setting for live trading: it shows what needs to break for a signal to fire, so you can plan the trade before the label appears.")
showLiveLow = input.bool(true, "Live (unbroken) low level", group = grpD,
     tooltip = "Same as the high level above, mirrored for the current watched swing LOW.")
liveLineWidth = input.int(1, "  Live level line width", minval = 1, maxval = 4, group = grpD,
     tooltip = "Thickness of the live (unbroken) level lines.")
liveLineStyle = input.string("Dotted", "  Live level line style", options = ["Solid", "Dashed", "Dotted"], group = grpD,
     tooltip = "Line style for the live level lines. Dotted by default so they read as 'not confirmed yet,' distinct from the solid/dashed HH/LL/LH/HL break lines.")
liveExtendBars = input.int(20, "  Extend live level right (bars)", minval = 0, maxval = 200, group = grpD,
     tooltip = "How far the live level line is drawn forward from the current bar. Scales with 'Auto-adapt to timeframe' like every other extend setting, so it means the same amount of real time on every chart.")
showPivots = input.bool(false, "Raw pivot markers", group = grpD,
     tooltip = "Small triangles on every detected swing high/low, including ones the filters rejected.\n\nUseful for DIAGNOSIS: if the indicator is missing structure you'd mark by hand, turn this on to see whether the pivot was detected but filtered out, or never detected at all.")
tintBias   = input.bool(false, "Tint background by bias", group = grpD,
     tooltip = "Colours the chart background by current structure bias. Some find it useful for at-a-glance context, others find it distracting.")
colorCandles = input.bool(false, "Color candles by bias", group = grpD,
     tooltip = "Colours OHLC candles based on current structure bias: bullish uses the HH/LL colour, bearish uses the LH/HL colour, neutral = default — regardless of whether the most recent break was itself a continuation or a reversal. Independent of background tint.")
showTable  = input.bool(true, "Status table", group = grpD,
     tooltip = "Corner panel showing current bias, the exact watched levels, bars since the last break, ATR, and active preset.\n\nThe numeric levels are the useful part: copy them straight into your trade journal rather than reading them off the chart.")
tablePosition = input.string("Top Right", "  Table position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpD,
     tooltip = "Corner of the chart the status table is anchored to. Move it if it overlaps another indicator's panel or the price scale.")
maxHistory = input.int(50, "Max breaks to draw (0 = unlimited)", minval = 0, maxval = 200, group = grpD,
     tooltip = "Limits how many historical HH/LL/LH/HL lines and labels remain on chart. Oldest auto-delete when exceeded.\n\n0 = no limit (may hit TradingView's 500 cap on busy charts).\n50 = keeps chart clean on intraday timeframes.\n\nLive levels and pivot markers are not counted.")

showUnconfirmed = input.bool(true, "Show unconfirmed break preview", group = grpD,
     tooltip = "When Confirmation Bars > 0, draws a faint ghost marker at the break level while waiting for confirmation. Lets you see the break forming in real time rather than waiting blindly.")
pendLineStyle = input.string("Dotted", "  Preview line style", options = ["Solid", "Dashed", "Dotted"], group = grpD,
     tooltip = "Line style for the unconfirmed break preview.")
pendLineWidth = input.int(1, "  Preview line width", minval = 1, maxval = 4, group = grpD,
     tooltip = "Thickness of the unconfirmed break preview line.")

showRetestSupportMarker = input.bool(true, "Show retest-support marker on chart", group = grpD,
     tooltip = "Draws a small triangle at the bar where a support retest fires (price returns to a broken level from above and holds), using the HH/LL colour.\n\nThe Retest Support alert already fires either way — this just makes the event visible on the chart too, not only in your alert log.")
showRetestResistanceMarker = input.bool(true, "Show retest-resistance marker on chart", group = grpD,
     tooltip = "Same as the retest-support marker above, mirrored: price returning to a broken level from below and holding, using the LH/HL colour.")
retestMarkerSize = input.string("Small", "  Retest marker size", options = ["Tiny", "Small", "Normal"], group = grpD,
     tooltip = "Size of the retest marker triangles. Applies to both markers above.")

retestBand = input.float(0.20, "  Retest proximity (× ATR)", minval = 0.01, maxval = 2.0, step = 0.05, group = grpD,
     tooltip = "How close the close must come to a broken level, in ATR, for the bar to count as a retest of it.\n\n" +
       "TIGHTER (0.05–0.15) = only near-exact returns to the level count. Fewer, cleaner retests, but you miss ones that reacted a little early.\n" +
       "0.20 = balanced.\n" +
       "WIDER (0.4+) = anything in the neighbourhood counts. More retests, more of them loose.\n\n" +
       "Was previously fixed at 0.20 with no way to adjust it. If your instrument respects levels precisely, tighten it.")

retestRepeat = input.bool(true, "  Allow repeat retests of a level", group = grpD,
     tooltip = "Whether a level can fire more than one retest over its lifetime.\n\n" +
       "ON (default) = a level can retest again after a cooldown. A level that holds twice is STRONGER evidence than one that held once, so retiring it after the first test throws away the better signal.\n" +
       "OFF = each level fires exactly once ever, then goes quiet. Fewer alerts, and the original behaviour.\n\n" +
       "Either way the cooldown below stops a level price is sitting directly on from firing every bar.")

retestCooldown = input.int(10, "  Bars before a level can retest again", minval = 1, maxval = 200, group = grpD,
     tooltip = "Minimum bars between two retests OF THE SAME LEVEL. Stops price hovering on a level from re-firing continuously, while still letting a genuine second visit register. Scales with 'Auto-adapt to timeframe'.\n\nOnly applies when repeat retests are on.")

// =============================================================================
// INTERNAL STRUCTURE (Optional)
// =============================================================================
grpI = "⑥ Internal structure (optional)"

useInternal = input.bool(false, "Show internal structure", group = grpI,
     tooltip = "Master switch: tracks a second, faster swing length for minor structure inside the current leg. Must be ON for either event type below to be detected at all.\n\nInternal HH/LL = minor break WITH trend (continuation).\nInternal LH/HL = minor break AGAINST trend (early reversal warning).\n\nDrawn with thinner, semi-transparent lines. Useful for entry timing within a higher-timeframe bias.")
showInternalCont = input.bool(true, "  Show internal HH/LL", group = grpI,
     tooltip = "Draws internal continuation events (minor break WITH trend, labelled i-HH or i-LL). Only applies when the master switch above is on — this just lets you show one internal event type without the other, the same way the main lines split below.")
showInternalRev = input.bool(true, "  Show internal LH/HL", group = grpI,
     tooltip = "Draws internal reversal events (minor break AGAINST trend, labelled i-LH or i-HL). Only applies when the master switch above is on.")
intSwingLen = input.int(3, "Internal swing length", minval = 1, maxval = 20, group = grpI,
     tooltip = "Must be smaller than main Swing Pivot Length. 2–3 is typical.")
intColCont = input.color(#38BDF8, "Internal HH/LL colour", group = grpI,
     tooltip = "Colour for internal continuation (i-HH/i-LL) lines/labels. Independent of the main HH/LL colour (⑦) — set them apart, or match them if you'd rather they read as one family.")
intColRev = input.color(#FB923C, "Internal LH/HL colour", group = grpI,
     tooltip = "Colour for internal reversal (i-LH/i-HL) lines/labels. Independent of the main LH/HL colour (⑧).")
intLineStyle = input.string("Dotted", "Internal line style", options = ["Solid", "Dashed", "Dotted"], group = grpI)
intLineWidth = input.int(1, "Internal line width", minval = 1, maxval = 3, group = grpI)
intTransparency = input.int(65, "Internal line transparency", minval = 0, maxval = 90, group = grpI)

// =============================================================================
// LINE / VISUAL SETTINGS
// =============================================================================
grpB = "⑦ HH/LL lines (continuation)"
colCont       = input.color(#38BDF8, "HH/LL colour", group = grpB,
     tooltip = "Colour for continuation lines and labels — HH (Higher High) on an up break, LL (Lower Low) on a down break. A break WITH the existing trend, confirming it's still intact.")
contLineStyle = input.string("Solid", "HH/LL line style", options = ["Solid", "Dashed", "Dotted"], group = grpB,
     tooltip = "Line style for HH/LL levels. Solid reads as more definitive, which suits continuation signals.")
contLineWidth = input.int(2, "HH/LL line width", minval = 1, maxval = 4, group = grpB,
     tooltip = "Thickness of HH/LL lines. Raise if you're on a large monitor or find them hard to see.")
contExtendBars = input.int(0, "Extend HH/LL lines right (bars)", minval = 0, maxval = 500, group = grpB,
     tooltip = "How many bars to draw the HH/LL line forward from the break bar.\n\n0 = line stops at the break bar (cleanest).\n20 = extends 20 bars forward.\n100 = extends 100 bars forward.\n\nUnlike 'extend.right' which runs forever, this keeps your chart clean on the right edge while still showing relevant levels ahead.")
contVertical  = input.bool(false, "Vertical marker on HH/LL bar", group = grpB,
     tooltip = "Draws a small vertical tick on the exact bar where the HH/LL was confirmed, making the timing unambiguous.")
contVertStyle = input.string("Dotted", "  Vertical marker style", options = ["Solid", "Dashed", "Dotted"], group = grpB,
     tooltip = "Line style for the HH/LL vertical marker tick. Only applies when the marker above is on.")
contVertWidth = input.int(1, "  Vertical marker width", minval = 1, maxval = 4, group = grpB,
     tooltip = "Thickness of the HH/LL vertical marker tick.")
showContLines = input.bool(true, "Draw HH/LL lines", group = grpB,
     tooltip = "Master switch for continuation breaks — turns off the line AND the label, so HH/LL breaks are fully hidden, not just the line. Turn off if you only care about LH/HL reversals.")

grpC = "⑧ LH/HL lines (reversal)"
colRev       = input.color(#FB923C, "LH/HL colour", group = grpC,
     tooltip = "Colour for reversal lines and labels — LH (Lower High) breaking on an up move, HL (Higher Low) breaking on a down move. A break AGAINST the existing trend, signalling a possible reversal — this is the level that just failed.")
revLineStyle = input.string("Dashed", "LH/HL line style", options = ["Solid", "Dashed", "Dotted"], group = grpC,
     tooltip = "Line style for LH/HL levels. Dashed distinguishes them from HH/LL at a glance.")
revLineWidth = input.int(2, "LH/HL line width", minval = 1, maxval = 4, group = grpC,
     tooltip = "Thickness of LH/HL lines.")
revExtendBars = input.int(50, "Extend LH/HL lines right (bars)", minval = 0, maxval = 500, group = grpC,
     tooltip = "How many bars to draw the LH/HL line forward from the break bar.\n\n0 = line stops at the break bar.\n50 = extends 50 bars forward (default — enough to see retests without clutter).\n200 = extends 200 bars.\n\nLH/HL levels often act as support/resistance, so some extension is useful. But 'forever' clutters the chart. Adjust to your timeframe: lower on 1M, higher on 1H+.")
revVertical  = input.bool(true, "Vertical marker on LH/HL bar", group = grpC,
     tooltip = "ON (default) = marks the exact LH/HL bar. Reversal signals are the easiest to misread in real time, so the precise bar is worth showing.")
revVertStyle = input.string("Dotted", "  Vertical marker style", options = ["Solid", "Dashed", "Dotted"], group = grpC,
     tooltip = "Line style for the LH/HL vertical marker tick. Only applies when the marker above is on.")
revVertWidth = input.int(1, "  Vertical marker width", minval = 1, maxval = 4, group = grpC,
     tooltip = "Thickness of the LH/HL vertical marker tick.")
showRevLines = input.bool(true, "Draw LH/HL lines", group = grpC,
     tooltip = "Master switch for reversal breaks — turns off the line AND the label, so LH/HL breaks are fully hidden, not just the line.")

// =============================================================================
// CONFIDENCE SCORE
// =============================================================================
grpQ = "⑨ Confidence score"

useScore = input.bool(true, "Score every break 0-100", group = grpQ,
     tooltip = "Grades each break on HOW WELL it passed, instead of a simple pass/fail.\n\n" +
       "The filters above are binary: a break either qualifies or it doesn't. A break that cleared the level by 0.21 ATR and one that cleared it by 1.4 ATR both just say 'HH'. This scores them, so you can tell a marginal signal from an emphatic one.\n\n" +
       "Score is built from six measures (default weights, auto-normalised to 100):\n" +
       "  Clearance beyond the level   30\n" +
       "  Displacement of the candle   25\n" +
       "  Body conviction              15\n" +
       "  Volume participation         15\n" +
       "  Size of the leg broken       15\n" +
       "  Follow-through               10\n\n" +
       "The first three all describe the same breaking candle from different angles, so they tend to move together. Volume, leg size and follow-through each see something the others cannot — follow-through especially, since it is the only one that looks at what happened AFTER the break (it needs Confirmation bars > 0 to be measurable; otherwise it returns a neutral half-score).\n\n" +
       "Rough reading: 75+ is emphatic, 55-75 is solid, below 40 is marginal.")

minScore = input.int(0, "  Minimum score to signal", minval = 0, maxval = 100, group = grpQ,
     tooltip = "Breaks scoring below this are not labelled at all.\n\n" +
       "0 = label everything, score is display-only. START HERE.\n\n" +
       "RECOMMENDED WORKFLOW: run at 0 for a week with scores shown. Watch which scores actually worked on your instrument. THEN set this to the number you observed, rather than guessing.\n\n" +
       "Setting this blind is just a slower way of tightening the filters above. The point of the score is to let the chart tell you where your cutoff is.")

showScore = input.bool(true, "  Show score on label", group = grpQ,
     tooltip = "Appends the score to each label, e.g. 'HH 82'. Turn off for a cleaner chart once you've settled on a minimum score.")

scoreColors = input.bool(true, "  Fade low-score breaks", group = grpQ,
     tooltip = "Draws low-scoring breaks more transparently, so high-confidence structure stands out at a glance without reading numbers.\n\nA 90-score break is drawn solid; a 40-score break is drawn faint.")

// =============================================================================
// SCORE TUNING (advanced)
// =============================================================================
grpQ2 = "⑩ Score tuning (advanced)"

// --- How much each measure is worth -------------------------------------------
// Weights are NORMALISED to total 100, so you set them in relative terms and
// never have to make them add up yourself. Zeroing one redistributes its share
// across the rest, which keeps scores comparable across different weightings.
wClear = input.int(30, "Weight · clearance beyond level", minval = 0, maxval = 100, group = grpQ2,
     tooltip = "How much the score cares that price closed WELL past the level rather than barely past it.\n\n" +
       "This is the single most reliable indicator of a real break, which is why it carries the most weight by default.\n\n" +
       "Weights are relative and auto-normalised to 100 — you do not need to make them add up.")

wDisp = input.int(25, "Weight · displacement", minval = 0, maxval = 100, group = grpQ2,
     tooltip = "How much the score cares that the breaking candle was LARGE relative to recent volatility.\n\nRaise if your instrument breaks with obvious expansion. Lower on instruments that grind rather than impulse.")

wBody = input.int(15, "Weight · body conviction", minval = 0, maxval = 100, group = grpQ2,
     tooltip = "How much the score cares that the candle CLOSED near its extreme rather than leaving a long rejection wick.\n\nRaise if wick-fakeouts are your main problem — this penalises them without rejecting them outright, unlike the wick filter.")

wVol = input.int(15, "Weight · volume participation", minval = 0, maxval = 100, group = grpQ2,
     tooltip = "How much the score cares about volume expansion on the breaking candle.\n\n" +
       "SET THIS TO 0 if your feed has synthetic or unreliable volume (many forex and CFD feeds). Its share is redistributed to the other measures, so you lose nothing.\n\n" +
       "On futures, volume is real and worth keeping.")

wLeg = input.int(15, "Weight · size of leg broken", minval = 0, maxval = 100, group = grpQ2,
     tooltip = "How much the score cares that the swing being broken was a LARGE, well-formed leg rather than a shallow one.\n\nThis is the only component that looks at structural context rather than the breaking candle itself.")

wFollow = input.int(10, "Weight · follow-through", minval = 0, maxval = 100, group = grpQ2,
     tooltip = "How much the score cares that price kept GOING after clearing the level, rather than stalling the moment it got there.\n\n" +
       "This is the most genuinely independent measure in the score. Clearance, displacement and body conviction all describe the same breaking candle from different angles, so they rise and fall together; follow-through describes what happened NEXT, which none of them can see.\n\n" +
       "REQUIRES 'Confirmation bars after break' (③ Break quality filters) to be 1 or more — that waiting period is where the follow-through is measured. At 0 confirmation bars there is no 'after' yet, so this component returns a neutral half-score for every break, exactly like the volume component does on feeds without real volume.\n\n" +
       "Set to 0 to remove it entirely; its share is redistributed across the other measures.")

// --- Where each measure earns full marks ---------------------------------------
tClear = input.float(0.40, "Full marks · clearance (× ATR)", minval = 0.05, step = 0.05, group = grpQ2,
     tooltip = "Clearance beyond the level that earns the FULL clearance score.\n\n" +
       "LOWER (0.25) = easier to max out, scores cluster high, less discrimination between good and great.\n" +
       "HIGHER (0.60) = only emphatic breaks score well.\n\n" +
       "If almost every break scores 85+, your thresholds are too easy — raise this and 'displacement' first.")

tDisp = input.float(1.20, "Full marks · candle range (× ATR)", minval = 0.10, step = 0.10, group = grpQ2,
     tooltip = "Breaking-candle range that earns the FULL displacement score, in ATR.")

tBody = input.float(0.80, "Full marks · body % of range", minval = 0.40, maxval = 1.00, step = 0.05, group = grpQ2,
     tooltip = "Body-to-range ratio that earns the FULL conviction score.\n\n0.80 = body is 80% of the candle's range. Scoring starts from 0.35 and rises to this value.")

tVol = input.float(1.60, "Full marks · volume (× average)", minval = 0.20, step = 0.10, group = grpQ2,
     tooltip = "Volume multiple that earns the FULL participation score.\n\nScoring starts from 0.70× average and rises to this value. Ignored when the volume weight is 0.")

tLeg = input.float(2.00, "Full marks · leg size (× ATR)", minval = 0.10, step = 0.10, group = grpQ2,
     tooltip = "Size of the broken leg, in ATR, that earns the FULL structural score.\n\nRaise on higher timeframes where legs are naturally larger.")

tFollow = input.float(1.00, "Full marks · follow-through (× ATR)", minval = 0.10, step = 0.10, group = grpQ2,
     tooltip = "How far beyond the level price must travel during the confirmation window to earn the FULL follow-through score, in ATR.\n\nMeasured from the level to the furthest point reached in the break's direction, so a break that clears and keeps running scores high while one that clears and immediately stalls scores near zero.\n\nRaise on instruments that trend hard after breaking; lower on ones that grind.")

// Normalise the weights so the score always lands on a 0-100 scale regardless of
// what the user typed. Without this, zeroing volume would silently cap the score
// at 85 and every threshold you had tuned would shift under you.
float wSum  = wClear + wDisp + wBody + wVol + wLeg + wFollow
float wNorm = wSum > 0 ? 100.0 / wSum : 0.0

lblSize = labelSize == "Tiny" ? size.tiny : labelSize == "Normal" ? size.normal : size.small
// No retestMarkerSizeVal equivalent here: plotshape's `size` needs a const, so
// the retest markers resolve the size at their call sites instead (see the
// six gated plotshape calls near the alerts).
tablePos = tablePosition == "Top Left" ? position.top_left : tablePosition == "Bottom Right" ? position.bottom_right : tablePosition == "Bottom Left" ? position.bottom_left : position.top_right
styleOf(s) => s == "Solid" ? line.style_solid : s == "Dashed" ? line.style_dashed : line.style_dotted

// =============================================================================
// RESOLVE EFFECTIVE VALUES (preset vs custom)
// =============================================================================
bool isCustom = preset == "Custom"

int   swingLen     = isCustom ? mSwingLen : math.max(1, int(math.round(pSwing * dialSwing)))
int   atrLen       = mAtrLen
bool  useAtrFilter = isCustom ? mUseAtrFilter : pAtrMult > 0
float atrMult      = isCustom ? mAtrMult : pAtrMult * dialScale

bool  useStrength  = isCustom ? mUseStrength : pStrength > 0
float strengthMult = isCustom ? mStrength : pStrength * dialScale

bool  useDisplace  = isCustom ? mUseDisplace : pDisplace > 0
float displaceMult = isCustom ? mDisplace : pDisplace * dialScale
bool  useBodyRatio = mUseBodyRatio

bool  useEqualTol  = isCustom ? mUseEqualTol : pEqualTol > 0
float equalTolMult = isCustom ? mEqualTol : pEqualTol * dialScale

int   cooldownBars = isCustom ? mCooldown : int(math.round(pCooldown * dialScale))

bool  strictBreak  = mStrictBreak
int   confirmBars  = mConfirmBars

// =============================================================================
// TIMEFRAME ADAPTATION
// =============================================================================
// tfScale is the current chart's minutes-per-bar relative to the 15-minute
// baseline every default bar-count below was designed around (the same
// baseline the Balanced preset targets). Falls back to neutral (1.0) on
// non-time-based charts (Renko/Range/Tick) where in_seconds() isn't meaningful.
float tfSeconds = timeframe.in_seconds(timeframe.period)
float tfScale   = tfSeconds > 0 ? (tfSeconds / 60.0) / 15.0 : 1.0

// Rescales a bar count authored against the 15-minute baseline so it spans
// the same real time on the current chart. Clamped to [minBars, maxBars] —
// the same range the underlying input already allows — so auto-adapt can
// never land outside a value you could have picked manually.
scaleBars(int bars, int minBars, int maxBars) =>
    useAutoTF ? int(math.max(minBars, math.min(maxBars, math.round(bars / tfScale)))) : bars

int effContExtend    = scaleBars(contExtendBars, 0, 500)
int effRevExtend  = scaleBars(revExtendBars, 0, 500)
int effLiveExtend   = scaleBars(liveExtendBars, 0, 200)
int effIntExtend    = scaleBars(30, 3, 300)
int effRetestWindow = scaleBars(100, 10, 500)
int effRetestMinAge = scaleBars(3, 1, 20)
int effRetestMaxAge = scaleBars(50, 5, 200)
int effRetestCooldown = scaleBars(retestCooldown, 1, 200)

// =============================================================================
// CORE CALCULATIONS
// =============================================================================
// Every size-based threshold in this script is a multiple of atrVal, so the
// choice of estimator propagates everywhere. ta.tr(true) is gap-aware (it
// measures against the previous close), which matters on session boundaries.
// Both branches are evaluated unconditionally — ta.* calls must not sit
// behind a condition in Pine or their internal state desynchronises.
float trueRange = ta.tr(true)
float atrWilder = ta.atr(atrLen)
float atrMedian = ta.median(trueRange, atrLen)
atrVal = volMeasure == "Median true range" ? atrMedian : atrWilder

emaVal = ta.ema(close, mTrendLen)

// ---------------------------- Volume baseline --------------------------------
// A trailing mean is the wrong reference for intraday volume: the intraday
// profile is U-shaped, so a 20-bar mean at 10:00 is measuring the opening
// surge and at 12:00 the lunch lull. The filter then rejects or passes breaks
// largely according to the clock. Comparing each bar against the SAME slot on
// previous days removes that, which is what "relative volume" means.
//
// One decaying accumulator per intraday slot. Decay makes the baseline follow
// the instrument's current activity rather than averaging its whole history:
// at 0.97 per session, a day's weight halves after roughly 23 sessions.
var array<float> todVolSum = array.new_float(0)
var array<float> todVolCnt = array.new_float(0)

int tfMinutes = math.max(1, int(math.round(tfSeconds / 60.0)))
int todSlots  = timeframe.isintraday and tfSeconds > 0 ? int(math.ceil(1440.0 / tfMinutes)) : 0

if todSlots > 0 and array.size(todVolSum) != todSlots
    todVolSum := array.new_float(todSlots, 0.0)
    todVolCnt := array.new_float(todSlots, 0.0)

float todVolAvg = na
if todSlots > 0
    int slot = int(math.floor((hour * 60.0 + minute) / tfMinutes)) % todSlots
    float prevCnt = array.get(todVolCnt, slot)
    // Read BEFORE accumulating, so a bar never contributes to the baseline it
    // is being judged against.
    if prevCnt > 0
        todVolAvg := array.get(todVolSum, slot) / prevCnt
    // Only confirmed bars update history — otherwise the live bar's partial
    // volume would be folded in repeatedly as it ticks.
    if barstate.isconfirmed
        float d = 0.97
        array.set(todVolSum, slot, array.get(todVolSum, slot) * d + volume)
        array.set(todVolCnt, slot, prevCnt * d + 1.0)

// ta.* must run unconditionally to keep their internal state in step.
float volSma = ta.sma(volume, mVolLen)
float volMed = ta.median(volume, mVolLen)

// Time of day falls back to the median until its per-slot history has warmed
// up, and on non-intraday charts where the concept does not apply.
float volAvg = volMed
if volBaseline == "Simple average"
    volAvg := volSma
else if volBaseline == "Time of day"
    volAvg := na(todVolAvg) ? volMed : todVolAvg

bool inSession = not mUseSession or not na(time(timeframe.period, mSession))

// =============================================================================
// SWING ENGINE
// =============================================================================
// Two ways to decide a swing is confirmed, producing the same interface
// downstream: a value (ph / pl) and the bar it belongs to (phBar / plBar).
//
// The pivot engine's confirmation lag is a fixed bar count, which means
// different amounts of real time and real movement depending on when it lands.
// The directional-change engine instead confirms an extreme once price has
// retraced a volatility-scaled distance from it — the trigger is the market
// actually turning, so a sharp reversal confirms almost at once while a slow
// drift takes as long as it genuinely takes.
bool useDC = swingEngine == "Directional change (adaptive)"

// ta.* must be evaluated on every bar regardless of which engine is selected,
// or their internal series state desynchronises the moment you switch.
float pivPh = ta.pivothigh(high, swingLen, swingLen)
float pivPl = ta.pivotlow(low, swingLen, swingLen)

// --- Directional-change state ------------------------------------------------
var float dcExtreme = na   // running extreme in the direction currently sought
var int   dcExtBar  = na
var int   dcDir     = 0    // +1 seeking a high, -1 seeking a low, 0 unseeded

float dcPh    = na
int   dcPhBar = na
float dcPl    = na
int   dcPlBar = na

if useDC and atrVal > 0
    float theta = dcMult * atrVal
    if dcDir == 0
        // Seed arbitrarily on the first usable bar; whichever side comes first
        // is confirmed first, and the alternation is self-correcting after.
        dcDir     := 1
        dcExtreme := high
        dcExtBar  := bar_index
    else if dcDir == 1
        if high > dcExtreme
            dcExtreme := high
            dcExtBar  := bar_index
        // Retraced far enough from the running high: that high was the swing.
        if close < dcExtreme - theta
            dcPh      := dcExtreme
            dcPhBar   := dcExtBar
            dcDir     := -1
            dcExtreme := low
            dcExtBar  := bar_index
    else
        if low < dcExtreme
            dcExtreme := low
            dcExtBar  := bar_index
        if close > dcExtreme + theta
            dcPl      := dcExtreme
            dcPlBar   := dcExtBar
            dcDir     := 1
            dcExtreme := high
            dcExtBar  := bar_index

float ph    = useDC ? dcPh : pivPh
int   phBar = useDC ? dcPhBar : (na(pivPh) ? na : bar_index - swingLen)
float pl    = useDC ? dcPl : pivPl
int   plBar = useDC ? dcPlBar : (na(pivPl) ? na : bar_index - swingLen)

// Internal structure pivots. Computed unconditionally and gated afterwards,
// for the same reason the swing engine above does: a ta.* call behind a
// condition is not guaranteed to run every bar, which desynchronises its
// internal state. Harmless while useInternal is a static input, but Pine warns
// on it and the pattern is wrong to leave lying around.
float iPhRaw = ta.pivothigh(high, intSwingLen, intSwingLen)
float iPlRaw = ta.pivotlow(low, intSwingLen, intSwingLen)
float iPh = useInternal ? iPhRaw : na
float iPl = useInternal ? iPlRaw : na

var float watchHigh    = na
var int   watchHighBar = na
var float watchLow     = na
var int   watchLowBar  = na
var float refHigh = na
var float refLow  = na
var float lastBrokenHigh = na
var float lastBrokenLow  = na

// The swing that held the watched level's position BEFORE the current one.
// This is what makes an "HH" label literally true: a break above watchHigh is
// a Higher High only if watchHigh itself sits above the high before it. The
// old code inferred this from `bias` (set by the previous break), which could
// label a break of a genuinely LOWER high as "HH" whenever bias was still
// bullish from an earlier move.
var float prevSwingHigh = na
var float prevSwingLow  = na

// Internal structure vars
var float iWatchHigh = na
var int   iWatchHighBar = na
var float iWatchLow = na
var int   iWatchLowBar = na
var float iRefHigh = na
var float iRefLow = na
// Internal structure gets its own previous-swing references for the same
// reason the main structure does — an "i-HH" should mean a genuinely higher
// minor high, not just "the last main-structure break happened to be up".
var float iPrevSwingHigh = na
var float iPrevSwingLow  = na

// =============================================================================
// HISTORY MANAGEMENT ARRAYS
// =============================================================================
var array<line> histLines = array.new_line(0)
var array<label> histLabels = array.new_label(0)
var array<line> histVertLines = array.new_line(0)

deleteOldest() =>
    if maxHistory > 0
        while array.size(histLines) > maxHistory
            line.delete(array.shift(histLines))
        while array.size(histLabels) > maxHistory
            label.delete(array.shift(histLabels))
        while array.size(histVertLines) > maxHistory
            line.delete(array.shift(histVertLines))

// Internal structure draws far more often than main structure (smaller swing
// length), and previously did so with untracked line.new/label.new calls that
// were never deleted. Because TradingView applies max_lines_count /
// max_labels_count to ONE shared pool per script, that quietly evicted the
// oldest MAIN structure drawings to make room for minor internal ones —
// turning on internal structure silently ate your HH/LL/LH/HL history.
// Tracking them here keeps the two budgets separate and bounded.
var array<line>  intLines  = array.new_line(0)
var array<label> intLabels = array.new_label(0)

// Ties the internal budget to the same "how much history do you want" dial the
// main structure uses. maxHistory = 0 means unlimited for main structure, but
// internal still needs a ceiling or it reintroduces the eviction problem.
int intMaxHistory = maxHistory > 0 ? maxHistory : 100

deleteOldestInternal() =>
    while array.size(intLines) > intMaxHistory
        line.delete(array.shift(intLines))
    while array.size(intLabels) > intMaxHistory
        label.delete(array.shift(intLabels))

// =============================================================================
// SWING DETECTION
// =============================================================================
if not na(ph)
    bool bigEnough = not useAtrFilter or na(refLow) or (ph - refLow) >= atrMult * atrVal
    if bigEnough
        // Demote the outgoing swing high before overwriting it — that stored
        // value is what the next break compares against to decide HH vs. LH.
        // Guarded: straight after a break watchHigh is na, and the break
        // handler has already parked the broken level in prevSwingHigh, so an
        // unguarded demote would erase exactly the reference we need.
        if not na(watchHigh)
            prevSwingHigh := watchHigh
        watchHigh     := ph
        watchHighBar  := phBar
        refHigh       := ph

if not na(pl)
    bool bigEnough = not useAtrFilter or na(refHigh) or (refHigh - pl) >= atrMult * atrVal
    if bigEnough
        if not na(watchLow)
            prevSwingLow := watchLow
        watchLow     := pl
        watchLowBar  := plBar
        refLow       := pl

// Anchor to true leg extreme
if not na(watchHigh) and high > watchHigh and close <= watchHigh
    watchHigh    := high
    watchHighBar := bar_index
if not na(watchLow) and low < watchLow and close >= watchLow
    watchLow    := low
    watchLowBar := bar_index

// Internal swing detection
if useInternal
    if not na(iPh)
        bool iBig = not useAtrFilter or na(iRefLow) or (iPh - iRefLow) >= atrMult * atrVal * 0.5
        if iBig
            if not na(iWatchHigh)
                iPrevSwingHigh := iWatchHigh
            iWatchHigh    := iPh
            iWatchHighBar := bar_index - intSwingLen
            iRefHigh      := iPh
    if not na(iPl)
        bool iBig = not useAtrFilter or na(iRefHigh) or (iRefHigh - iPl) >= atrMult * atrVal * 0.5
        if iBig
            if not na(iWatchLow)
                iPrevSwingLow := iWatchLow
            iWatchLow    := iPl
            iWatchLowBar := bar_index - intSwingLen
            iRefLow      := iPl
    if not na(iWatchHigh) and high > iWatchHigh and close <= iWatchHigh
        iWatchHigh    := high
        iWatchHighBar := bar_index
    if not na(iWatchLow) and low < iWatchLow and close >= iWatchLow
        iWatchLow    := low
        iWatchLowBar := bar_index

// ---------------------------- Break candidate --------------------------------
float upRef   = strictBreak ? math.min(open, close) : close
float downRef = strictBreak ? math.max(open, close) : close
float clearance = useStrength ? strengthMult * atrVal : 0.0

float candleRange = high - low
float candleBody  = math.abs(close - open)
bool  hasDisplace = not useDisplace or (candleRange >= displaceMult * atrVal and (not useBodyRatio or candleBody >= candleRange * 0.5))
bool  hasVolume   = not mUseVolume or na(volAvg) or volume >= volAvg * mVolMult

// ---------------------------- Confidence scoring -----------------------------
// Grades a break 0-100 across five INDEPENDENT measures. Independence matters:
// stacking three tests of "was the candle big?" adds lag without adding
// information, whereas clearance / size / conviction / participation / leg
// context each describe something the others cannot see.
//
// Contains no ta.* calls, so it is safe to call conditionally.
// Clamp a raw measurement to the 0-1 fraction of its full-marks target.
frac01(float v, float target) => math.min(1.0, math.max(0.0, v / math.max(target, 0.0001)))

scoreBreak(bool isUp, float lvl) =>
    float sc = 0.0
    if atrVal > 0 and not na(lvl)
        // Each component yields a 0-1 fraction, scaled by its normalised weight.

        // 1. Clearance beyond the level.
        sc += frac01((isUp ? upRef - lvl : lvl - downRef) / atrVal, tClear) * wClear * wNorm

        // 2. Displacement of the breaking candle.
        sc += frac01(candleRange / atrVal, tDisp) * wDisp * wNorm

        // 3. Body conviction. Scored from 35% body upward, so a long-wicked
        //    rejection candle earns nothing here even if its range was large.
        float bodyPct = candleRange > 0 ? candleBody / candleRange : 0.0
        sc += frac01(bodyPct - 0.35, math.max(tBody - 0.35, 0.01)) * wBody * wNorm

        // 4. Volume participation. Falls back to a neutral half-score when
        //    volume is missing, so feeds without real volume are not penalised.
        float volFrac = 0.5
        if not na(volAvg) and volAvg > 0
            volFrac := frac01(volume / volAvg - 0.70, math.max(tVol - 0.70, 0.01))
        sc += volFrac * wVol * wNorm

        // 5. Size of the leg being broken — the only component that reads
        //    structural context rather than the breaking candle itself.
        //    na propagates through arithmetic, so an absent reference simply
        //    leaves legRaw na and the neutral half-score stands.
        float legFrac = 0.5
        float legRaw = isUp ? lvl - refLow : refHigh - lvl
        if not na(legRaw)
            legFrac := frac01(legRaw / atrVal, tLeg)
        sc += legFrac * wLeg * wNorm
    // Returned UNROUNDED and WITHOUT the follow-through component, which is
    // only knowable after the confirmation window has elapsed. The caller adds
    // it and rounds once, so the score is never rounded twice.
    sc

var int lastBreakBar = na
bool coolOk = cooldownBars == 0 or na(lastBreakBar) or (bar_index - lastBreakBar) >= cooldownBars

float eqTol = useEqualTol ? equalTolMult * atrVal : 0.0

// Wick rejection: the part of the wick sitting BEYOND the level, versus the
// part of the BODY sitting beyond the level. Both measurements are clipped at
// the level itself, which is what makes them comparable.
//
// The previous version compared the ENTIRE upper wick against the close's
// clearance (close - watchHigh). For a plain bullish breakout candle those two
// happen to coincide, so it looked correct; they diverge whenever the candle
// closes above the level but bearish (body measured as clearance, not body),
// or opens already above the level (clearance becomes huge and the filter
// stops triggering at all). Measuring both quantities against the level fixes
// all three cases.
float bodyTop = math.max(open, close)
float bodyBot = math.min(open, close)

float wickAboveLvl = na(watchHigh) ? 0.0 : math.max(0.0, high - math.max(bodyTop, watchHigh))
float bodyAboveLvl = na(watchHigh) ? 0.0 : math.max(0.0, bodyTop - math.max(bodyBot, watchHigh))
float wickBelowLvl = na(watchLow)  ? 0.0 : math.max(0.0, math.min(bodyBot, watchLow) - low)
float bodyBelowLvl = na(watchLow)  ? 0.0 : math.max(0.0, math.min(bodyTop, watchLow) - bodyBot)

bool wickOkUp   = not mUseWickReject or na(watchHigh) or wickAboveLvl <= bodyAboveLvl
bool wickOkDown = not mUseWickReject or na(watchLow)  or wickBelowLvl <= bodyBelowLvl

bool trendOkUp   = not mUseTrendFilter or close > emaVal
bool trendOkDown = not mUseTrendFilter or close < emaVal

bool rawUp   = not na(watchHigh) and upRef   > watchHigh + clearance
bool rawDown = not na(watchLow)  and downRef < watchLow  - clearance

bool upNotDup   = na(lastBrokenHigh) or na(watchHigh) or math.abs(watchHigh - lastBrokenHigh) > eqTol
bool downNotDup = na(lastBrokenLow)  or na(watchLow)  or math.abs(watchLow  - lastBrokenLow)  > eqTol

bool candUp   = rawUp   and hasDisplace and hasVolume and coolOk and upNotDup   and wickOkUp   and trendOkUp   and inSession
bool candDown = rawDown and hasDisplace and hasVolume and coolOk and downNotDup and wickOkDown and trendOkDown and inSession

// Score the candidates, then apply the minimum-score gate.
//
// The gate has to run now, before the confirmation window that follow-through
// is measured over has even started. So gating uses a NEUTRAL follow-through
// allowance — the same half-score an unmeasurable component always falls back
// to. Without it, a non-zero follow-through weight would make every candidate
// score short of its own maximum and quietly tighten whatever minimum score
// you had tuned.
float ftNeutral = 0.5 * wFollow * wNorm

float scoreUp   = candUp   ? scoreBreak(true,  watchHigh) : 0.0
float scoreDown = candDown ? scoreBreak(false, watchLow)  : 0.0
if useScore and minScore > 0
    candUp   := candUp   and (scoreUp   + ftNeutral) >= minScore
    candDown := candDown and (scoreDown + ftNeutral) >= minScore

// Internal break candidates
bool iRawUp   = useInternal and not na(iWatchHigh) and close > iWatchHigh
bool iRawDown = useInternal and not na(iWatchLow)  and close < iWatchLow
bool iCandUp  = iRawUp  and hasDisplace and hasVolume and trendOkUp   and inSession
bool iCandDown= iRawDown and hasDisplace and hasVolume and trendOkDown and inSession

// ---------------------------- Smart confirmation delay -----------------------
var int   pendDir   = 0      // 1 up, -1 down, 0 none
var int   pendBar   = na
var float pendLevel = na
var int   pendLevelBar = na
var float pendClearance = 0.0
var float pendScore = 0.0
// Furthest price travelled beyond the pending level, in price terms, while the
// confirmation window ran. This is the follow-through measurement: it is the
// only score input that describes what happened AFTER the break, which is why
// it carries information none of the candle-shape measures can.
var float pendMaxExc = 0.0

bool fireUp   = false
bool fireDown = false
float fireLevel = na
int   fireLevelBar = na
float fireClearance = 0.0
float fireScore = 0.0

if confirmBars == 0
    fireUp   := candUp
    fireDown := candDown
    fireLevel := candUp ? watchHigh : candDown ? watchLow : na
    fireLevelBar := candUp ? watchHighBar : candDown ? watchLowBar : na
    // Guarded against a zero/na ATR, which the other two call sites already were.
    fireClearance := atrVal > 0 ? (candUp ? (upRef - watchHigh) / atrVal : candDown ? (watchLow - downRef) / atrVal : 0.0) : 0.0
    // With no confirmation window there is no "after" to measure, so
    // follow-through takes its neutral half-score for every break — the same
    // fallback the volume component uses on feeds without real volume.
    fireScore := math.round((candUp ? scoreUp : candDown ? scoreDown : 0.0) + ftNeutral)
else
    // Cancel or upgrade pending breaks
    if pendDir == 1
        bool cancelled = close < pendLevel - eqTol or candDown
        bool upgraded  = candUp and not na(watchHigh) and watchHigh > pendLevel + eqTol
        if cancelled or upgraded
            pendDir := 0
            pendBar := na
            pendLevel := na
            pendLevelBar := na
            pendClearance := 0.0
            pendScore := 0.0
            pendMaxExc := 0.0
            if upgraded
                pendDir := 1
                pendBar := bar_index
                pendLevel := watchHigh
                pendLevelBar := watchHighBar
                pendClearance := atrVal > 0 ? (upRef - watchHigh) / atrVal : 0.0
                pendScore := scoreUp
                pendMaxExc := math.max(0.0, high - watchHigh)
    else if pendDir == -1
        bool cancelled = close > pendLevel + eqTol or candUp
        bool upgraded  = candDown and not na(watchLow) and watchLow < pendLevel - eqTol
        if cancelled or upgraded
            pendDir := 0
            pendBar := na
            pendLevel := na
            pendLevelBar := na
            pendClearance := 0.0
            pendScore := 0.0
            pendMaxExc := 0.0
            if upgraded
                pendDir := -1
                pendBar := bar_index
                pendLevel := watchLow
                pendLevelBar := watchLowBar
                pendClearance := atrVal > 0 ? (watchLow - downRef) / atrVal : 0.0
                pendScore := scoreDown
                pendMaxExc := math.max(0.0, watchLow - low)

    // Start new pending if none active
    if pendDir == 0
        if candUp
            pendDir := 1
            pendBar := bar_index
            pendLevel := watchHigh
            pendLevelBar := watchHighBar
            pendClearance := atrVal > 0 ? (upRef - watchHigh) / atrVal : 0.0
            pendScore := scoreUp
            pendMaxExc := math.max(0.0, high - watchHigh)
        else if candDown
            pendDir := -1
            pendBar := bar_index
            pendLevel := watchLow
            pendLevelBar := watchLowBar
            pendClearance := atrVal > 0 ? (watchLow - downRef) / atrVal : 0.0
            pendScore := scoreDown
            pendMaxExc := math.max(0.0, watchLow - low)

    // Extend the follow-through measurement across the waiting period. Runs
    // after the start/upgrade blocks so a pending opened THIS bar already has
    // its own excursion counted, and before the confirmation check so the bar
    // that confirms contributes too.
    if pendDir == 1 and not na(pendLevel)
        pendMaxExc := math.max(pendMaxExc, high - pendLevel)
    else if pendDir == -1 and not na(pendLevel)
        pendMaxExc := math.max(pendMaxExc, pendLevel - low)

    // Check for confirmation
    if pendDir != 0 and bar_index - pendBar >= confirmBars
        bool stillUp   = pendDir ==  1 and close > pendLevel
        bool stillDown = pendDir == -1 and close < pendLevel
        // The confirmation window has now elapsed, so follow-through is finally
        // measurable: how far price ran past the level, in ATR, against the
        // full-marks target.
        float ftScore = atrVal > 0 ? frac01(pendMaxExc / atrVal, tFollow) * wFollow * wNorm : ftNeutral
        if stillUp
            fireUp := true
            fireLevel := pendLevel
            fireLevelBar := pendLevelBar
            fireClearance := pendClearance
            fireScore := math.round(pendScore + ftScore)
        if stillDown
            fireDown := true
            fireLevel := pendLevel
            fireLevelBar := pendLevelBar
            fireClearance := pendClearance
            fireScore := math.round(pendScore + ftScore)
        pendDir := 0
        pendBar := na
        pendLevel := na
        pendLevelBar := na
        pendClearance := 0.0
        pendScore := 0.0
        pendMaxExc := 0.0

// ---------------------------- Break classification ---------------------------
// Decided once, here, from the pivot sequence — BEFORE the draw blocks below
// mutate prevSwingHigh/prevSwingLow. Labels, line colours and alerts all read
// these same four flags, so a break that draws as "HH" can never fire the
// "LH (Reversal Up)" alert. (v7.5 derived both from `bias` instead — they
// matched each other, but could jointly mislabel the break.)
bool fireIsHH = fireUp   and not na(fireLevel) and (na(prevSwingHigh) or fireLevel > prevSwingHigh)
bool fireIsLH = fireUp   and not na(fireLevel) and not fireIsHH
bool fireIsLL = fireDown and not na(fireLevel) and (na(prevSwingLow)  or fireLevel < prevSwingLow)
bool fireIsHL = fireDown and not na(fireLevel) and not fireIsLL

// ---------------------------- State machine ----------------------------------
var int bias = 0

drawBreak(bool isUp, float lvl, int lvlBar, float clr, float scr, string txt, color col, string lStyle, int lWidth, int lExtendBars, bool lVert, string vStyle, int vWidth, bool enabled) =>
    deleteOldest()
    string labelText = txt
    if verboseLabels and atrVal > 0
        string sign = isUp ? "+" : "-"
        labelText := labelText + " " + sign + str.tostring(math.abs(clr), "#.#")
    if useScore and showScore
        labelText := labelText + " " + str.tostring(scr, "#")
    // Fade weak breaks so strong structure reads at a glance. 40 and below is
    // drawn faint, 90 and above solid.
    int fade = useScore and scoreColors ? int(math.round(math.min(60.0, math.max(0.0, (90.0 - scr) * 1.2)))) : 0
    color drawCol = color.new(col, fade)
    // `enabled` is the per-type master switch (Draw HH/LL lines / Draw
    // LH/HL lines) — it gates the label too, not just the line, so turning
    // off continuation breaks actually hides them entirely rather than
    // leaving an unexplained label with no line under it.
    if showLabels and enabled
        label lbl = label.new(bar_index, isUp ? high + atrVal * 0.6 : low - atrVal * 0.6, labelText,
             style = isUp ? label.style_label_down : label.style_label_up,
             color = color.new(color.black, 15), textcolor = drawCol, size = lblSize)
        array.push(histLabels, lbl)
    if enabled
        int rightBar = lExtendBars > 0 ? bar_index + lExtendBars : bar_index
        line ln = line.new(lvlBar, lvl, rightBar, lvl,
             color = drawCol, style = styleOf(lStyle), width = lWidth)
        array.push(histLines, ln)
        if lVert
            line vln = line.new(bar_index, lvl, bar_index, isUp ? high + atrVal * 0.4 : low - atrVal * 0.4,
                 color = color.new(col, math.min(90, fade + 45)), style = styleOf(vStyle), width = vWidth)
            array.push(histVertLines, vln)

if fireUp and not na(fireLevel)
    // A break above a high that sits ABOVE the previous swing high is a Higher
    // High (continuation); above a high that sits below it, the Lower High
    // capping a downtrend just gave way (reversal).
    bool  isRev  = fireIsLH
    color col    = isRev ? colRev : colCont
    bool  drawIt = isRev ? showRevLines : showContLines
    string txt   = fireIsHH ? "HH" : "LH"

    drawBreak(true, fireLevel, fireLevelBar, fireClearance, fireScore, txt, col,
         isRev ? revLineStyle : contLineStyle,
         isRev ? revLineWidth : contLineWidth,
         isRev ? effRevExtend : effContExtend,
         isRev ? revVertical : contVertical,
         isRev ? revVertStyle : contVertStyle,
         isRev ? revVertWidth : contVertWidth,
         drawIt)

    // v5 FIX: reset opposite duplicate filter so old levels don't block new structure
    lastBrokenHigh := fireLevel
    lastBrokenLow  := na
    bias           := 1
    lastBreakBar   := bar_index
    // The level just broken becomes the reference the NEXT high is judged
    // against, and the outgoing swing low is preserved as the low-side
    // reference — both must survive the reset for the next break to be
    // classifiable at all.
    prevSwingHigh  := fireLevel
    if not na(watchLow)
        prevSwingLow := watchLow
    watchHigh      := na
    watchHighBar   := na
    watchLow       := na
    watchLowBar    := na
    // Advance the high-side ATR reference to the level just broken and KEEP
    // the low-side one. Nulling both (the old behaviour) made na(refLow)
    // short-circuit the min-swing-size filter to true, so the first pivot
    // after every break skipped the filter entirely, and left the score's
    // leg-size component falling back to its neutral 0.5 whenever a trend
    // produced consecutive highs without an intervening pivot low.
    refHigh        := math.max(nz(refHigh, fireLevel), fireLevel)

if fireDown and not na(fireLevel)
    // Mirror: below the previous swing low is a Lower Low (continuation);
    // above it, the Higher Low supporting an uptrend just gave way (reversal).
    bool  isRev  = fireIsHL
    color col    = isRev ? colRev : colCont
    bool  drawIt = isRev ? showRevLines : showContLines
    string txt   = fireIsLL ? "LL" : "HL"

    drawBreak(false, fireLevel, fireLevelBar, fireClearance, fireScore, txt, col,
         isRev ? revLineStyle : contLineStyle,
         isRev ? revLineWidth : contLineWidth,
         isRev ? effRevExtend : effContExtend,
         isRev ? revVertical : contVertical,
         isRev ? revVertStyle : contVertStyle,
         isRev ? revVertWidth : contVertWidth,
         drawIt)

    // v5 FIX: reset opposite duplicate filter
    lastBrokenLow  := fireLevel
    lastBrokenHigh := na
    bias           := -1
    lastBreakBar   := bar_index
    prevSwingLow   := fireLevel
    if not na(watchHigh)
        prevSwingHigh := watchHigh
    watchLow       := na
    watchLowBar    := na
    watchHigh      := na
    watchHighBar   := na
    // Mirror of the up break: advance the low-side ATR reference to the level
    // just broken, keep the high-side one.
    refLow         := math.min(nz(refLow, fireLevel), fireLevel)

// ---------------------------- Internal structure breaks ----------------------
if useInternal
    if iCandUp and not na(iWatchHigh)
        deleteOldestInternal()
        float iBrokeLevel = iWatchHigh
        bool iIsHH = na(iPrevSwingHigh) or iWatchHigh > iPrevSwingHigh
        bool iIsRev = not iIsHH
        color iCol = iIsRev ? intColRev : intColCont
        string iTxt = iIsHH ? "i-HH" : "i-LH"
        bool iDrawIt = iIsRev ? showInternalRev : showInternalCont
        if showLabels and iDrawIt
            label iLbl = label.new(bar_index, high + atrVal * 0.3, iTxt,
                 style = label.style_label_down, color = color.new(color.black, 15),
                 textcolor = color.new(iCol, intTransparency), size = size.tiny)
            array.push(intLabels, iLbl)
        if iDrawIt
            line iLn = line.new(iWatchHighBar, iWatchHigh, bar_index + effIntExtend, iWatchHigh,
                 color = color.new(iCol, intTransparency), style = styleOf(intLineStyle),
                 width = intLineWidth)
            array.push(intLines, iLn)
        iPrevSwingHigh := iBrokeLevel
        if not na(iWatchLow)
            iPrevSwingLow := iWatchLow
        iWatchHigh := na
        iWatchHighBar := na
        iWatchLow := na
        iWatchLowBar := na
        iRefHigh := math.max(nz(iRefHigh, iBrokeLevel), iBrokeLevel)

    if iCandDown and not na(iWatchLow)
        deleteOldestInternal()
        float iBrokeLevel = iWatchLow
        bool iIsLL = na(iPrevSwingLow) or iWatchLow < iPrevSwingLow
        bool iIsRev = not iIsLL
        color iCol = iIsRev ? intColRev : intColCont
        string iTxt = iIsLL ? "i-LL" : "i-HL"
        bool iDrawIt = iIsRev ? showInternalRev : showInternalCont
        if showLabels and iDrawIt
            label iLbl = label.new(bar_index, low - atrVal * 0.3, iTxt,
                 style = label.style_label_up, color = color.new(color.black, 15),
                 textcolor = color.new(iCol, intTransparency), size = size.tiny)
            array.push(intLabels, iLbl)
        if iDrawIt
            line iLn = line.new(iWatchLowBar, iWatchLow, bar_index + effIntExtend, iWatchLow,
                 color = color.new(iCol, intTransparency), style = styleOf(intLineStyle),
                 width = intLineWidth)
            array.push(intLines, iLn)
        iPrevSwingLow := iBrokeLevel
        if not na(iWatchHigh)
            iPrevSwingHigh := iWatchHigh
        iWatchLow := na
        iWatchLowBar := na
        iWatchHigh := na
        iWatchHighBar := na
        iRefLow := math.min(nz(iRefLow, iBrokeLevel), iBrokeLevel)

// ---------------------------- Unconfirmed preview ----------------------------
var line pendLine = na
if showUnconfirmed and confirmBars > 0
    if pendDir != 0 and not na(pendLevel)
        line.delete(pendLine)
        color pendCol = pendDir == 1 ? color.new(colCont, 75) : color.new(colRev, 75)
        pendLine := line.new(pendLevelBar, pendLevel, bar_index, pendLevel,
             color = pendCol, style = styleOf(pendLineStyle), width = pendLineWidth)
    else
        line.delete(pendLine)
        pendLine := na
else
    line.delete(pendLine)
    pendLine := na

// ---------------------------- Live levels ------------------------------------
var line liveHiLine = na
var line liveLoLine = na

if barstate.islast
    line.delete(liveHiLine)
    line.delete(liveLoLine)
    if showLiveHigh and not na(watchHigh)
        liveHiLine := line.new(watchHighBar, watchHigh, bar_index + effLiveExtend, watchHigh,
             color = color.new(colCont, 60), style = styleOf(liveLineStyle), width = liveLineWidth)
    if showLiveLow and not na(watchLow)
        liveLoLine := line.new(watchLowBar, watchLow, bar_index + effLiveExtend, watchLow,
             color = color.new(colRev, 60), style = styleOf(liveLineStyle), width = liveLineWidth)

// ---------------------------- Pivot markers ----------------------------------
// plotshape's offset must be a constant, so the two engines get their own
// pair. Pivot mode draws the marker back at the swing bar itself; directional
// change confirms at a variable distance, so its marker sits on the bar where
// confirmation happened — which is also the bar you could first have acted on.
plotshape(showPivots and not useDC and not na(ph), title = "Swing High", location = location.abovebar,
     style = shape.triangledown, color = color.new(color.gray, 60), size = size.tiny, offset = -swingLen)
plotshape(showPivots and not useDC and not na(pl), title = "Swing Low", location = location.belowbar,
     style = shape.triangleup, color = color.new(color.gray, 60), size = size.tiny, offset = -swingLen)
plotshape(showPivots and useDC and not na(ph), title = "Swing High (confirmed)", location = location.abovebar,
     style = shape.triangledown, color = color.new(color.gray, 40), size = size.tiny)
plotshape(showPivots and useDC and not na(pl), title = "Swing Low (confirmed)", location = location.belowbar,
     style = shape.triangleup, color = color.new(color.gray, 40), size = size.tiny)

bgcolor(tintBias and bias ==  1 ? color.new(colCont, 94) : na, title = "Bullish bias")
bgcolor(tintBias and bias == -1 ? color.new(colRev, 94) : na, title = "Bearish bias")

// Candle coloring
barcolor(colorCandles ? (bias == 1 ? colCont : bias == -1 ? colRev : na) : na)

// =============================================================================
// SIGNAL QUALITY DIAGNOSTIC
// =============================================================================
// Answers one question the backtest cannot: ARE THE BREAKS THEMSELVES ANY
// GOOD, independent of how you trade them?
//
// A backtest measures detection, entry timing, exit rules and costs all at
// once, and you cannot see through that stack to any single layer. So this
// measures the raw signal instead: after each break, how far did price travel
// in the signal's favour (MFE) versus against it (MAE) over the next N bars,
// both in ATR? No entries, no stops, no targets, no fees.
//
// Read it as:
//   MFE > MAE            -> breaks lead somewhere. Losses are a trading
//                           problem: entry timing, exits, or costs.
//   MFE ~= MAE           -> the breaks are coin flips. No trade rule fixes
//                           this; the detection needs work.
//   HIGH-score MFE/MAE
//     better than LOW    -> the confidence score is ranking breaks correctly,
//                           and a score threshold is worth using.
//   no difference        -> the score is decoration, whatever the backtest says.
//
// Nothing here looks into the future: a break is measured only once its N-bar
// window has fully elapsed, which is why results lag by that many bars.
grpDiag = "⑬ Signal quality (diagnostic)"

diagOn = input.bool(false, "Measure forward excursion after each break", group = grpDiag,
     tooltip = "Tracks what price did AFTER each break, with no trade rules attached.\n\nThis is the only measurement in either script that isolates detection quality from everything else. A backtest cannot do it — it entangles detection with entry timing, exit rules and commission, so a bad result there could come from any of the four.\n\nOFF by default because it costs a little performance and most people do not need it running continuously. Turn it on when you want to know whether the signals themselves have an edge.")

diagBars = input.int(20, "  Bars to measure forward", minval = 1, maxval = 200, group = grpDiag,
     tooltip = "How long to follow each break before recording the result.\n\nMatch this to your actual holding period — measuring 20 bars forward tells you nothing useful if you normally exit in 3. The default 20 pairs with the ~14-bar average hold a break-entry strategy tends to produce.\n\nLonger windows measure whether the move persists; shorter ones measure the immediate reaction.")

diagSplit = input.int(60, "  High/low score split", minval = 0, maxval = 100, group = grpDiag,
     tooltip = "Breaks scoring at or above this go in the HIGH bucket, below it in the LOW bucket, and the two are compared in the status table.\n\nThis is the direct test of whether the confidence score means anything: if high-scoring breaks do not show better forward excursion than low-scoring ones, the score is not ranking them and a minimum-score threshold cannot help you.")

// Open measurement windows. One entry per break until its window elapses.
var array<int>   fxBar   = array.new_int(0)
var array<float> fxRef   = array.new_float(0)   // price at the signal
var array<int>   fxDir   = array.new_int(0)     // +1 up, -1 down
var array<float> fxScore = array.new_float(0)
var array<float> fxMFE   = array.new_float(0)   // max favourable, price terms
var array<float> fxMAE   = array.new_float(0)   // max adverse, price terms
var array<float> fxAtr   = array.new_float(0)   // ATR at signal time, to normalise

// Running aggregates, split by score bucket.
var int   hiN = 0
var float hiMFE = 0.0
var float hiMAE = 0.0
var int   loN = 0
var float loMFE = 0.0
var float loMAE = 0.0

if diagOn and (fireUp or fireDown) and not na(fireLevel) and atrVal > 0
    // Measured from the CLOSE, not the broken level: the close is where you
    // could actually have acted, so this reflects a real entry rather than a
    // price that had already gone.
    array.push(fxBar, bar_index)
    array.push(fxRef, close)
    array.push(fxDir, fireUp ? 1 : -1)
    array.push(fxScore, fireScore)
    array.push(fxMFE, 0.0)
    array.push(fxMAE, 0.0)
    array.push(fxAtr, atrVal)

if diagOn and array.size(fxBar) > 0
    for i = 0 to array.size(fxBar) - 1
        int   d   = array.get(fxDir, i)
        float ref = array.get(fxRef, i)
        float fav = d == 1 ? high - ref : ref - low
        float adv = d == 1 ? ref - low  : high - ref
        array.set(fxMFE, i, math.max(array.get(fxMFE, i), fav))
        array.set(fxMAE, i, math.max(array.get(fxMAE, i), adv))

// Retire windows whose measurement period has fully elapsed. Size check and
// age check are split across while/if because Pine's `and` evaluates both
// sides regardless, so array.get would still run on an empty array.
float outMFE   = na
float outMAE   = na
float outScore = na
while array.size(fxBar) > 0
    if bar_index - array.get(fxBar, 0) >= diagBars
        float a  = array.get(fxAtr, 0)
        float sc = array.get(fxScore, 0)
        if a > 0
            outMFE   := array.get(fxMFE, 0) / a
            outMAE   := array.get(fxMAE, 0) / a
            outScore := sc
            if sc >= diagSplit
                hiN   += 1
                hiMFE += outMFE
                hiMAE += outMAE
            else
                loN   += 1
                loMFE += outMFE
                loMAE += outMAE
        array.shift(fxBar)
        array.shift(fxRef)
        array.shift(fxDir)
        array.shift(fxScore)
        array.shift(fxMFE)
        array.shift(fxMAE)
        array.shift(fxAtr)
    else
        break

// ---------------------------- Status table -----------------------------------
var table st = table.new(tablePos, 2, 10,
     border_width = 1, border_color = color.new(color.gray, 70), frame_width = 0)

// Remember the most recent score so the table can show it between breaks.
var float lastScore = na
if fireUp or fireDown
    lastScore := fireScore

if showTable and barstate.islast
    color  biasCol = bias == 1 ? colCont : bias == -1 ? colRev : color.gray
    string biasTxt = bias == 1 ? "Bullish" : bias == -1 ? "Bearish" : "Undefined"
    color  cellBg  = color.new(color.black, 20)

    table.cell(st, 0, 0, "Preset", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    table.cell(st, 1, 0, preset + (isCustom ? "" : " · " + str.tostring(sensDial)),
         text_color = color.white, text_size = size.tiny, bgcolor = cellBg)

    table.cell(st, 0, 1, "Bias", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    table.cell(st, 1, 1, biasTxt, text_color = biasCol, text_size = size.tiny, bgcolor = cellBg)

    table.cell(st, 0, 2, "Watch high", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    table.cell(st, 1, 2, na(watchHigh) ? "—" : str.tostring(watchHigh, format.mintick),
         text_color = colCont, text_size = size.tiny, bgcolor = cellBg)

    table.cell(st, 0, 3, "Watch low", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    table.cell(st, 1, 3, na(watchLow) ? "—" : str.tostring(watchLow, format.mintick),
         text_color = colRev, text_size = size.tiny, bgcolor = cellBg)

    table.cell(st, 0, 4, "Bars since break", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    table.cell(st, 1, 4, na(lastBreakBar) ? "—" : str.tostring(bar_index - lastBreakBar),
         text_color = color.white, text_size = size.tiny, bgcolor = cellBg)

    // In directional-change mode the swing pivot length means nothing, so show
    // the reversal threshold that actually governs swing confirmation instead.
    string swingTxt = useDC ? "DC " + str.tostring(dcMult, "#.#") : str.tostring(swingLen)
    table.cell(st, 0, 5, "Swing / ATR", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    table.cell(st, 1, 5, swingTxt + " · " + str.tostring(atrVal, format.mintick),
         text_color = color.white, text_size = size.tiny, bgcolor = cellBg)

    table.cell(st, 0, 6, "Last score", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    color scoreCol = na(lastScore) ? color.gray : lastScore >= 75 ? color.lime : lastScore >= 55 ? color.yellow : color.orange
    table.cell(st, 1, 6, na(lastScore) ? "—" : str.tostring(lastScore, "#") + " / 100",
         text_color = scoreCol, text_size = size.tiny, bgcolor = cellBg)

    table.cell(st, 0, 7, "Pending", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    string pendTxt = pendDir == 1 ? "Up (" + str.tostring(bar_index - pendBar) + "/" + str.tostring(confirmBars) + ")" :
                     pendDir == -1 ? "Down (" + str.tostring(bar_index - pendBar) + "/" + str.tostring(confirmBars) + ")" : "—"
    color pendTxtCol = pendDir == 1 ? colCont : pendDir == -1 ? colRev : color.gray
    table.cell(st, 1, 7, pendTxt, text_color = pendTxtCol, text_size = size.tiny, bgcolor = cellBg)

    // Signal-quality rows. MFE/MAE per bucket, in ATR. A ratio above 1 means
    // breaks in that bucket led somewhere on average; at or below 1 they are
    // coin flips and no trade rule will rescue them.
    if diagOn
        float hiRatio = hiN > 0 and hiMAE > 0 ? hiMFE / hiMAE : na
        float loRatio = loN > 0 and loMAE > 0 ? loMFE / loMAE : na

        string hiTxt = hiN == 0 ? "—" :
             str.tostring(hiMFE / hiN, "#.##") + "/" + str.tostring(hiMAE / hiN, "#.##") +
             " =" + (na(hiRatio) ? "—" : str.tostring(hiRatio, "#.##")) + " (n=" + str.tostring(hiN) + ")"
        string loTxt = loN == 0 ? "—" :
             str.tostring(loMFE / loN, "#.##") + "/" + str.tostring(loMAE / loN, "#.##") +
             " =" + (na(loRatio) ? "—" : str.tostring(loRatio, "#.##")) + " (n=" + str.tostring(loN) + ")"

        // Green only when the bucket is genuinely favourable AND has enough
        // samples to mean anything. 20 is deliberately conservative.
        color hiCol = na(hiRatio) or hiN < 20 ? color.gray : hiRatio > 1.15 ? color.lime : hiRatio < 0.9 ? color.red : color.yellow
        color loCol = na(loRatio) or loN < 20 ? color.gray : loRatio > 1.15 ? color.lime : loRatio < 0.9 ? color.red : color.yellow

        table.cell(st, 0, 8, "Sig MFE/MAE hi", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
        table.cell(st, 1, 8, hiTxt, text_color = hiCol, text_size = size.tiny, bgcolor = cellBg)
        table.cell(st, 0, 9, "Sig MFE/MAE lo", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
        table.cell(st, 1, 9, loTxt, text_color = loCol, text_size = size.tiny, bgcolor = cellBg)

// =============================================================================
// ALERTS
// =============================================================================
// These read the same fireIs* flags the labels do, so the alert you receive
// always matches the label drawn on the chart for that bar.

// Retest alert: price returns to a recently broken level and holds it.
//
// A break that gets retested and holds is a higher-confidence event than the
// break itself, so these are worth more than the HH/LL/LH/HL alerts above.
var array<float> retestLevels = array.new_float(0)
var array<int>   retestBars   = array.new_int(0)
var array<bool>  retestIsHigh = array.new_bool(0)
var array<float> retestScores = array.new_float(0)
// Bar index of this level's most recent retest, or na if it has never fired.
// Replaces a one-shot boolean: a level that holds a SECOND retest is stronger
// evidence than one that held once, so permanently retiring it after the first
// discarded the better signal. A cooldown still prevents price sitting on a
// level from re-firing every bar.
var array<int>   retestLastBar = array.new_int(0)

if fireUp and not na(fireLevel)
    array.push(retestLevels, fireLevel)
    array.push(retestBars, bar_index)
    array.push(retestIsHigh, true)
    array.push(retestScores, fireScore)
    array.push(retestLastBar, na)
if fireDown and not na(fireLevel)
    array.push(retestLevels, fireLevel)
    array.push(retestBars, bar_index)
    array.push(retestIsHigh, false)
    array.push(retestScores, fireScore)
    array.push(retestLastBar, na)

// Drop levels older than the retest window. A `while` here, not an `if`: the
// original single shift per bar could not keep up with bursts of breaks, so the
// arrays grew without bound on long histories.
// Size check and the age check are split across `while`/`if` rather than joined
// with `and` on one line: Pine's `and` evaluates both sides unconditionally, so
// array.get(retestBars, 0) would still run (and error) on an empty array even
// with array.size(retestBars) > 0 false on the same line.
while array.size(retestBars) > 0
    if bar_index - array.get(retestBars, 0) > effRetestWindow
        array.shift(retestLevels)
        array.shift(retestBars)
        array.shift(retestIsHigh)
        array.shift(retestScores)
        array.shift(retestLastBar)
    else
        break

bool retestUp = false
bool retestDown = false
// The actual level being retested. Exposed because consumers need it: the
// backtest strategy places its stop relative to the level the trade is
// reacting to, and approximating that with "the most recent break level" is
// wrong whenever an older level in the window is the one price came back to.
float retestLevel = na
if barstate.isconfirmed and array.size(retestLevels) > 0
    for i = 0 to array.size(retestLevels) - 1
        int bBar  = array.get(retestBars, i)
        int lastAt = array.get(retestLastBar, i)
        // A level is eligible if it has never fired, or fired long enough ago
        // to count as a genuine second visit rather than the same one
        // continuing. With repeat retests off, one firing retires it for good.
        bool eligible = na(lastAt) or (retestRepeat and bar_index - lastAt >= effRetestCooldown)
        if eligible and bar_index - bBar > effRetestMinAge and bar_index - bBar < effRetestMaxAge
            float lvl  = array.get(retestLevels, i)
            bool  isHi = array.get(retestIsHigh, i)
            bool  scoreOk = not useScore or minScore == 0 or array.get(retestScores, i) >= minScore
            if scoreOk and atrVal > 0 and math.abs(close - lvl) < atrVal * retestBand
                if isHi and low <= lvl and close >= lvl
                    retestUp := true
                    retestLevel := lvl
                    array.set(retestLastBar, i, bar_index)
                if not isHi and high >= lvl and close <= lvl
                    retestDown := true
                    retestLevel := lvl
                    array.set(retestLastBar, i, bar_index)

// Retest events only fired an alert before — nothing was drawn on the chart
// itself. These triangles make the event visible without opening the alert
// log, colored to match the HH/LL/LH/HL palette (retestUp held support =
// HH/LL colour, retestDown held resistance = LH/HL colour).
// plotshape's `size` argument demands a CONST string, and retestMarkerSize is
// an input — so one call parameterised by it cannot compile, which is why this
// setting had never worked since it was added in v7.3. Pine's standard
// workaround is one call per constant, gated on the input. Six calls (three
// sizes x two sides) is the price of keeping the size adjustable at all;
// exactly one of each pair is ever live.
bool retestTiny   = retestMarkerSize == "Tiny"
bool retestNormal = retestMarkerSize == "Normal"
bool retestSmall  = not retestTiny and not retestNormal

plotshape(showRetestSupportMarker and retestUp and retestTiny, title = "Retest Support Marker (tiny)",
     location = location.belowbar, style = shape.triangleup, color = colCont, size = size.tiny)
plotshape(showRetestSupportMarker and retestUp and retestSmall, title = "Retest Support Marker (small)",
     location = location.belowbar, style = shape.triangleup, color = colCont, size = size.small)
plotshape(showRetestSupportMarker and retestUp and retestNormal, title = "Retest Support Marker (normal)",
     location = location.belowbar, style = shape.triangleup, color = colCont, size = size.normal)

plotshape(showRetestResistanceMarker and retestDown and retestTiny, title = "Retest Resistance Marker (tiny)",
     location = location.abovebar, style = shape.triangledown, color = colRev, size = size.tiny)
plotshape(showRetestResistanceMarker and retestDown and retestSmall, title = "Retest Resistance Marker (small)",
     location = location.abovebar, style = shape.triangledown, color = colRev, size = size.small)
plotshape(showRetestResistanceMarker and retestDown and retestNormal, title = "Retest Resistance Marker (normal)",
     location = location.abovebar, style = shape.triangledown, color = colRev, size = size.normal)


// =============================================================================
// MACHINE-READABLE OUTPUT
// =============================================================================
// The score is useless for calibration if the only way to collect it is
// reading numbers off the chart by hand — which is what the documented
// "run at minimum score 0 for two weeks and log every break" workflow
// amounted to, because nothing in this script was ever plotted.
//
// These series exist to get the data OUT. Two uses:
//
//   1. Chart menu -> "Export chart data..." writes a CSV with one row per bar
//      and these columns populated on break bars. Join that against your own
//      outcome column in a spreadsheet and the cutoff falls out of the data
//      instead of being guessed.
//
//   2. Alert messages can interpolate them via {{plot("Break score")}}, so a
//      notification or webhook carries the score without opening the chart.
//
// display.data_window keeps them off the chart and out of the price scale
// (they would wreck it — scores are 0-100, levels are prices) while still
// exporting and still being addressable from alerts.
//
// na on non-break bars rather than 0, so a spreadsheet filter on "score is not
// empty" gives exactly the break rows and nothing else.

bool anyBreak = fireUp or fireDown

plot(anyBreak ? fireScore : na, "Break score",
     display = display.data_window)

// 1 = HH, 2 = LL, 3 = LH, 4 = HL. Continuation is odd/even 1-2, reversal 3-4,
// so `type <= 2` filters continuations and `type >= 3` filters reversals.
plot(fireIsHH ? 1 : fireIsLL ? 2 : fireIsLH ? 3 : fireIsHL ? 4 : na, "Break type",
     display = display.data_window)

plot(anyBreak ? fireLevel : na, "Break level",
     display = display.data_window)

// Signed: positive for up breaks, negative for down, so direction survives the
// export without needing to cross-reference the type column.
plot(anyBreak ? (fireUp ? fireClearance : -fireClearance) : na, "Break clearance (ATR)",
     display = display.data_window)

// 1 = support retest, -1 = resistance retest.
plot(retestUp ? 1 : retestDown ? -1 : na, "Retest fired",
     display = display.data_window)

plot(retestUp or retestDown ? retestLevel : na, "Retest level",
     display = display.data_window)

// Context columns — constant per bar, but they make an exported CSV
// self-describing instead of needing a note about what the settings were.
plot(atrVal, "ATR", display = display.data_window)
plot(bias, "Bias", display = display.data_window)

// Forward-excursion samples, emitted when each break's measurement window
// elapses. One row per break: join score against MFE/MAE in a spreadsheet and
// the question "does the score rank breaks?" answers itself.
plot(outMFE,   "Fwd MFE (ATR)",   display = display.data_window)
plot(outMAE,   "Fwd MAE (ATR)",   display = display.data_window)
plot(outScore, "Fwd sample score", display = display.data_window)

// =============================================================================
// BACKTEST TRADE LOGIC
// =============================================================================
// Appended by tools/build_strategy.py. Everything above this line is the
// indicator source verbatim — this block is the only thing that differs, so
// the strategy can never drift from the signals it is supposed to be testing.
//
// The point of this file is NOT to assert a correct strategy. It is to make
// the score falsifiable: if tightening "Minimum score to signal" does not
// improve the results, the score is not measuring what it claims to. Every
// rule below is an input precisely so you can sweep them rather than trust
// one hardcoded set.
//
// ABOUT THE DEFAULTS: every trade-management feature is OFF. That is
// deliberate, and it is the result of an experiment that failed.
//
// Run 1 (stop-and-reverse bug, no management): 144 trades, 30.6% win rate,
//   profit factor 0.528, average win and average loss both 0.05%.
//
// Run 2 turned on breakeven at 1R, a 2 ATR trail, a 20-bar time exit and a
//   3/day cap, all at once: 56 trades, 16.1% win rate, profit factor 0.135,
//   average win 0.02% against average loss 0.04%. Gross PnL went from +$0.35
//   to -$38.
//
// The management made it dramatically WORSE. A 2 ATR trail exits on ordinary
// retracement at this timescale, and breakeven at 1R converts trades that were
// heading for 2R into scratches. Winners were halved; losers were barely
// improved; the payoff inverted from 1:1 to 1:2.
//
// The second mistake was changing five things simultaneously, which made it
// impossible to tell whether the one real bug fix (stop-and-reverse) helped at
// all. So the defaults are back to a MINIMAL, ISOLATED baseline: enter on
// signal, exit at stop or target, close on an opposite signal, nothing else.
// Add ONE feature at a time and record the result. That is the only way any of
// these numbers mean anything.
grpBT = "⑫ Backtest"

entryTrigger = input.string("Break", "Entry trigger", options = ["Break", "Retest"], group = grpBT,
     tooltip = "WHEN to enter.\n\nBREAK — enter the moment a break confirms.\n\nRETEST — wait for price to come back to the broken level and hold it. The documentation argues throughout that this is the higher-confidence entry; running both is how you find out whether that is true on your instrument.\n\nNote: retests do not carry a break type, so the Trade direction filter below cannot apply to them.")

tradeDirection = input.string("Both", "Trade direction", options = ["Both", "Continuation only", "Reversal only"], group = grpBT,
     tooltip = "Which break types to trade.\n\nCONTINUATION ONLY = HH and LL.\nREVERSAL ONLY = LH and HL.\n\nThe docs treat these as two different jobs. This tests whether they actually perform differently.\n\nIgnored when Entry trigger = Retest.")

stopMode = input.string("ATR multiple", "Stop placement", options = ["ATR multiple", "Beyond broken level"], group = grpBT,
     tooltip = "ATR MULTIPLE — a fixed volatility-scaled distance from entry. Simple and consistent.\n\nBEYOND BROKEN LEVEL — place the stop on the far side of the level that broke, plus a buffer. Structurally meaningful, but the distance varies per trade, which makes R-multiple comparisons noisier.")

stopATR = input.float(1.5, "  Stop distance (× ATR)", minval = 0.1, maxval = 20.0, step = 0.1, group = grpBT,
     tooltip = "Stop distance in ATR when using ATR multiple. Also the fallback when Beyond broken level has no level to work from.")

stopBuffer = input.float(0.25, "  Buffer beyond level (× ATR)", minval = 0.0, maxval = 5.0, step = 0.05, group = grpBT,
     tooltip = "Extra room past the broken level when using Beyond broken level, so a stop is not sitting exactly where everyone else's is.")

targetMode = input.string("R multiple", "Target", options = ["R multiple", "Opposite swing"], group = grpBT,
     tooltip = "R MULTIPLE — a fixed multiple of the stop distance. Keeps the risk/reward constant so results are comparable across settings.\n\nOPPOSITE SWING — target the current watched level on the other side, which is what the docs recommend reading off the table. Falls back to the R multiple when no opposite level exists yet.")

targetR = input.float(2.0, "  Target (R)", minval = 0.1, maxval = 20.0, step = 0.1, group = grpBT,
     tooltip = "Target as a multiple of the stop distance. 2.0 means risking 1 to make 2.")

beEnable = input.bool(false, "Move stop to breakeven", group = grpBT,
     tooltip = "Once a trade is up by the trigger below, pull the stop to entry (plus a small lock-in) so it can no longer become a full loser.\n\nThis is the highest-leverage change available to a losing strategy that is right often enough. It does not need better entries or a better signal — it only stops the trades that WERE working from giving it all back. The cost is being stopped out flat on trades that would have recovered, which is why the trigger matters.")

beTrigger = input.float(1.0, "  Arm after (R)", minval = 0.1, maxval = 10.0, step = 0.1, group = grpBT,
     tooltip = "How far in profit, in multiples of the initial risk, before the stop moves.\n\nLOWER (0.5) protects sooner but gets shaken out of trades that were fine.\nHIGHER (1.5+) gives the trade room but leaves more on the table when it turns.")

beOffset = input.float(0.1, "  Lock in (R)", minval = 0.0, maxval = 5.0, step = 0.05, group = grpBT,
     tooltip = "How much profit to lock when the breakeven stop arms. 0 = exactly breakeven; 0.1 covers commission and a tick of slippage so a 'breakeven' exit is not actually a small loss.")

trailEnable = input.bool(false, "Trail the stop", group = grpBT,
     tooltip = "Follow price with an ATR-distance stop instead of sitting at a fixed target.\n\nWorth trying when the fixed target is not being reached: it takes whatever the move gives rather than demanding a specific multiple. Combines with the target — whichever triggers first wins.")

trailATR = input.float(2.0, "  Trail distance (× ATR)", minval = 0.1, maxval = 20.0, step = 0.1, group = grpBT,
     tooltip = "How far behind price the trailing stop sits. Tighter locks in more but exits on noise; wider survives pullbacks but gives back more at the turn.")

maxBarsInTrade = input.int(0, "Max bars in trade (0 = off)", minval = 0, maxval = 500, group = grpBT,
     tooltip = "Close the position after this many bars regardless of stop or target.\n\nA trade that has not resolved in a reasonable time is usually not going to. Capital sitting in a stalled position also cannot take the next signal. Set this near your observed average hold to cut the tail of trades that go nowhere.")

maxEntriesPerDay = input.int(0, "Max entries per day (0 = off)", minval = 0, maxval = 50, group = grpBT,
     tooltip = "Hard cap on new positions per session.\n\nThe blunt instrument for a commission problem. If fees are eating the result, this caps the damage directly rather than hoping a quality filter reduces frequency enough. Try 2-4 when commission is a large share of net PnL.")

oppositeAction = input.string("Close only", "On an opposite signal", options = ["Close only", "Reverse", "Ignore"], group = grpBT,
     tooltip = "What to do when a break fires AGAINST an open position. This matters far more than it looks.\n\n" +
       "CLOSE ONLY (default) — flatten and wait for the next signal. The thesis is dead, but that does not automatically make the other side a trade.\n\n" +
       "REVERSE — flip straight into the opposite position. A legitimate style, but be aware of what it does to your statistics: the position is always in the market and flips on every opposite signal, so the target is almost never reached and the realised payoff collapses toward 1:1 no matter what you set Target (R) to. If you are comparing R multiples, this setting will hide the thing you are measuring.\n\n" +
       "IGNORE — hold to stop or target regardless. The cleanest setting for judging whether the R multiple you configured is actually achievable.\n\n" +
       "Until v7.9 this was effectively locked to REVERSE by accident: strategy.entry() in the opposite direction reverses an open position, so with Trade direction = Both every opposite break flipped the trade before the target could be hit.")

// --- Signal selection ---------------------------------------------------------
bool wantCont = tradeDirection != "Reversal only"
bool wantRev  = tradeDirection != "Continuation only"

bool longBreak  = (fireIsHH and wantCont) or (fireIsLH and wantRev)
bool shortBreak = (fireIsLL and wantCont) or (fireIsHL and wantRev)

bool goLong  = entryTrigger == "Break" ? longBreak  : retestUp
bool goShort = entryTrigger == "Break" ? shortBreak : retestDown

// The level this trade is reacting to, used for structural stop placement.
// On a break entry that is the level that broke; on a retest entry it is the
// level actually retested, which the indicator exposes directly rather than
// leaving us to guess. Approximating it with "the most recent break" would be
// wrong whenever an older level in the retest window is the one price returned
// to — which is exactly the case a structural stop most needs to get right.
var float tradeRefLevel = na
if (fireUp or fireDown) and not na(fireLevel)
    tradeRefLevel := fireLevel
if (retestUp or retestDown) and not na(retestLevel)
    tradeRefLevel := retestLevel

// --- Stop distance ------------------------------------------------------------
// Computed at entry and frozen, so the exit orders and the R multiple both
// reference the risk that was actually taken rather than a distance that keeps
// moving with ATR.
float atrStop = stopATR * atrVal

float structuralStop = na
if not na(tradeRefLevel) and atrVal > 0
    structuralStop := math.abs(close - tradeRefLevel) + stopBuffer * atrVal

float stopDistNow = stopMode == "Beyond broken level" and not na(structuralStop) ? structuralStop : atrStop
// Never allow a degenerate stop — a zero-distance stop fills instantly and
// produces meaningless statistics.
stopDistNow := math.max(nz(stopDistNow, atrStop), syminfo.mintick * 2)

var float entryStopDist = na

// --- Entries ------------------------------------------------------------------
// Only REVERSE mode may enter while a position is open. In the other two modes
// entries require a flat book, so strategy.entry() cannot silently reverse the
// trade -- which is what was collapsing the realised payoff to 1:1 regardless
// of the configured Target (R).
bool canEnterLong  = oppositeAction == "Reverse" ? strategy.position_size <= 0 : strategy.position_size == 0
bool canEnterShort = oppositeAction == "Reverse" ? strategy.position_size >= 0 : strategy.position_size == 0

// Daily entry cap. ta.change must run every bar, so the day boundary is
// computed unconditionally and only the counter reset is gated.
var int entriesToday = 0
bool newDay = ta.change(time("D")) != 0
if newDay
    entriesToday := 0
bool dayCapOk = maxEntriesPerDay == 0 or entriesToday < maxEntriesPerDay

// Bar the position was opened on, for the time-based exit.
var int entryBar = na
// Stop levels that ratchet during the trade. Reset on every new entry so a
// previous trade's breakeven or trail can never leak into the next one.
var float beStopPx    = na
var float trailStopPx = na

if goLong and canEnterLong and dayCapOk
    entryStopDist := stopDistNow
    entryBar      := bar_index
    beStopPx      := na
    trailStopPx   := na
    entriesToday  += 1
    strategy.entry("Long", strategy.long)

if goShort and canEnterShort and dayCapOk
    entryStopDist := stopDistNow
    entryBar      := bar_index
    beStopPx      := na
    trailStopPx   := na
    entriesToday  += 1
    strategy.entry("Short", strategy.short)

// --- Exits --------------------------------------------------------------------
// The stop is the maximum of three candidates: the initial risk stop, the
// breakeven stop once armed, and the trailing stop. Taking the max for longs
// (min for shorts) means the stop only ever ratchets in the trade's favour and
// can never loosen — which is the whole point of both mechanisms.
if strategy.position_size != 0 and not na(entryStopDist)
    float avg     = strategy.position_avg_price
    float rTarget = targetR * entryStopDist

    if strategy.position_size > 0
        // Arm breakeven once the trade has earned the trigger in open profit.
        if beEnable and high >= avg + beTrigger * entryStopDist
            beStopPx := math.max(nz(beStopPx, -1e10), avg + beOffset * entryStopDist)
        if trailEnable
            trailStopPx := math.max(nz(trailStopPx, -1e10), close - trailATR * atrVal)

        float stopPx = avg - entryStopDist
        stopPx := math.max(stopPx, nz(beStopPx, stopPx))
        stopPx := math.max(stopPx, nz(trailStopPx, stopPx))
        // Never place a stop above current price — it would fill instantly.
        stopPx := math.min(stopPx, close - syminfo.mintick)

        float tgtPx = targetMode == "Opposite swing" and not na(watchHigh) and watchHigh > avg ? watchHigh : avg + rTarget
        strategy.exit("Long exit", from_entry = "Long", stop = stopPx, limit = tgtPx)

    if strategy.position_size < 0
        if beEnable and low <= avg - beTrigger * entryStopDist
            beStopPx := math.min(nz(beStopPx, 1e10), avg - beOffset * entryStopDist)
        if trailEnable
            trailStopPx := math.min(nz(trailStopPx, 1e10), close + trailATR * atrVal)

        float stopPx = avg + entryStopDist
        stopPx := math.min(stopPx, nz(beStopPx, stopPx))
        stopPx := math.min(stopPx, nz(trailStopPx, stopPx))
        stopPx := math.max(stopPx, close + syminfo.mintick)

        float tgtPx = targetMode == "Opposite swing" and not na(watchLow) and watchLow < avg ? watchLow : avg - rTarget
        strategy.exit("Short exit", from_entry = "Short", stop = stopPx, limit = tgtPx)

// Time-based exit. A trade that has not resolved is usually not going to, and
// capital sitting in it cannot take the next signal.
if maxBarsInTrade > 0 and strategy.position_size != 0 and not na(entryBar) and bar_index - entryBar >= maxBarsInTrade
    strategy.close_all(comment = "Time exit")

// REVERSE is already handled by the entry block above -- adding a close here
// too would double-handle the same event. IGNORE deliberately does nothing.
if oppositeAction == "Close only"
    if strategy.position_size > 0 and (fireIsLL or fireIsHL)
        strategy.close("Long", comment = "Opposite signal")
    if strategy.position_size < 0 and (fireIsHH or fireIsLH)
        strategy.close("Short", comment = "Opposite signal")
