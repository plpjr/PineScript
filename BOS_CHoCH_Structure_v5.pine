// =============================================================================
// BOS / CHoCH Market Structure  —  v6.0
//
// NEW IN v6.0 — CONFLUENCE + HISTORICAL HIT-RATE:
//   * Every zone box (order block, FVG, liquidity pool, swing zone) now
//     carries a text label naming its type, instead of being an unlabelled
//     box.
//   * Confluence: whenever a swing zone is the nearest one above/below price,
//     it's checked against every active, same-directional-bias order block /
//     FVG / liquidity pool for price overlap. Each type that overlaps adds to
//     a confluence count shown right on the zone.
//   * Historical hit-rate: every order block, FVG, and liquidity pool is
//     tagged at birth with how many OTHER detector types already overlapped
//     it (0 / 1 / 2+). When it resolves — touched vs. expired untouched —
//     that outcome is filed into a running per-bucket tally. The nearest
//     swing zone then shows that bucket's hit rate with its sample size,
//     e.g. "Resistance · 2 conf · 74% (n=31)".
//   * This is an empirical frequency count from THIS chart's own history, not
//     a prediction model — shown with n= on purpose so a small sample reads
//     as noise, not signal.
//   * New "Resistance"/"Support" rows in the status table surface the same
//     numbers without needing to find the box on the chart.
//   * Toggle: "Show confluence + historical hit-rate" (⑪ Zones — shared
//     style) — OFF just labels each box with its type, no scoring layer.
//
// NEW IN v5.3 — TIMEFRAME ADAPTATION:
//   * "Auto-adapt to timeframe" (① Sensitivity presets) rescales every
//     extend-right and lookback window — BOS/CHoCH line length, all four zone
//     box widths, order-block search depth, liquidity pivot memory, retest
//     window — so each represents the SAME slice of real time on every chart,
//     instead of a fixed bar count that means 50 minutes on a 1-minute chart
//     and over a week on a 4-hour chart.
//   * Every scaled value is clamped to that setting's own manual min/max, so
//     auto-adapt can never reach a value you couldn't have picked by hand.
//   * Deliberately does NOT touch swing pivot length, filter thresholds, or
//     score weights — those stay under the Preset/Fine-tune dial, since what
//     COUNTS as a valid break is a different decision from how far to draw or
//     look back once one fires.
//
// NEW IN v5.2 — SMART MONEY ZONES:
//   * Swing zones: the live watched high/low is now a shaded wick-to-body box
//     instead of a thin line, so the exact area price must clear is obvious.
//   * Order blocks: the last opposite-coloured candle before a confirmed break,
//     drawn as a box. Grows while untested, fades on first touch, deletes once
//     price closes all the way through it (invalidated).
//   * Fair value gaps: classic 3-candle imbalances, ATR-filtered for size.
//     Fades on first partial fill, deletes once fully filled.
//   * Liquidity zones: equal highs/lows within an ATR tolerance, marking
//     resting buy-side/sell-side liquidity. Fades on a sweep (wick through),
//     deletes once a close confirms the level was actually consumed.
//   * All four share one box-history cap (Zones — shared style) so the chart
//     stays under TradingView's object limits automatically.
//
// NEW IN v5.1 — CONFIDENCE SCORING:
//   * Every break is graded 0-100 across five independent measures: clearance
//     beyond the level, displacement, body conviction, volume participation,
//     and the size of the leg broken. Shown on the label and in the table.
//   * Optional minimum-score gate, and optional fading of low-score breaks so
//     strong structure reads at a glance.
//   * Every component is user-adjustable: each measure has a weight and a
//     "full marks" threshold. Weights are auto-normalised to 100, so zeroing
//     one (e.g. volume on a synthetic feed) redistributes its share instead of
//     silently capping the score and shifting every threshold you had tuned.
//   * Why scoring rather than more filters: the existing filters are binary, so
//     a break clearing by 0.21 ATR and one clearing by 1.4 ATR both just read
//     "BOS". Tightening filters gives you FEWER signals; scoring tells you
//     which of them are actually good, and lets the chart show you where your
//     own cutoff should be.
//
//   Bugfixes in v5.1:
//   * Retest alerts no longer re-fire every bar while price sits on a level.
//   * Retest arrays no longer grow without bound (single shift per bar could
//     not keep up with bursts of breaks).
//   * Retest no longer stores an na level when a break fires without one.
//   * Divide-by-zero guard on clearance when confirmBars = 0, matching the
//     guard the other two call sites already had.
//
// IMPROVEMENTS OVER v4:
//   * Alerts: BOS/CHoCH up/down + retest alerts for TradingView notifications.
//   * Bugfix: lastBrokenHigh/Low now reset on opposite breaks — no more false
//     duplicate filtering across trend reversals.
//   * Bugfix: refHigh/refLow reset after breaks so ATR size filter works
//     correctly in new legs.
//   * Smart pending confirmation: opposite breaks cancel pending; upgrades to
//     more extreme levels replace stale pending breaks instead of waiting.
//   * Max history: auto-cleans old lines/labels so you never hit the 500 cap.
//   * Unconfirmed break preview: ghost markers when confirmBars > 0.
//   * Verbose labels: shows ATR clearance on each break.
//   * Configurable line extension: set how many bars BOS/CHoCH lines extend
//     right instead of running forever.
//   * Optional candle coloring by bias.
//   * Optional internal structure (faster swing length, thinner lines).
// =============================================================================
//@version=5
indicator("BOS / CHoCH Structure v6.0", overlay = true, max_bars_back = 100, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// =============================================================================
// SENSITIVITY MASTER CONTROLS
// =============================================================================
grpP = "① Sensitivity presets"

preset = input.string("Balanced", "Preset", group = grpP,
     options = ["Very Loose", "Loose", "Balanced", "Strict", "Very Strict", "Custom"],
     tooltip = "One control that sets every filter at once.\n\n" +
       "VERY LOOSE — catches almost every structure break. Many signals, many false ones. Use to see raw structure or on very slow instruments.\n\n" +
       "LOOSE — slightly filtered. Good for scalping lower timeframes where you accept noise for earlier entries.\n\n" +
       "BALANCED — sensible default for intraday futures on 5M–15M. Starting point for most people.\n\n" +
       "STRICT — only well-defined breaks with real displacement. Fewer signals, later, higher quality.\n\n" +
       "VERY STRICT — only major structure. Use on higher timeframes or when you only want A+ setups.\n\n" +
       "CUSTOM — ignores the preset and uses every manual value you set in the sections below.")

sensDial = input.int(5, "Fine tune (1 = strictest, 10 = loosest)", minval = 1, maxval = 10, group = grpP,
     tooltip = "Nudges the preset up or down without changing preset.\n\n" +
       "5 = the preset exactly as designed.\n" +
       "Above 5 = progressively looser (more signals, earlier, noisier).\n" +
       "Below 5 = progressively stricter (fewer signals, later, cleaner).\n\n" +
       "Ignored when Preset = Custom.\n\n" +
       "Practical use: if a preset is close but gives slightly too many signals on your instrument, drop this to 3–4 rather than switching preset entirely.")

useAutoTF = input.bool(true, "Auto-adapt to timeframe", group = grpP,
     tooltip = "Scales every 'extend right' and 'lookback' window (BOS/CHoCH line length, zone box width, order-block search depth, liquidity pivot memory, retest window) so it represents the SAME slice of real time on every chart, instead of a fixed bar count that means 50 minutes on a 1-minute chart and over a week on a 4-hour chart.\n\nEach scaled value is capped at whatever that setting's own manual maximum already is, so auto-adapt can never reach a value you couldn't have picked by hand.\n\nDoes NOT touch swing pivot length, filter thresholds, or score weights — those stay under the Preset/Fine-tune dial above, since changing what COUNTS as a valid break based on timeframe is a different decision from how far to draw or look back once one fires.\n\nOFF = every bar-count setting below means exactly what you typed, unscaled.")

// Preset base values ----------------------------------------------------------
int   pSwing    = preset == "Very Loose" ? 3   : preset == "Loose" ? 4    : preset == "Balanced" ? 5    : preset == "Strict" ? 7    : preset == "Very Strict" ? 10 : 5
float pAtrMult  = preset == "Very Loose" ? 0.0 : preset == "Loose" ? 0.25 : preset == "Balanced" ? 0.5  : preset == "Strict" ? 0.8  : preset == "Very Strict" ? 1.2  : 0.5
float pStrength = preset == "Very Loose" ? 0.0 : preset == "Loose" ? 0.05 : preset == "Balanced" ? 0.10 : preset == "Strict" ? 0.20 : preset == "Very Strict" ? 0.35 : 0.10
float pDisplace = preset == "Very Loose" ? 0.0 : preset == "Loose" ? 0.35 : preset == "Balanced" ? 0.60 : preset == "Strict" ? 0.90 : preset == "Very Strict" ? 1.30 : 0.60
float pEqualTol = preset == "Very Loose" ? 0.0 : preset == "Loose" ? 0.10 : preset == "Balanced" ? 0.15 : preset == "Strict" ? 0.25 : preset == "Very Strict" ? 0.35 : 0.15
int   pCooldown = preset == "Very Loose" ? 0   : preset == "Loose" ? 2    : preset == "Balanced" ? 3    : preset == "Strict" ? 5    : preset == "Very Strict" ? 8    : 3

// Dial scaling: 5 = neutral. Loosen (>5) shrinks thresholds, tighten (<5) grows them.
float dialScale = math.pow(0.82, sensDial - 5)   // >5 → <1 (looser), <5 → >1 (stricter)
float dialSwing = math.pow(0.90, sensDial - 5)

// =============================================================================
// CORE STRUCTURE SETTINGS
// =============================================================================
grpS = "② Core structure"

mSwingLen = input.int(5, "Swing pivot length", minval = 1, group = grpS,
     tooltip = "THE MOST IMPORTANT SETTING.\n\n" +
       "How many bars must sit on each side of a candle for it to count as a swing high/low.\n\n" +
       "LOWER (2–4) = detects small swings. More structure points, more signals, more noise. Also less confirmation lag.\n" +
       "HIGHER (7–12) = only major swings. Cleaner structure, far fewer signals, more lag.\n\n" +
       "This directly sets your confirmation delay: a swing cannot be confirmed until this many bars after it forms. At 5, labels appear ~5 bars late. That lag is unavoidable with pivot detection.\n\n" +
       "Only used when Preset = Custom.")

mAtrLen = input.int(14, "ATR length", minval = 1, group = grpS,
     tooltip = "Lookback for the ATR used by every size-based filter below.\n\n" +
       "SHORTER (7–10) = ATR reacts fast to volatility changes, so filters tighten and loosen quickly. Good for sessions with sharp volatility shifts.\n" +
       "LONGER (20–50) = smoother, more stable thresholds. Less reactive to a single volatile bar.\n\n" +
       "14 is standard and fine for most futures intraday work. This is used in all presets.")

mUseAtrFilter = input.bool(true, "Filter minor swings by size", group = grpS,
     tooltip = "Ignores swing points that are too small to be real structure.\n\n" +
       "ON = a pivot only counts if it moved far enough from the last opposite swing. Removes the tiny wiggles inside consolidation that would otherwise be labelled as structure.\n" +
       "OFF = every detected pivot counts, including micro-swings inside chop.\n\n" +
       "Recommend leaving ON. Turn off only if you want to see raw unfiltered pivot structure.")

mAtrMult = input.float(0.5, "  Min swing size (× ATR)", minval = 0.0, step = 0.05, group = grpS,
     tooltip = "How far a pivot must be from the previous opposite swing to count as structure, measured in ATR.\n\n" +
       "0.0–0.2 = almost nothing filtered. Very sensitive.\n" +
       "0.4–0.6 = balanced. Filters obvious chop, keeps real swings.\n" +
       "1.0+ = only large structural swings survive.\n\n" +
       "MOVE UP if consolidation is being labelled as structure.\n" +
       "MOVE DOWN if it's missing swings you'd clearly mark by hand.\n\n" +
       "Only used when Preset = Custom.")

// =============================================================================
// BREAK-QUALITY FILTERS
// =============================================================================
grpF = "③ Break quality filters"

mUseStrength = input.bool(true, "Require break strength", group = grpF,
     tooltip = "Requires price to close BEYOND the level by a meaningful amount, not just one tick past it.\n\n" +
       "ON = filters out marginal breaks that clear the level by a hair and immediately fail back inside. This is one of the highest-value filters.\n" +
       "OFF = any close past the level counts, even by a single tick.\n\n" +
       "Strongly recommend ON.")

mStrength = input.float(0.10, "  Min clearance beyond level (× ATR)", minval = 0.0, step = 0.05, group = grpF,
     tooltip = "How far past the level the close must be, in ATR.\n\n" +
       "0.05 = barely filtered, catches nearly everything.\n" +
       "0.10–0.20 = balanced. Removes tick-through fakeouts.\n" +
       "0.30+ = only decisive breaks. Notably fewer signals and later entries.\n\n" +
       "TRADEOFF: raising this improves quality but you enter later and miss breaks that were real but shallow.\n\n" +
       "Only used when Preset = Custom.")

mUseDisplace = input.bool(true, "Require displacement candle", group = grpF,
     tooltip = "Requires the candle that breaks the level to have real size relative to recent volatility.\n\n" +
       "ON = a break on a tiny indecision candle is rejected. Genuine institutional breaks usually come with expansion.\n" +
       "OFF = any candle can break structure, including dojis.\n\n" +
       "Recommend ON. This is the second-highest-value filter after break strength.")

mDisplace = input.float(0.6, "  Min candle range (× ATR)", minval = 0.0, step = 0.1, group = grpF,
     tooltip = "How large the breaking candle's full range must be, in ATR.\n\n" +
       "0.3 = permissive, most candles qualify.\n" +
       "0.6–0.8 = balanced. Requires visible expansion.\n" +
       "1.2+ = only strong impulsive candles qualify. Few signals.\n\n" +
       "MOVE UP if you're seeing weak breaks that stall immediately.\n" +
       "MOVE DOWN if real breaks are being skipped in low-volatility sessions.\n\n" +
       "Only used when Preset = Custom.")

mUseBodyRatio = input.bool(false, "  Also require body > 50% of range", group = grpF,
     tooltip = "Adds a conviction test on top of the range test.\n\n" +
       "ON = the candle body must be more than half its total range, so a long-wicked rejection candle won't count as a break even if its range is large.\n" +
       "OFF = only total range matters.\n\n" +
       "Turn ON if you're getting breaks on candles that spiked through and closed back near their open.")

mUseWickReject = input.bool(false, "Reject long-wick breaks", group = grpF,
     tooltip = "Rejects breaks where the candle left a large wick BEYOND the level, which suggests the move was rejected rather than accepted.\n\n" +
       "ON = if the wick past the level is bigger than the body past the level, the break is skipped. Useful for filtering liquidity sweeps that get labelled as breaks.\n" +
       "OFF = wick shape is ignored.\n\n" +
       "TRADEOFF: this can filter out genuine sweep-then-reverse setups that you may actually want to trade. Turn on only if wick-fakeouts are your main problem.")

mUseVolume = input.bool(false, "Require volume expansion", group = grpF,
     tooltip = "Requires the breaking candle to trade above its recent average volume.\n\n" +
       "ON = breaks on thin volume are rejected. Real structure breaks usually come with participation.\n" +
       "OFF = volume ignored.\n\n" +
       "IMPORTANT: only meaningful on instruments with reliable volume data. On futures this generally works well; on some CFDs and forex feeds volume is synthetic and this filter will behave unpredictably. Verify your feed before trusting it.")

mVolMult = input.float(1.2, "  Min volume (× average)", minval = 0.1, step = 0.1, group = grpF,
     tooltip = "How much above average volume the breaking candle must be.\n\n" +
       "1.0 = merely average volume.\n" +
       "1.2–1.5 = clear expansion. Balanced.\n" +
       "2.0+ = only high-participation breaks. Very restrictive.\n\n" +
       "Only applies when 'Require volume expansion' is ON.")

mVolLen = input.int(20, "  Volume average length", minval = 1, group = grpF,
     tooltip = "Lookback for the average volume comparison.\n\n" +
       "SHORTER (10) = compares against very recent activity, adapts quickly within a session.\n" +
       "LONGER (50) = compares against a broader baseline, less affected by a single busy period.\n\n" +
       "20 is a reasonable default for intraday.")

mUseEqualTol = input.bool(true, "Merge near-equal levels", group = grpF,
     tooltip = "Treats levels that sit within a small band of each other as the SAME level.\n\n" +
       "ON = prevents the indicator printing two labels for what is really one double top or double bottom.\n" +
       "OFF = each pivot is treated as a distinct level even if they're nearly identical.\n\n" +
       "Recommend ON. Equal highs/lows are common and double-labelling them clutters the chart.")

mEqualTol = input.float(0.15, "  Equal-level tolerance (× ATR)", minval = 0.0, step = 0.05, group = grpF,
     tooltip = "How close two levels must be to be considered the same level, in ATR.\n\n" +
       "0.05 = only near-identical prices merge.\n" +
       "0.15 = balanced.\n" +
       "0.30+ = aggressively merges nearby levels, which can suppress genuine separate breaks.\n\n" +
       "Only used when Preset = Custom.")

mCooldown = input.int(3, "Min bars between breaks", minval = 0, group = grpF,
     tooltip = "Forces a gap between labelled breaks.\n\n" +
       "0 = no cooldown, breaks can print on consecutive bars.\n" +
       "3–5 = balanced. Stops rapid-fire labelling during chop.\n" +
       "8+ = heavily throttled, only well-separated structure shifts appear.\n\n" +
       "TRADEOFF: a high cooldown can suppress a genuine fast reversal that legitimately breaks structure twice in quick succession.\n\n" +
       "Only used when Preset = Custom.")

mConfirmBars = input.int(0, "Confirmation bars after break", minval = 0, maxval = 5, group = grpF,
     tooltip = "Waits N bars after a break and only labels it if price is STILL beyond the level.\n\n" +
       "0 = label immediately on the breaking candle's close.\n" +
       "1–2 = waits for follow-through. Cuts fakeouts noticeably.\n" +
       "3–5 = very conservative, but the label arrives well after the move started.\n\n" +
       "TRADEOFF: this is the most direct quality-vs-lag dial in the indicator. Every bar you add here is a bar of entry you give up. Use it if fakeouts cost you more than late entries do.")

mStrictBreak = input.bool(false, "Strict: full body beyond level", group = grpF,
     tooltip = "Requires BOTH the open and the close to be beyond the level, not just the close.\n\n" +
       "ON = the entire candle body must clear the level. Very restrictive, meaningfully later.\n" +
       "OFF = a close beyond the level is enough (standard).\n\n" +
       "Most people should leave this OFF and use break strength instead, which achieves a similar goal with less lag.")

// =============================================================================
// CONTEXT FILTERS
// =============================================================================
grpX = "④ Context filters"

mUseTrendFilter = input.bool(false, "Only signal with EMA trend", group = grpX,
     tooltip = "Suppresses breaks that go against a longer-term EMA.\n\n" +
       "ON = bullish breaks only print when price is above the EMA, bearish breaks only when below. Aligns signals with the prevailing trend.\n" +
       "OFF = all breaks print regardless of trend context.\n\n" +
       "IMPORTANT TRADEOFF: this will suppress the very first CHoCH of a genuine reversal, because that's precisely the signal that fires against the trend. If you trade reversals, leave this OFF.")

mTrendLen = input.int(50, "  EMA length", minval = 1, group = grpX,
     tooltip = "Length of the trend EMA used by the filter above.\n\n" +
       "SHORTER (20) = follows price closely, filter flips often.\n" +
       "LONGER (100–200) = defines a slower, more structural trend.\n\n" +
       "Only applies when 'Only signal with EMA trend' is ON.")

mUseSession = input.bool(false, "Restrict to a session", group = grpX,
     tooltip = "Only detects structure breaks inside a chosen time window.\n\n" +
       "ON = ignores overnight and low-liquidity chop, which produces a lot of low-quality structure.\n" +
       "OFF = analyses all bars.\n\n" +
       "Useful if you trade a specific window, since breaks outside your session aren't actionable anyway.")

mSession = input.session("0930-1600", "  Session window", group = grpX,
     tooltip = "The time window to analyse, in exchange time.\n\n" +
       "Examples:\n" +
       "0930-1600 = US regular cash session\n" +
       "0830-1130 = US morning only\n" +
       "0200-0500 = London session\n\n" +
       "Set your chart timezone correctly or this window won't land where you expect.")

// =============================================================================
// DISPLAY & HISTORY SETTINGS
// =============================================================================
grpD = "⑤ Display & history"

showLabels = input.bool(true, "BOS / CHoCH labels", group = grpD,
     tooltip = "Text labels on each break. Turn off for a cleaner chart if the coloured lines are enough.")
labelSize  = input.string("Small", "Label size", options = ["Tiny", "Small", "Normal"], group = grpD,
     tooltip = "Text size for break labels. Use Tiny on dense lower-timeframe charts.")
verboseLabels = input.bool(false, "Verbose labels (show ATR clearance)", group = grpD,
     tooltip = "ON = labels show 'BOS +0.3' or 'CHoCH -0.2' indicating how many ATR the break cleared beyond the level. Useful for quickly judging break quality.")
showLiveLv = input.bool(true, "Live (unbroken) levels", group = grpD,
     tooltip = "Dotted lines showing the levels price is CURRENTLY working against, before any break.\n\nThis is the most useful setting for live trading: it shows what needs to break for a signal to fire, so you can plan the trade before the label appears.")
showPivots = input.bool(false, "Raw pivot markers", group = grpD,
     tooltip = "Small triangles on every detected swing high/low, including ones the filters rejected.\n\nUseful for DIAGNOSIS: if the indicator is missing structure you'd mark by hand, turn this on to see whether the pivot was detected but filtered out, or never detected at all.")
tintBias   = input.bool(false, "Tint background by bias", group = grpD,
     tooltip = "Colours the chart background by current structure bias. Some find it useful for at-a-glance context, others find it distracting.")
colorCandles = input.bool(false, "Color candles by bias", group = grpD,
     tooltip = "Colours OHLC candles based on current structure bias. Bullish = BOS colour, Bearish = CHoCH colour, Neutral = default. Independent of background tint.")
showTable  = input.bool(true, "Status table", group = grpD,
     tooltip = "Corner panel showing current bias, the exact watched levels, bars since the last break, ATR, and active preset.\n\nThe numeric levels are the useful part: copy them straight into your trade journal rather than reading them off the chart.")
maxHistory = input.int(50, "Max breaks to draw (0 = unlimited)", minval = 0, maxval = 200, group = grpD,
     tooltip = "Limits how many historical BOS/CHoCH lines and labels remain on chart. Oldest auto-delete when exceeded.\n\n0 = no limit (may hit TradingView's 500 cap on busy charts).\n50 = keeps chart clean on intraday timeframes.\n\nLive levels and pivot markers are not counted.")

showUnconfirmed = input.bool(true, "Show unconfirmed break preview", group = grpD,
     tooltip = "When Confirmation Bars > 0, draws a faint ghost marker at the break level while waiting for confirmation. Lets you see the break forming in real time rather than waiting blindly.")

// =============================================================================
// INTERNAL STRUCTURE (Optional)
// =============================================================================
grpI = "⑥ Internal structure (optional)"

useInternal = input.bool(false, "Show internal structure", group = grpI,
     tooltip = "Tracks a second, faster swing length for minor structure inside the current leg.\n\nInternal BOS = minor break WITH trend.\nInternal CHoCH = minor break AGAINST trend (early reversal warning).\n\nDrawn with thinner, semi-transparent lines. Useful for entry timing within a higher-timeframe bias.")
intSwingLen = input.int(3, "Internal swing length", minval = 1, group = grpI,
     tooltip = "Must be smaller than main Swing Pivot Length. 2–3 is typical.")
intLineWidth = input.int(1, "Internal line width", minval = 1, maxval = 3, group = grpI)
intTransparency = input.int(65, "Internal line transparency", minval = 0, maxval = 90, group = grpI)

// =============================================================================
// LINE / VISUAL SETTINGS
// =============================================================================
grpB = "⑦ BOS lines"
colBOS       = input.color(#38BDF8, "BOS colour", group = grpB,
     tooltip = "Colour for Break of Structure lines and labels. BOS = a break WITH the existing trend, confirming continuation.")
bosLineStyle = input.string("Solid", "BOS line style", options = ["Solid", "Dashed", "Dotted"], group = grpB,
     tooltip = "Line style for BOS levels. Solid reads as more definitive, which suits continuation signals.")
bosLineWidth = input.int(2, "BOS line width", minval = 1, maxval = 4, group = grpB,
     tooltip = "Thickness of BOS lines. Raise if you're on a large monitor or find them hard to see.")
bosExtendBars = input.int(0, "Extend BOS lines right (bars)", minval = 0, maxval = 500, group = grpB,
     tooltip = "How many bars to draw the BOS line forward from the break bar.\n\n0 = line stops at the break bar (cleanest).\n20 = extends 20 bars forward.\n100 = extends 100 bars forward.\n\nUnlike 'extend.right' which runs forever, this keeps your chart clean on the right edge while still showing relevant levels ahead.")
bosVertical  = input.bool(false, "Vertical marker on BOS bar", group = grpB,
     tooltip = "Draws a small vertical tick on the exact bar where the BOS was confirmed, making the timing unambiguous.")
showBOSLines = input.bool(true, "Draw BOS lines", group = grpB,
     tooltip = "Master switch for all BOS line drawing. Turn off if you only care about CHoCH reversals.")

grpC = "⑧ CHoCH lines"
colCHoCH       = input.color(#FB923C, "CHoCH colour", group = grpC,
     tooltip = "Colour for Change of Character lines and labels. CHoCH = a break AGAINST the existing trend, signalling a possible reversal.")
chochLineStyle = input.string("Dashed", "CHoCH line style", options = ["Solid", "Dashed", "Dotted"], group = grpC,
     tooltip = "Line style for CHoCH levels. Dashed distinguishes them from BOS at a glance.")
chochLineWidth = input.int(2, "CHoCH line width", minval = 1, maxval = 4, group = grpC,
     tooltip = "Thickness of CHoCH lines.")
chochExtendBars = input.int(50, "Extend CHoCH lines right (bars)", minval = 0, maxval = 500, group = grpC,
     tooltip = "How many bars to draw the CHoCH line forward from the break bar.\n\n0 = line stops at the break bar.\n50 = extends 50 bars forward (default — enough to see retests without clutter).\n200 = extends 200 bars.\n\nCHoCH levels often act as support/resistance, so some extension is useful. But 'forever' clutters the chart. Adjust to your timeframe: lower on 1M, higher on 1H+.")
chochVertical  = input.bool(true, "Vertical marker on CHoCH bar", group = grpC,
     tooltip = "ON (default) = marks the exact CHoCH bar. CHoCH signals are the easiest to misread in real time, so the precise bar is worth showing.")
showCHoCHLines = input.bool(true, "Draw CHoCH lines", group = grpC,
     tooltip = "Master switch for all CHoCH line drawing.")

// =============================================================================
// CONFIDENCE SCORE
// =============================================================================
grpQ = "⑨ Confidence score"

useScore = input.bool(true, "Score every break 0-100", group = grpQ,
     tooltip = "Grades each break on HOW WELL it passed, instead of a simple pass/fail.\n\n" +
       "The filters above are binary: a break either qualifies or it doesn't. A break that cleared the level by 0.21 ATR and one that cleared it by 1.4 ATR both just say 'BOS'. This scores them, so you can tell a marginal signal from an emphatic one.\n\n" +
       "Score is built from five independent measures:\n" +
       "  Clearance beyond the level   0-30\n" +
       "  Displacement of the candle   0-25\n" +
       "  Body conviction              0-15\n" +
       "  Volume participation         0-15\n" +
       "  Size of the leg broken       0-15\n\n" +
       "Rough reading: 75+ is emphatic, 55-75 is solid, below 40 is marginal.")

minScore = input.int(0, "  Minimum score to signal", minval = 0, maxval = 100, group = grpQ,
     tooltip = "Breaks scoring below this are not labelled at all.\n\n" +
       "0 = label everything, score is display-only. START HERE.\n\n" +
       "RECOMMENDED WORKFLOW: run at 0 for a week with scores shown. Watch which scores actually worked on your instrument. THEN set this to the number you observed, rather than guessing.\n\n" +
       "Setting this blind is just a slower way of tightening the filters above. The point of the score is to let the chart tell you where your cutoff is.")

showScore = input.bool(true, "  Show score on label", group = grpQ,
     tooltip = "Appends the score to each label, e.g. 'BOS 82'. Turn off for a cleaner chart once you've settled on a minimum score.")

scoreColors = input.bool(true, "  Fade low-score breaks", group = grpQ,
     tooltip = "Draws low-scoring breaks more transparently, so high-confidence structure stands out at a glance without reading numbers.\n\nA 90-score break is drawn solid; a 40-score break is drawn faint.")

// =============================================================================
// SCORE TUNING (advanced)
// =============================================================================
grpQ2 = "⑩ Score tuning (advanced)"

// --- How much each measure is worth -------------------------------------------
// Weights are NORMALISED to total 100, so you set them in relative terms and
// never have to make them add up yourself. Zeroing one redistributes its share
// across the rest, which keeps scores comparable across different weightings.
wClear = input.int(30, "Weight · clearance beyond level", minval = 0, maxval = 100, group = grpQ2,
     tooltip = "How much the score cares that price closed WELL past the level rather than barely past it.\n\n" +
       "This is the single most reliable indicator of a real break, which is why it carries the most weight by default.\n\n" +
       "Weights are relative and auto-normalised to 100 — you do not need to make them add up.")

wDisp = input.int(25, "Weight · displacement", minval = 0, maxval = 100, group = grpQ2,
     tooltip = "How much the score cares that the breaking candle was LARGE relative to recent volatility.\n\nRaise if your instrument breaks with obvious expansion. Lower on instruments that grind rather than impulse.")

wBody = input.int(15, "Weight · body conviction", minval = 0, maxval = 100, group = grpQ2,
     tooltip = "How much the score cares that the candle CLOSED near its extreme rather than leaving a long rejection wick.\n\nRaise if wick-fakeouts are your main problem — this penalises them without rejecting them outright, unlike the wick filter.")

wVol = input.int(15, "Weight · volume participation", minval = 0, maxval = 100, group = grpQ2,
     tooltip = "How much the score cares about volume expansion on the breaking candle.\n\n" +
       "SET THIS TO 0 if your feed has synthetic or unreliable volume (many forex and CFD feeds). Its share is redistributed to the other measures, so you lose nothing.\n\n" +
       "On futures, volume is real and worth keeping.")

wLeg = input.int(15, "Weight · size of leg broken", minval = 0, maxval = 100, group = grpQ2,
     tooltip = "How much the score cares that the swing being broken was a LARGE, well-formed leg rather than a shallow one.\n\nThis is the only component that looks at structural context rather than the breaking candle itself.")

// --- Where each measure earns full marks ---------------------------------------
tClear = input.float(0.40, "Full marks · clearance (× ATR)", minval = 0.05, step = 0.05, group = grpQ2,
     tooltip = "Clearance beyond the level that earns the FULL clearance score.\n\n" +
       "LOWER (0.25) = easier to max out, scores cluster high, less discrimination between good and great.\n" +
       "HIGHER (0.60) = only emphatic breaks score well.\n\n" +
       "If almost every break scores 85+, your thresholds are too easy — raise this and 'displacement' first.")

tDisp = input.float(1.20, "Full marks · candle range (× ATR)", minval = 0.10, step = 0.10, group = grpQ2,
     tooltip = "Breaking-candle range that earns the FULL displacement score, in ATR.")

tBody = input.float(0.80, "Full marks · body % of range", minval = 0.40, maxval = 1.00, step = 0.05, group = grpQ2,
     tooltip = "Body-to-range ratio that earns the FULL conviction score.\n\n0.80 = body is 80% of the candle's range. Scoring starts from 0.35 and rises to this value.")

tVol = input.float(1.60, "Full marks · volume (× average)", minval = 0.20, step = 0.10, group = grpQ2,
     tooltip = "Volume multiple that earns the FULL participation score.\n\nScoring starts from 0.70× average and rises to this value. Ignored when the volume weight is 0.")

tLeg = input.float(2.00, "Full marks · leg size (× ATR)", minval = 0.10, step = 0.10, group = grpQ2,
     tooltip = "Size of the broken leg, in ATR, that earns the FULL structural score.\n\nRaise on higher timeframes where legs are naturally larger.")

// =============================================================================
// ZONES — SHARED STYLE
// =============================================================================
grpZ = "⑪ Zones — shared style"

zoneBullColor = input.color(#22C55E, "Bullish zone colour", group = grpZ,
     tooltip = "Base colour for every zone that favours longs: swing low zones, bullish order blocks, bullish FVGs, and sell-side liquidity pools.")

zoneBearColor = input.color(#EF4444, "Bearish zone colour", group = grpZ,
     tooltip = "Base colour for every zone that favours shorts: swing high zones, bearish order blocks, bearish FVGs, and buy-side liquidity pools.")

zoneOpacity = input.int(82, "Active zone opacity", minval = 0, maxval = 95, group = grpZ,
     tooltip = "Fill/border transparency for a live, untested zone. Higher = more see-through.\n\nLower this if zones feel too faint against your chart background.")

zoneFadeExtra = input.int(12, "Extra fade once tested/mitigated", minval = 0, maxval = 40, group = grpZ,
     tooltip = "Added transparency once a zone has been touched or filled, so used zones visually recede and only live, untouched zones jump out at you.")

zoneMaxPerType = input.int(20, "Max active zones per type", minval = 1, maxval = 100, group = grpZ,
     tooltip = "Oldest zone of each type (order block / FVG / liquidity pool) auto-deletes once this many are on the chart. Keeps you under TradingView's object caps and the chart readable.")

useConfluence = input.bool(true, "Show confluence + historical hit-rate", group = grpZ,
     tooltip = "Checks whether an order block, FVG, and/or liquidity pool overlap the nearest swing zone, and remembers — from THIS chart's own history — how often zones with that much agreement actually got touched before failing.\n\nShown on the swing zone label ('Resistance · 2 confluence') and as two extra status-table rows (nearest Resistance/Support, with a hit-rate % and its sample size).\n\nThis is an empirical frequency count, not a prediction model — treat any hit-rate with a small sample size (n) as noise, same as the confidence-score minimum-score advice.\n\nOFF = zone boxes still draw and label their own type, just without the confluence/hit-rate layer.")

// =============================================================================
// SWING ZONES
// =============================================================================
grpZS = "⑫ Swing zones"

showSwingZones = input.bool(true, "Shade swing high/low zones", group = grpZS,
     tooltip = "Draws the CURRENT watched swing high and swing low as a shaded box instead of just a thin line — the exact area price needs to break for a signal to fire, made impossible to miss.\n\nThe box spans wick-to-body of the pivot candle: the wick is the exact extreme, the body edge is where real conviction started, so the zone reflects the whole area price likely reacts from, not just one tick.")

swingZoneExtend = input.int(20, "  Extend zone right (bars)", minval = 0, maxval = 200, group = grpZS,
     tooltip = "How far the swing zone box is drawn forward from the current bar. Purely visual — does not affect detection.")

// =============================================================================
// ORDER BLOCKS
// =============================================================================
grpZO = "⑬ Order blocks"

useOB = input.bool(true, "Show order blocks", group = grpZO,
     tooltip = "An order block is the LAST opposite-coloured candle before an impulsive break of structure — the candle where the move likely originated. Traders watch these as high-probability entry zones on a retest.\n\nBullish OB = last down-close candle before a break up. Bearish OB = last up-close candle before a break down.\n\nLifecycle: the box grows while untested, fades the first time price wicks back into it, and deletes once price CLOSES all the way through the far side (invalidated).")

obLookback = input.int(15, "  Search back this many bars", minval = 1, maxval = 50, group = grpZO,
     tooltip = "How far back from the break candle to search for the origin candle. Raise on higher timeframes where the origin candle can sit further back; lower to keep only very tight, recent origins.")

obExtendBars = input.int(30, "  Extend box right (bars)", minval = 0, maxval = 300, group = grpZO,
     tooltip = "How far an ACTIVE (untested) order block box is drawn forward while price hasn't returned to it yet.")

// =============================================================================
// FAIR VALUE GAPS
// =============================================================================
grpZF = "⑭ Fair value gaps"

useFVG = input.bool(true, "Show fair value gaps", group = grpZF,
     tooltip = "A fair value gap (FVG) is a 3-candle imbalance: the wick of candle 1 doesn't overlap the wick of candle 3, leaving a gap the market moved through without trading. Price often returns to 'fill' this gap before continuing.\n\nBullish FVG = gap left behind an up move (support-ish). Bearish FVG = gap left behind a down move (resistance-ish).\n\nLifecycle: fades the first time price wicks back into the gap, deletes once price CLOSES all the way through it (fully filled).")

fvgMinSize = input.float(0.05, "  Min gap size (× ATR)", minval = 0.0, step = 0.05, group = grpZF,
     tooltip = "Filters out tiny, insignificant gaps.\n\n0.0 = show every gap, even one tick wide.\n0.05-0.15 = balanced, hides noise on choppy instruments.\n0.3+ = only large, obvious imbalances.")

fvgExtendBars = input.int(30, "  Extend box right (bars)", minval = 0, maxval = 300, group = grpZF,
     tooltip = "How far an unfilled FVG box is drawn forward while price hasn't returned to fill it.")

fvgShowMidline = input.bool(false, "  Show 50% midline (CE)", group = grpZF,
     tooltip = "Draws a thin dotted line through the middle of the gap — the 'consequent encroachment' level some traders treat as the real reaction point rather than the whole gap.")

// =============================================================================
// LIQUIDITY ZONES
// =============================================================================
grpZL = "⑮ Liquidity zones"

useLiquidity = input.bool(true, "Show liquidity zones", group = grpZL,
     tooltip = "Marks equal (or near-equal) highs and lows as resting liquidity pools — clusters of stop-losses and breakout orders that price is statistically drawn toward before reversing.\n\nBuy-side liquidity = equal highs (above price). Sell-side liquidity = equal lows (below price).\n\nLifecycle: fades the moment price wicks through (a sweep attempt), deletes once a CLOSE confirms the level is consumed.")

liqTol = input.float(0.12, "  Equal-level tolerance (× ATR)", minval = 0.01, step = 0.01, group = grpZL,
     tooltip = "How close two swing points must be, in ATR, to count as 'equal' and form a pool.\n\nSmaller = only near-identical levels cluster. Larger = merges more distant swings into one pool, which can overstate how 'equal' they really were.")

liqLookback = input.int(150, "  Pivot lookback (bars)", minval = 20, maxval = 500, group = grpZL,
     tooltip = "How far back to look for a matching prior pivot when deciding whether a new pivot forms a liquidity pool. Longer = catches older equal highs/lows; shorter = only recent, more relevant pools.")

liqExtendBars = input.int(40, "  Extend zone right (bars)", minval = 0, maxval = 300, group = grpZL,
     tooltip = "How far an unswept liquidity zone is drawn forward.")

// Normalise the weights so the score always lands on a 0-100 scale regardless of
// what the user typed. Without this, zeroing volume would silently cap the score
// at 85 and every threshold you had tuned would shift under you.
float wSum  = wClear + wDisp + wBody + wVol + wLeg
float wNorm = wSum > 0 ? 100.0 / wSum : 0.0

lblSize = labelSize == "Tiny" ? size.tiny : labelSize == "Normal" ? size.normal : size.small
styleOf(s) => s == "Solid" ? line.style_solid : s == "Dashed" ? line.style_dashed : line.style_dotted

// =============================================================================
// RESOLVE EFFECTIVE VALUES (preset vs custom)
// =============================================================================
bool isCustom = preset == "Custom"

int   swingLen     = isCustom ? mSwingLen : math.max(1, int(math.round(pSwing * dialSwing)))
int   atrLen       = mAtrLen
bool  useAtrFilter = isCustom ? mUseAtrFilter : pAtrMult > 0
float atrMult      = isCustom ? mAtrMult : pAtrMult * dialScale

bool  useStrength  = isCustom ? mUseStrength : pStrength > 0
float strengthMult = isCustom ? mStrength : pStrength * dialScale

bool  useDisplace  = isCustom ? mUseDisplace : pDisplace > 0
float displaceMult = isCustom ? mDisplace : pDisplace * dialScale
bool  useBodyRatio = mUseBodyRatio

bool  useEqualTol  = isCustom ? mUseEqualTol : pEqualTol > 0
float equalTolMult = isCustom ? mEqualTol : pEqualTol * dialScale

int   cooldownBars = isCustom ? mCooldown : int(math.round(pCooldown * dialScale))

bool  strictBreak  = mStrictBreak
int   confirmBars  = mConfirmBars

// =============================================================================
// TIMEFRAME ADAPTATION
// =============================================================================
// tfScale is the current chart's minutes-per-bar relative to the 15-minute
// baseline every default bar-count below was designed around (the same
// baseline the Balanced preset targets). Falls back to neutral (1.0) on
// non-time-based charts (Renko/Range/Tick) where in_seconds() isn't meaningful.
float tfSeconds = timeframe.in_seconds(timeframe.period)
float tfScale   = tfSeconds > 0 ? (tfSeconds / 60.0) / 15.0 : 1.0

// Rescales a bar count authored against the 15-minute baseline so it spans
// the same real time on the current chart. Clamped to [minBars, maxBars] —
// the same range the underlying input already allows — so auto-adapt can
// never land outside a value you could have picked manually.
scaleBars(int bars, int minBars, int maxBars) =>
    useAutoTF ? int(math.max(minBars, math.min(maxBars, math.round(bars / tfScale)))) : bars

int effBosExtend    = scaleBars(bosExtendBars, 0, 500)
int effChochExtend  = scaleBars(chochExtendBars, 0, 500)
int effSwingExtend  = scaleBars(swingZoneExtend, 0, 200)
int effObLookback   = scaleBars(obLookback, 1, 50)
int effObExtend     = scaleBars(obExtendBars, 0, 300)
int effFvgExtend    = scaleBars(fvgExtendBars, 0, 300)
int effLiqLookback  = scaleBars(liqLookback, 20, 500)
int effLiqExtend    = scaleBars(liqExtendBars, 0, 300)
int effIntExtend    = scaleBars(30, 3, 300)
int effRetestWindow = scaleBars(100, 10, 500)
int effRetestMinAge = scaleBars(3, 1, 20)
int effRetestMaxAge = scaleBars(50, 5, 200)

// =============================================================================
// CORE CALCULATIONS
// =============================================================================
atrVal = ta.atr(atrLen)
emaVal = ta.ema(close, mTrendLen)
volAvg = ta.sma(volume, mVolLen)

bool inSession = not mUseSession or not na(time(timeframe.period, mSession))

float ph = ta.pivothigh(high, swingLen, swingLen)
float pl = ta.pivotlow(low, swingLen, swingLen)

// Internal structure pivots
float iPh = useInternal ? ta.pivothigh(high, intSwingLen, intSwingLen) : na
float iPl = useInternal ? ta.pivotlow(low, intSwingLen, intSwingLen) : na

var float watchHigh    = na
var int   watchHighBar = na
var float watchLow     = na
var int   watchLowBar  = na
var float watchHighBody = na   // body edge of the swing-high pivot candle (for the swing zone box)
var float watchLowBody  = na   // body edge of the swing-low pivot candle
var float refHigh = na
var float refLow  = na
var float lastBrokenHigh = na
var float lastBrokenLow  = na

// Internal structure vars
var float iWatchHigh = na
var int   iWatchHighBar = na
var float iWatchLow = na
var int   iWatchLowBar = na
var float iRefHigh = na
var float iRefLow = na

// =============================================================================
// HISTORY MANAGEMENT ARRAYS
// =============================================================================
var array<line> histLines = array.new_line(0)
var array<label> histLabels = array.new_label(0)
var array<line> histVertLines = array.new_line(0)

// Zone box arrays. Each zone type keeps its geometry/state in parallel arrays
// alongside the box objects themselves, since Pine arrays can't hold structs.
var array<box>   obBox    = array.new_box(0)
var array<float> obTop    = array.new_float(0)
var array<float> obBottom = array.new_float(0)
var array<bool>  obIsBull = array.new_bool(0)
var array<int>   obState  = array.new_int(0)   // 0 = active/growing, 1 = touched/faded

var array<box>   fvgBox    = array.new_box(0)
var array<float> fvgTop    = array.new_float(0)
var array<float> fvgBottom = array.new_float(0)
var array<bool>  fvgIsBull = array.new_bool(0)
var array<int>   fvgState  = array.new_int(0)

var array<float> pivHighVals = array.new_float(0)
var array<int>   pivHighBars = array.new_int(0)
var array<float> pivLowVals  = array.new_float(0)
var array<int>   pivLowBars  = array.new_int(0)

var array<box>   liqBox      = array.new_box(0)
var array<float> liqTop      = array.new_float(0)
var array<float> liqBottom   = array.new_float(0)
var array<bool>  liqBuySide  = array.new_bool(0)   // true = equal highs (above price), false = equal lows (below)
var array<int>   liqState    = array.new_int(0)

// Birth-confluence bucket (0, 1, or 2 — "2" means 2-or-more) for each zone,
// parallel to the arrays above. Set once at creation, used to file the zone's
// eventual hit/miss outcome into the right bucket below.
var array<int> obConfBucket  = array.new_int(0)
var array<int> fvgConfBucket = array.new_int(0)
var array<int> liqConfBucket = array.new_int(0)

// Pooled across all three zone types, indexed by birth-confluence bucket
// (0 / 1 / 2+): how many zones born at that confluence level have resolved so
// far, and how many of those were actually touched before failing/expiring.
// This is the entire "historical hit-rate" — a running frequency count, not a
// model.
var array<int> confTotal = array.new_int(3, 0)
var array<int> confHit   = array.new_int(3, 0)

// Counts active zones in the given parallel top/bottom arrays whose price
// range overlaps [top, bot] AND whose bias flag equals matchBias — so callers
// can restrict the count to same-directional-bias boxes only.
overlapCount(float top, float bot, array<float> tops, array<float> bots, array<bool> biasArr, bool matchBias) =>
    int n = 0
    if array.size(tops) > 0
        for k = 0 to array.size(tops) - 1
            if array.get(biasArr, k) == matchBias
                float t = array.get(tops, k)
                float b = array.get(bots, k)
                if b <= top and bot <= t
                    n += 1
    n

// Files one resolved zone's outcome into its birth-confluence bucket.
logOutcome(int bucket, bool hit) =>
    array.set(confTotal, bucket, array.get(confTotal, bucket) + 1)
    if hit
        array.set(confHit, bucket, array.get(confHit, bucket) + 1)

deleteOldest() =>
    if maxHistory > 0
        while array.size(histLines) > maxHistory
            line.delete(array.shift(histLines))
        while array.size(histLabels) > maxHistory
            label.delete(array.shift(histLabels))
        while array.size(histVertLines) > maxHistory
            line.delete(array.shift(histVertLines))

// =============================================================================
// SWING DETECTION
// =============================================================================
if not na(ph)
    bool bigEnough = not useAtrFilter or na(refLow) or (ph - refLow) >= atrMult * atrVal
    if bigEnough
        watchHigh     := ph
        watchHighBar  := bar_index - swingLen
        watchHighBody := math.max(open[swingLen], close[swingLen])
        refHigh       := ph

if not na(pl)
    bool bigEnough = not useAtrFilter or na(refHigh) or (refHigh - pl) >= atrMult * atrVal
    if bigEnough
        watchLow     := pl
        watchLowBar  := bar_index - swingLen
        watchLowBody := math.min(open[swingLen], close[swingLen])
        refLow       := pl

// Anchor to true leg extreme
if not na(watchHigh) and high > watchHigh and close <= watchHigh
    watchHigh    := high
    watchHighBar := bar_index
if not na(watchLow) and low < watchLow and close >= watchLow
    watchLow    := low
    watchLowBar := bar_index

// Internal swing detection
if useInternal
    if not na(iPh)
        bool iBig = not useAtrFilter or na(iRefLow) or (iPh - iRefLow) >= atrMult * atrVal * 0.5
        if iBig
            iWatchHigh    := iPh
            iWatchHighBar := bar_index - intSwingLen
            iRefHigh      := iPh
    if not na(iPl)
        bool iBig = not useAtrFilter or na(iRefHigh) or (iRefHigh - iPl) >= atrMult * atrVal * 0.5
        if iBig
            iWatchLow    := iPl
            iWatchLowBar := bar_index - intSwingLen
            iRefLow      := iPl
    if not na(iWatchHigh) and high > iWatchHigh and close <= iWatchHigh
        iWatchHigh    := high
        iWatchHighBar := bar_index
    if not na(iWatchLow) and low < iWatchLow and close >= iWatchLow
        iWatchLow    := low
        iWatchLowBar := bar_index

// ---------------------------- Break candidate --------------------------------
float upRef   = strictBreak ? math.min(open, close) : close
float downRef = strictBreak ? math.max(open, close) : close
float clearance = useStrength ? strengthMult * atrVal : 0.0

float candleRange = high - low
float candleBody  = math.abs(close - open)
bool  hasDisplace = not useDisplace or (candleRange >= displaceMult * atrVal and (not useBodyRatio or candleBody >= candleRange * 0.5))
bool  hasVolume   = not mUseVolume or na(volAvg) or volume >= volAvg * mVolMult

// ---------------------------- Confidence scoring -----------------------------
// Grades a break 0-100 across five INDEPENDENT measures. Independence matters:
// stacking three tests of "was the candle big?" adds lag without adding
// information, whereas clearance / size / conviction / participation / leg
// context each describe something the others cannot see.
//
// Contains no ta.* calls, so it is safe to call conditionally.
// Clamp a raw measurement to the 0-1 fraction of its full-marks target.
frac01(float v, float target) => math.min(1.0, math.max(0.0, v / math.max(target, 0.0001)))

scoreBreak(bool isUp, float lvl) =>
    float sc = 0.0
    if atrVal > 0 and not na(lvl)
        // Each component yields a 0-1 fraction, scaled by its normalised weight.

        // 1. Clearance beyond the level.
        sc += frac01((isUp ? upRef - lvl : lvl - downRef) / atrVal, tClear) * wClear * wNorm

        // 2. Displacement of the breaking candle.
        sc += frac01(candleRange / atrVal, tDisp) * wDisp * wNorm

        // 3. Body conviction. Scored from 35% body upward, so a long-wicked
        //    rejection candle earns nothing here even if its range was large.
        float bodyPct = candleRange > 0 ? candleBody / candleRange : 0.0
        sc += frac01(bodyPct - 0.35, math.max(tBody - 0.35, 0.01)) * wBody * wNorm

        // 4. Volume participation. Falls back to a neutral half-score when
        //    volume is missing, so feeds without real volume are not penalised.
        float volFrac = 0.5
        if not na(volAvg) and volAvg > 0
            volFrac := frac01(volume / volAvg - 0.70, math.max(tVol - 0.70, 0.01))
        sc += volFrac * wVol * wNorm

        // 5. Size of the leg being broken — the only component that reads
        //    structural context rather than the breaking candle itself.
        //    na propagates through arithmetic, so an absent reference simply
        //    leaves legRaw na and the neutral half-score stands.
        float legFrac = 0.5
        float legRaw = isUp ? lvl - refLow : refHigh - lvl
        if not na(legRaw)
            legFrac := frac01(legRaw / atrVal, tLeg)
        sc += legFrac * wLeg * wNorm
    math.round(sc)

var int lastBreakBar = na
bool coolOk = cooldownBars == 0 or na(lastBreakBar) or (bar_index - lastBreakBar) >= cooldownBars

float eqTol = useEqualTol ? equalTolMult * atrVal : 0.0

// Wick rejection: wick beyond level larger than body beyond level
bool wickOkUp   = not mUseWickReject or na(watchHigh) or (high - math.max(open, close)) <= math.max(close - watchHigh, 0.0)
bool wickOkDown = not mUseWickReject or na(watchLow)  or (math.min(open, close) - low)  <= math.max(watchLow - close, 0.0)

bool trendOkUp   = not mUseTrendFilter or close > emaVal
bool trendOkDown = not mUseTrendFilter or close < emaVal

bool rawUp   = not na(watchHigh) and upRef   > watchHigh + clearance
bool rawDown = not na(watchLow)  and downRef < watchLow  - clearance

bool upNotDup   = na(lastBrokenHigh) or na(watchHigh) or math.abs(watchHigh - lastBrokenHigh) > eqTol
bool downNotDup = na(lastBrokenLow)  or na(watchLow)  or math.abs(watchLow  - lastBrokenLow)  > eqTol

bool candUp   = rawUp   and hasDisplace and hasVolume and coolOk and upNotDup   and wickOkUp   and trendOkUp   and inSession
bool candDown = rawDown and hasDisplace and hasVolume and coolOk and downNotDup and wickOkDown and trendOkDown and inSession

// Score the candidates, then apply the minimum-score gate.
float scoreUp   = candUp   ? scoreBreak(true,  watchHigh) : 0.0
float scoreDown = candDown ? scoreBreak(false, watchLow)  : 0.0
if useScore and minScore > 0
    candUp   := candUp   and scoreUp   >= minScore
    candDown := candDown and scoreDown >= minScore

// Internal break candidates
bool iRawUp   = useInternal and not na(iWatchHigh) and close > iWatchHigh
bool iRawDown = useInternal and not na(iWatchLow)  and close < iWatchLow
bool iCandUp  = iRawUp  and hasDisplace and hasVolume and trendOkUp   and inSession
bool iCandDown= iRawDown and hasDisplace and hasVolume and trendOkDown and inSession

// ---------------------------- Smart confirmation delay -----------------------
var int   pendDir   = 0      // 1 up, -1 down, 0 none
var int   pendBar   = na
var float pendLevel = na
var int   pendLevelBar = na
var float pendClearance = 0.0
var float pendScore = 0.0

bool fireUp   = false
bool fireDown = false
float fireLevel = na
int   fireLevelBar = na
float fireClearance = 0.0
float fireScore = 0.0

if confirmBars == 0
    fireUp   := candUp
    fireDown := candDown
    fireLevel := candUp ? watchHigh : candDown ? watchLow : na
    fireLevelBar := candUp ? watchHighBar : candDown ? watchLowBar : na
    // Guarded against a zero/na ATR, which the other two call sites already were.
    fireClearance := atrVal > 0 ? (candUp ? (upRef - watchHigh) / atrVal : candDown ? (watchLow - downRef) / atrVal : 0.0) : 0.0
    fireScore := candUp ? scoreUp : candDown ? scoreDown : 0.0
else
    // Cancel or upgrade pending breaks
    if pendDir == 1
        bool cancelled = close < pendLevel - eqTol or candDown
        bool upgraded  = candUp and not na(watchHigh) and watchHigh > pendLevel + eqTol
        if cancelled or upgraded
            pendDir := 0
            pendBar := na
            pendLevel := na
            pendLevelBar := na
            pendClearance := 0.0
            pendScore := 0.0
            if upgraded
                pendDir := 1
                pendBar := bar_index
                pendLevel := watchHigh
                pendLevelBar := watchHighBar
                pendClearance := atrVal > 0 ? (upRef - watchHigh) / atrVal : 0.0
                pendScore := scoreUp
    else if pendDir == -1
        bool cancelled = close > pendLevel + eqTol or candUp
        bool upgraded  = candDown and not na(watchLow) and watchLow < pendLevel - eqTol
        if cancelled or upgraded
            pendDir := 0
            pendBar := na
            pendLevel := na
            pendLevelBar := na
            pendClearance := 0.0
            pendScore := 0.0
            if upgraded
                pendDir := -1
                pendBar := bar_index
                pendLevel := watchLow
                pendLevelBar := watchLowBar
                pendClearance := atrVal > 0 ? (watchLow - downRef) / atrVal : 0.0
                pendScore := scoreDown

    // Start new pending if none active
    if pendDir == 0
        if candUp
            pendDir := 1
            pendBar := bar_index
            pendLevel := watchHigh
            pendLevelBar := watchHighBar
            pendClearance := atrVal > 0 ? (upRef - watchHigh) / atrVal : 0.0
            pendScore := scoreUp
        else if candDown
            pendDir := -1
            pendBar := bar_index
            pendLevel := watchLow
            pendLevelBar := watchLowBar
            pendClearance := atrVal > 0 ? (watchLow - downRef) / atrVal : 0.0
            pendScore := scoreDown

    // Check for confirmation
    if pendDir != 0 and bar_index - pendBar >= confirmBars
        bool stillUp   = pendDir ==  1 and close > pendLevel
        bool stillDown = pendDir == -1 and close < pendLevel
        if stillUp
            fireUp := true
            fireLevel := pendLevel
            fireLevelBar := pendLevelBar
            fireClearance := pendClearance
            fireScore := pendScore
        if stillDown
            fireDown := true
            fireLevel := pendLevel
            fireLevelBar := pendLevelBar
            fireClearance := pendClearance
            fireScore := pendScore
        pendDir := 0
        pendBar := na
        pendLevel := na
        pendLevelBar := na
        pendClearance := 0.0
        pendScore := 0.0

// ---------------------------- State machine ----------------------------------
var int bias = 0

drawBreak(bool isUp, float lvl, int lvlBar, float clr, float scr, string txt, color col, string lStyle, int lWidth, int lExtendBars, bool lVert, bool showLine) =>
    deleteOldest()
    string labelText = txt
    if verboseLabels and atrVal > 0
        string sign = isUp ? "+" : "-"
        labelText := labelText + " " + sign + str.tostring(math.abs(clr), "#.#")
    if useScore and showScore
        labelText := labelText + " " + str.tostring(scr, "#")
    // Fade weak breaks so strong structure reads at a glance. 40 and below is
    // drawn faint, 90 and above solid.
    int fade = useScore and scoreColors ? int(math.round(math.min(60.0, math.max(0.0, (90.0 - scr) * 1.2)))) : 0
    color drawCol = color.new(col, fade)
    if showLabels
        label lbl = label.new(bar_index, isUp ? high + atrVal * 0.6 : low - atrVal * 0.6, labelText,
             style = isUp ? label.style_label_down : label.style_label_up,
             color = color.new(color.black, 15), textcolor = drawCol, size = lblSize)
        array.push(histLabels, lbl)
    if showLine
        int rightBar = lExtendBars > 0 ? bar_index + lExtendBars : bar_index
        line ln = line.new(lvlBar, lvl, rightBar, lvl,
             color = drawCol, style = styleOf(lStyle), width = lWidth)
        array.push(histLines, ln)
        if lVert
            line vln = line.new(bar_index, lvl, bar_index, isUp ? high + atrVal * 0.4 : low - atrVal * 0.4,
                 color = color.new(col, math.min(90, fade + 45)), style = line.style_dotted, width = 1)
            array.push(histVertLines, vln)

if fireUp and not na(fireLevel)
    bool isChoch = bias <= 0
    color col    = isChoch ? colCHoCH : colBOS
    bool  drawIt = isChoch ? showCHoCHLines : showBOSLines
    string txt   = isChoch ? "CHoCH" : "BOS"

    drawBreak(true, fireLevel, fireLevelBar, fireClearance, fireScore, txt, col,
         isChoch ? chochLineStyle : bosLineStyle,
         isChoch ? chochLineWidth : bosLineWidth,
         isChoch ? effChochExtend : effBosExtend,
         isChoch ? chochVertical : bosVertical,
         drawIt)

    // v5 FIX: reset opposite duplicate filter so old levels don't block new structure
    lastBrokenHigh := fireLevel
    lastBrokenLow  := na
    bias           := 1
    lastBreakBar   := bar_index
    watchHigh      := na
    watchHighBar   := na
    watchLow       := na
    watchLowBar    := na
    // v5 FIX: reset ATR references so next leg is evaluated fresh
    refHigh        := na
    refLow         := na

if fireDown and not na(fireLevel)
    bool isChoch = bias >= 0
    color col    = isChoch ? colCHoCH : colBOS
    bool  drawIt = isChoch ? showCHoCHLines : showBOSLines
    string txt   = isChoch ? "CHoCH" : "BOS"

    drawBreak(false, fireLevel, fireLevelBar, fireClearance, fireScore, txt, col,
         isChoch ? chochLineStyle : bosLineStyle,
         isChoch ? chochLineWidth : bosLineWidth,
         isChoch ? effChochExtend : effBosExtend,
         isChoch ? chochVertical : bosVertical,
         drawIt)

    // v5 FIX: reset opposite duplicate filter
    lastBrokenLow  := fireLevel
    lastBrokenHigh := na
    bias           := -1
    lastBreakBar   := bar_index
    watchLow       := na
    watchLowBar    := na
    watchHigh      := na
    watchHighBar   := na
    // v5 FIX: reset ATR references
    refHigh        := na
    refLow         := na

// ---------------------------- Order blocks (creation) ------------------------
// The order block is the last opposite-coloured candle before the impulse that
// just broke structure — searched backward from the break bar, capped at
// effObLookback so a slow grind doesn't attribute the break to a candle from
// unrelated prior structure.
if useOB and fireUp
    int   obOffset = na
    float obTopVal = na
    float obBotVal = na
    for i = 1 to effObLookback
        if close[i] < open[i]
            obOffset := i
            obTopVal := high[i]
            obBotVal := low[i]
            break
    if not na(obOffset)
        int obConf = useConfluence ? math.min(2, overlapCount(obTopVal, obBotVal, fvgTop, fvgBottom, fvgIsBull, true) + overlapCount(obTopVal, obBotVal, liqTop, liqBottom, liqBuySide, false)) : 0
        string obTxt = "Bull OB" + (useConfluence ? " · " + str.tostring(obConf) + (obConf >= 2 ? "+ conf" : " conf") : "")
        box ob = box.new(bar_index - obOffset, obTopVal, bar_index + effObExtend, obBotVal,
             border_color = color.new(zoneBullColor, zoneOpacity), border_width = 1,
             bgcolor = color.new(zoneBullColor, math.min(95, zoneOpacity + 8)),
             text = obTxt, text_size = size.tiny, text_color = color.white)
        array.push(obBox, ob)
        array.push(obTop, obTopVal)
        array.push(obBottom, obBotVal)
        array.push(obIsBull, true)
        array.push(obState, 0)
        array.push(obConfBucket, obConf)
        if array.size(obBox) > zoneMaxPerType
            logOutcome(array.get(obConfBucket, 0), array.get(obState, 0) == 1)
            box.delete(array.shift(obBox))
            array.shift(obTop)
            array.shift(obBottom)
            array.shift(obIsBull)
            array.shift(obState)
            array.shift(obConfBucket)

if useOB and fireDown
    int   obOffset = na
    float obTopVal = na
    float obBotVal = na
    for i = 1 to effObLookback
        if close[i] > open[i]
            obOffset := i
            obTopVal := high[i]
            obBotVal := low[i]
            break
    if not na(obOffset)
        int obConf = useConfluence ? math.min(2, overlapCount(obTopVal, obBotVal, fvgTop, fvgBottom, fvgIsBull, false) + overlapCount(obTopVal, obBotVal, liqTop, liqBottom, liqBuySide, true)) : 0
        string obTxt = "Bear OB" + (useConfluence ? " · " + str.tostring(obConf) + (obConf >= 2 ? "+ conf" : " conf") : "")
        box ob = box.new(bar_index - obOffset, obTopVal, bar_index + effObExtend, obBotVal,
             border_color = color.new(zoneBearColor, zoneOpacity), border_width = 1,
             bgcolor = color.new(zoneBearColor, math.min(95, zoneOpacity + 8)),
             text = obTxt, text_size = size.tiny, text_color = color.white)
        array.push(obBox, ob)
        array.push(obTop, obTopVal)
        array.push(obBottom, obBotVal)
        array.push(obIsBull, false)
        array.push(obState, 0)
        array.push(obConfBucket, obConf)
        if array.size(obBox) > zoneMaxPerType
            logOutcome(array.get(obConfBucket, 0), array.get(obState, 0) == 1)
            box.delete(array.shift(obBox))
            array.shift(obTop)
            array.shift(obBottom)
            array.shift(obIsBull)
            array.shift(obState)
            array.shift(obConfBucket)

// ---------------------------- Internal structure breaks ----------------------
if useInternal
    if iCandUp and not na(iWatchHigh)
        bool iIsChoch = bias <= 0
        color iCol = iIsChoch ? colCHoCH : colBOS
        string iTxt = iIsChoch ? "i-CHoCH" : "i-BOS"
        if showLabels
            label.new(bar_index, high + atrVal * 0.3, iTxt,
                 style = label.style_label_down, color = color.new(color.black, 15),
                 textcolor = color.new(iCol, intTransparency), size = size.tiny)
        line.new(iWatchHighBar, iWatchHigh, bar_index + effIntExtend, iWatchHigh,
             color = color.new(iCol, intTransparency), style = line.style_dotted,
             width = intLineWidth)
        iWatchHigh := na
        iWatchHighBar := na
        iWatchLow := na
        iWatchLowBar := na
        iRefHigh := na
        iRefLow := na

    if iCandDown and not na(iWatchLow)
        bool iIsChoch = bias >= 0
        color iCol = iIsChoch ? colCHoCH : colBOS
        string iTxt = iIsChoch ? "i-CHoCH" : "i-BOS"
        if showLabels
            label.new(bar_index, low - atrVal * 0.3, iTxt,
                 style = label.style_label_up, color = color.new(color.black, 15),
                 textcolor = color.new(iCol, intTransparency), size = size.tiny)
        line.new(iWatchLowBar, iWatchLow, bar_index + effIntExtend, iWatchLow,
             color = color.new(iCol, intTransparency), style = line.style_dotted,
             width = intLineWidth)
        iWatchLow := na
        iWatchLowBar := na
        iWatchHigh := na
        iWatchHighBar := na
        iRefHigh := na
        iRefLow := na

// ---------------------------- Unconfirmed preview ----------------------------
var line pendLine = na
if showUnconfirmed and confirmBars > 0
    if pendDir != 0 and not na(pendLevel)
        line.delete(pendLine)
        color pendCol = pendDir == 1 ? color.new(colBOS, 75) : color.new(colCHoCH, 75)
        pendLine := line.new(pendLevelBar, pendLevel, bar_index, pendLevel,
             color = pendCol, style = line.style_dotted, width = 1)
    else
        line.delete(pendLine)
        pendLine := na
else
    line.delete(pendLine)
    pendLine := na

// ---------------------------- Live levels ------------------------------------
var line liveHiLine = na
var line liveLoLine = na
var box  liveHiZone = na
var box  liveLoZone = na

// Read by the status table below. Recomputed to na every bar and only ever
// set inside the barstate.islast block, same pattern as fireLevel/fireScore.
float resConfluence = na
float resHitRate    = na
int   resHitN       = 0
float supConfluence = na
float supHitRate    = na
int   supHitN       = 0

if barstate.islast
    line.delete(liveHiLine)
    line.delete(liveLoLine)
    box.delete(liveHiZone)
    box.delete(liveLoZone)
    if showLiveLv and not na(watchHigh)
        liveHiLine := line.new(watchHighBar, watchHigh, bar_index + 20, watchHigh,
             color = color.new(colBOS, 60), style = line.style_dotted, width = 1)
    if showLiveLv and not na(watchLow)
        liveLoLine := line.new(watchLowBar, watchLow, bar_index + 20, watchLow,
             color = color.new(colCHoCH, 60), style = line.style_dotted, width = 1)
    // Swing zones: the watched high/low shown as a wick-to-body box rather than
    // a single price line, so the whole area price needs to clear is visible.
    if showSwingZones and not na(watchHigh) and not na(watchHighBody)
        float resTop = watchHigh
        float resBot = math.min(watchHighBody, watchHigh)
        string resTxt = "Resistance"
        if useConfluence
            resConfluence := overlapCount(resTop, resBot, obTop, obBottom, obIsBull, false) + overlapCount(resTop, resBot, fvgTop, fvgBottom, fvgIsBull, false) + overlapCount(resTop, resBot, liqTop, liqBottom, liqBuySide, true)
            int resBucket = int(math.min(2, resConfluence))
            resHitN := array.get(confTotal, resBucket)
            resHitRate := resHitN > 0 ? 100.0 * array.get(confHit, resBucket) / resHitN : na
            resTxt := resTxt + " · " + str.tostring(int(resConfluence)) + " conf" + (na(resHitRate) ? "" : " · " + str.tostring(resHitRate, "#") + "% (n=" + str.tostring(resHitN) + ")")
        liveHiZone := box.new(watchHighBar, resTop, bar_index + effSwingExtend, resBot,
             border_color = color.new(zoneBearColor, zoneOpacity), border_width = 1, border_style = line.style_dashed,
             bgcolor = color.new(zoneBearColor, math.min(95, zoneOpacity + 8)),
             text = resTxt, text_size = size.tiny, text_color = color.white)
    if showSwingZones and not na(watchLow) and not na(watchLowBody)
        float supTop = math.max(watchLowBody, watchLow)
        float supBot = watchLow
        string supTxt = "Support"
        if useConfluence
            supConfluence := overlapCount(supTop, supBot, obTop, obBottom, obIsBull, true) + overlapCount(supTop, supBot, fvgTop, fvgBottom, fvgIsBull, true) + overlapCount(supTop, supBot, liqTop, liqBottom, liqBuySide, false)
            int supBucket = int(math.min(2, supConfluence))
            supHitN := array.get(confTotal, supBucket)
            supHitRate := supHitN > 0 ? 100.0 * array.get(confHit, supBucket) / supHitN : na
            supTxt := supTxt + " · " + str.tostring(int(supConfluence)) + " conf" + (na(supHitRate) ? "" : " · " + str.tostring(supHitRate, "#") + "% (n=" + str.tostring(supHitN) + ")")
        liveLoZone := box.new(watchLowBar, supTop, bar_index + effSwingExtend, supBot,
             border_color = color.new(zoneBullColor, zoneOpacity), border_width = 1, border_style = line.style_dashed,
             bgcolor = color.new(zoneBullColor, math.min(95, zoneOpacity + 8)),
             text = supTxt, text_size = size.tiny, text_color = color.white)

// =============================================================================
// SMART MONEY ZONES — order block / FVG / liquidity lifecycle
// =============================================================================

// ---------------------------- Order blocks (mitigation) ----------------------
// Runs every bar: grows the box while untested, fades it the first time price
// wicks back in, deletes it once price CLOSES all the way through (invalidated).
if useOB and array.size(obBox) > 0
    for i = array.size(obBox) - 1 to 0
        box   b    = array.get(obBox, i)
        float top  = array.get(obTop, i)
        float bot  = array.get(obBottom, i)
        bool  bull = array.get(obIsBull, i)
        int   st   = array.get(obState, i)

        bool invalidated = bull ? close < bot : close > top
        bool touched     = bull ? low <= top : high >= bot

        if invalidated
            if useConfluence
                logOutcome(array.get(obConfBucket, i), touched or st == 1)
            box.delete(b)
            array.remove(obBox, i)
            array.remove(obTop, i)
            array.remove(obBottom, i)
            array.remove(obIsBull, i)
            array.remove(obState, i)
            array.remove(obConfBucket, i)
        else if touched and st == 0
            array.set(obState, i, 1)
            color c = bull ? zoneBullColor : zoneBearColor
            box.set_bgcolor(b, color.new(c, math.min(95, zoneOpacity + zoneFadeExtra + 8)))
            box.set_border_color(b, color.new(c, math.min(95, zoneOpacity + zoneFadeExtra)))
            box.set_right(b, bar_index)
            box.set_text(b, (bull ? "Bull OB" : "Bear OB") + " (tested)")
        else if st == 0
            box.set_right(b, bar_index + effObExtend)

// ---------------------------- Fair value gaps ---------------------------------
// Classic 3-candle imbalance: candle 1's wick doesn't overlap candle 3's wick.
if useFVG and atrVal > 0
    bool bullGap = low > high[2] and (low - high[2]) >= fvgMinSize * atrVal
    bool bearGap = high < low[2] and (low[2] - high) >= fvgMinSize * atrVal

    if bullGap
        float gapTop = low
        float gapBot = high[2]
        int fvgConf = useConfluence ? math.min(2, overlapCount(gapTop, gapBot, obTop, obBottom, obIsBull, true) + overlapCount(gapTop, gapBot, liqTop, liqBottom, liqBuySide, false)) : 0
        string fvgTxt = "Bull FVG" + (useConfluence ? " · " + str.tostring(fvgConf) + (fvgConf >= 2 ? "+ conf" : " conf") : "")
        box g = box.new(bar_index - 2, gapTop, bar_index + effFvgExtend, gapBot,
             border_color = color.new(zoneBullColor, zoneOpacity), border_width = 1, border_style = line.style_dotted,
             bgcolor = color.new(zoneBullColor, math.min(95, zoneOpacity + 8)),
             text = fvgTxt, text_size = size.tiny, text_color = color.white)
        array.push(fvgBox, g)
        array.push(fvgTop, gapTop)
        array.push(fvgBottom, gapBot)
        array.push(fvgIsBull, true)
        array.push(fvgState, 0)
        array.push(fvgConfBucket, fvgConf)
        if fvgShowMidline
            line.new(bar_index - 2, (gapTop + gapBot) / 2, bar_index + effFvgExtend, (gapTop + gapBot) / 2,
                 color = color.new(zoneBullColor, math.max(0, zoneOpacity - 10)), style = line.style_dotted, width = 1)
        if array.size(fvgBox) > zoneMaxPerType
            logOutcome(array.get(fvgConfBucket, 0), array.get(fvgState, 0) == 1)
            box.delete(array.shift(fvgBox))
            array.shift(fvgTop)
            array.shift(fvgBottom)
            array.shift(fvgIsBull)
            array.shift(fvgState)
            array.shift(fvgConfBucket)

    if bearGap
        float gapTop = low[2]
        float gapBot = high
        int fvgConf = useConfluence ? math.min(2, overlapCount(gapTop, gapBot, obTop, obBottom, obIsBull, false) + overlapCount(gapTop, gapBot, liqTop, liqBottom, liqBuySide, true)) : 0
        string fvgTxt = "Bear FVG" + (useConfluence ? " · " + str.tostring(fvgConf) + (fvgConf >= 2 ? "+ conf" : " conf") : "")
        box g = box.new(bar_index - 2, gapTop, bar_index + effFvgExtend, gapBot,
             border_color = color.new(zoneBearColor, zoneOpacity), border_width = 1, border_style = line.style_dotted,
             bgcolor = color.new(zoneBearColor, math.min(95, zoneOpacity + 8)),
             text = fvgTxt, text_size = size.tiny, text_color = color.white)
        array.push(fvgBox, g)
        array.push(fvgTop, gapTop)
        array.push(fvgBottom, gapBot)
        array.push(fvgIsBull, false)
        array.push(fvgState, 0)
        array.push(fvgConfBucket, fvgConf)
        if fvgShowMidline
            line.new(bar_index - 2, (gapTop + gapBot) / 2, bar_index + effFvgExtend, (gapTop + gapBot) / 2,
                 color = color.new(zoneBearColor, math.max(0, zoneOpacity - 10)), style = line.style_dotted, width = 1)
        if array.size(fvgBox) > zoneMaxPerType
            logOutcome(array.get(fvgConfBucket, 0), array.get(fvgState, 0) == 1)
            box.delete(array.shift(fvgBox))
            array.shift(fvgTop)
            array.shift(fvgBottom)
            array.shift(fvgIsBull)
            array.shift(fvgState)
            array.shift(fvgConfBucket)

// FVG lifecycle: grows while unfilled, fades on first wick back into the gap,
// deletes once price CLOSES all the way through it (fully filled).
if useFVG and array.size(fvgBox) > 0
    for i = array.size(fvgBox) - 1 to 0
        box   b    = array.get(fvgBox, i)
        float top  = array.get(fvgTop, i)
        float bot  = array.get(fvgBottom, i)
        bool  bull = array.get(fvgIsBull, i)
        int   st   = array.get(fvgState, i)

        bool filled  = bull ? low <= bot : high >= top
        bool touched = bull ? low <= top : high >= bot

        if filled
            if useConfluence
                logOutcome(array.get(fvgConfBucket, i), touched or st == 1)
            box.delete(b)
            array.remove(fvgBox, i)
            array.remove(fvgTop, i)
            array.remove(fvgBottom, i)
            array.remove(fvgIsBull, i)
            array.remove(fvgState, i)
            array.remove(fvgConfBucket, i)
        else if touched and st == 0
            array.set(fvgState, i, 1)
            color c = bull ? zoneBullColor : zoneBearColor
            box.set_bgcolor(b, color.new(c, math.min(95, zoneOpacity + zoneFadeExtra + 8)))
            box.set_border_color(b, color.new(c, math.min(95, zoneOpacity + zoneFadeExtra)))
            box.set_right(b, bar_index)
            box.set_text(b, (bull ? "Bull FVG" : "Bear FVG") + " (tested)")
        else if st == 0
            box.set_right(b, bar_index + effFvgExtend)

// ---------------------------- Liquidity zones ---------------------------------
// Equal highs/lows within tolerance mark resting liquidity. Uses the raw pivots
// (not the ATR-filtered structural swings) since equal-wick clustering is about
// literal price memory, not whether a swing was "big enough" to matter for BOS.
if useLiquidity and not na(ph)
    array.push(pivHighVals, ph)
    array.push(pivHighBars, bar_index - swingLen)
    while array.size(pivHighBars) > 0
        if bar_index - array.get(pivHighBars, 0) > effLiqLookback
            array.shift(pivHighVals)
            array.shift(pivHighBars)
        else
            break
    if atrVal > 0 and array.size(pivHighVals) > 1
        for j = array.size(pivHighVals) - 2 to 0
            float v = array.get(pivHighVals, j)
            if math.abs(ph - v) <= liqTol * atrVal
                float lTop = math.max(ph, v)
                float lBot = math.min(ph, v)
                int liqConf = useConfluence ? math.min(2, overlapCount(lTop, lBot, obTop, obBottom, obIsBull, false) + overlapCount(lTop, lBot, fvgTop, fvgBottom, fvgIsBull, false)) : 0
                string liqTxt = "Buy-side Liquidity" + (useConfluence ? " · " + str.tostring(liqConf) + (liqConf >= 2 ? "+ conf" : " conf") : "")
                box lb = box.new(array.get(pivHighBars, j), lTop, bar_index + effLiqExtend, lBot,
                     border_color = color.new(zoneBearColor, zoneOpacity), border_width = 1,
                     bgcolor = color.new(zoneBearColor, math.min(95, zoneOpacity + 10)),
                     text = liqTxt, text_size = size.tiny, text_color = color.white)
                array.push(liqBox, lb)
                array.push(liqTop, lTop)
                array.push(liqBottom, lBot)
                array.push(liqBuySide, true)
                array.push(liqState, 0)
                array.push(liqConfBucket, liqConf)
                if array.size(liqBox) > zoneMaxPerType
                    logOutcome(array.get(liqConfBucket, 0), array.get(liqState, 0) == 1)
                    box.delete(array.shift(liqBox))
                    array.shift(liqTop)
                    array.shift(liqBottom)
                    array.shift(liqBuySide)
                    array.shift(liqState)
                    array.shift(liqConfBucket)
                break

if useLiquidity and not na(pl)
    array.push(pivLowVals, pl)
    array.push(pivLowBars, bar_index - swingLen)
    while array.size(pivLowBars) > 0
        if bar_index - array.get(pivLowBars, 0) > effLiqLookback
            array.shift(pivLowVals)
            array.shift(pivLowBars)
        else
            break
    if atrVal > 0 and array.size(pivLowVals) > 1
        for j = array.size(pivLowVals) - 2 to 0
            float v = array.get(pivLowVals, j)
            if math.abs(pl - v) <= liqTol * atrVal
                float lTop = math.max(pl, v)
                float lBot = math.min(pl, v)
                int liqConf = useConfluence ? math.min(2, overlapCount(lTop, lBot, obTop, obBottom, obIsBull, true) + overlapCount(lTop, lBot, fvgTop, fvgBottom, fvgIsBull, true)) : 0
                string liqTxt = "Sell-side Liquidity" + (useConfluence ? " · " + str.tostring(liqConf) + (liqConf >= 2 ? "+ conf" : " conf") : "")
                box lb = box.new(array.get(pivLowBars, j), lTop, bar_index + effLiqExtend, lBot,
                     border_color = color.new(zoneBullColor, zoneOpacity), border_width = 1,
                     bgcolor = color.new(zoneBullColor, math.min(95, zoneOpacity + 10)),
                     text = liqTxt, text_size = size.tiny, text_color = color.white)
                array.push(liqBox, lb)
                array.push(liqTop, lTop)
                array.push(liqBottom, lBot)
                array.push(liqBuySide, false)
                array.push(liqState, 0)
                array.push(liqConfBucket, liqConf)
                if array.size(liqBox) > zoneMaxPerType
                    logOutcome(array.get(liqConfBucket, 0), array.get(liqState, 0) == 1)
                    box.delete(array.shift(liqBox))
                    array.shift(liqTop)
                    array.shift(liqBottom)
                    array.shift(liqBuySide)
                    array.shift(liqState)
                    array.shift(liqConfBucket)
                break

// Liquidity lifecycle: fades the moment price wicks through (a sweep attempt),
// deletes once a CLOSE beyond the level confirms it's actually been consumed —
// whether or not price reversed, the resting orders are gone either way.
if useLiquidity and array.size(liqBox) > 0
    for i = array.size(liqBox) - 1 to 0
        box   b    = array.get(liqBox, i)
        float top  = array.get(liqTop, i)
        float bot  = array.get(liqBottom, i)
        bool  buyS = array.get(liqBuySide, i)
        int   st   = array.get(liqState, i)

        bool swept    = buyS ? high >= top : low <= bot
        bool consumed = buyS ? close > top : close < bot

        if consumed
            if useConfluence
                logOutcome(array.get(liqConfBucket, i), swept or st == 1)
            box.delete(b)
            array.remove(liqBox, i)
            array.remove(liqTop, i)
            array.remove(liqBottom, i)
            array.remove(liqBuySide, i)
            array.remove(liqState, i)
            array.remove(liqConfBucket, i)
        else if swept and st == 0
            array.set(liqState, i, 1)
            color c = buyS ? zoneBearColor : zoneBullColor
            box.set_bgcolor(b, color.new(c, math.min(95, zoneOpacity + zoneFadeExtra + 10)))
            box.set_border_color(b, color.new(c, math.min(95, zoneOpacity + zoneFadeExtra)))
            box.set_text(b, (buyS ? "Buy-side Liquidity" : "Sell-side Liquidity") + " (swept)")
        else if st == 0
            box.set_right(b, bar_index + effLiqExtend)

// ---------------------------- Pivot markers ----------------------------------
plotshape(showPivots and not na(ph), title = "Swing High", location = location.abovebar,
     style = shape.triangledown, color = color.new(color.gray, 60), size = size.tiny, offset = -swingLen)
plotshape(showPivots and not na(pl), title = "Swing Low", location = location.belowbar,
     style = shape.triangleup, color = color.new(color.gray, 60), size = size.tiny, offset = -swingLen)

bgcolor(tintBias and bias ==  1 ? color.new(colBOS, 94) : na, title = "Bullish bias")
bgcolor(tintBias and bias == -1 ? color.new(colCHoCH, 94) : na, title = "Bearish bias")

// Candle coloring
barcolor(colorCandles ? (bias == 1 ? colBOS : bias == -1 ? colCHoCH : na) : na)

// ---------------------------- Status table -----------------------------------
var table st = table.new(position.top_right, 2, 10,
     border_width = 1, border_color = color.new(color.gray, 70), frame_width = 0)

// Remember the most recent score so the table can show it between breaks.
var float lastScore = na
if fireUp or fireDown
    lastScore := fireScore

if showTable and barstate.islast
    color  biasCol = bias == 1 ? colBOS : bias == -1 ? colCHoCH : color.gray
    string biasTxt = bias == 1 ? "Bullish" : bias == -1 ? "Bearish" : "Undefined"
    color  cellBg  = color.new(color.black, 20)

    table.cell(st, 0, 0, "Preset", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    table.cell(st, 1, 0, preset + (isCustom ? "" : " · " + str.tostring(sensDial)),
         text_color = color.white, text_size = size.tiny, bgcolor = cellBg)

    table.cell(st, 0, 1, "Bias", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    table.cell(st, 1, 1, biasTxt, text_color = biasCol, text_size = size.tiny, bgcolor = cellBg)

    table.cell(st, 0, 2, "Watch high", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    table.cell(st, 1, 2, na(watchHigh) ? "—" : str.tostring(watchHigh, format.mintick),
         text_color = colBOS, text_size = size.tiny, bgcolor = cellBg)

    table.cell(st, 0, 3, "Watch low", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    table.cell(st, 1, 3, na(watchLow) ? "—" : str.tostring(watchLow, format.mintick),
         text_color = colCHoCH, text_size = size.tiny, bgcolor = cellBg)

    table.cell(st, 0, 4, "Bars since break", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    table.cell(st, 1, 4, na(lastBreakBar) ? "—" : str.tostring(bar_index - lastBreakBar),
         text_color = color.white, text_size = size.tiny, bgcolor = cellBg)

    table.cell(st, 0, 5, "Swing / ATR", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    table.cell(st, 1, 5, str.tostring(swingLen) + " · " + str.tostring(atrVal, format.mintick),
         text_color = color.white, text_size = size.tiny, bgcolor = cellBg)

    table.cell(st, 0, 6, "Last score", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    color scoreCol = na(lastScore) ? color.gray : lastScore >= 75 ? color.lime : lastScore >= 55 ? color.yellow : color.orange
    table.cell(st, 1, 6, na(lastScore) ? "—" : str.tostring(lastScore, "#") + " / 100",
         text_color = scoreCol, text_size = size.tiny, bgcolor = cellBg)

    table.cell(st, 0, 7, "Pending", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    string pendTxt = pendDir == 1 ? "Up (" + str.tostring(bar_index - pendBar) + "/" + str.tostring(confirmBars) + ")" :
                     pendDir == -1 ? "Down (" + str.tostring(bar_index - pendBar) + "/" + str.tostring(confirmBars) + ")" : "—"
    color pendTxtCol = pendDir == 1 ? colBOS : pendDir == -1 ? colCHoCH : color.gray
    table.cell(st, 1, 7, pendTxt, text_color = pendTxtCol, text_size = size.tiny, bgcolor = cellBg)

    table.cell(st, 0, 8, "Resistance", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    string resCellTxt = na(resConfluence) ? "—" : str.tostring(int(resConfluence)) + " conf" + (na(resHitRate) ? "" : " · " + str.tostring(resHitRate, "#") + "% (n=" + str.tostring(resHitN) + ")")
    table.cell(st, 1, 8, resCellTxt, text_color = colCHoCH, text_size = size.tiny, bgcolor = cellBg)

    table.cell(st, 0, 9, "Support", text_color = color.gray, text_size = size.tiny, bgcolor = cellBg)
    string supCellTxt = na(supConfluence) ? "—" : str.tostring(int(supConfluence)) + " conf" + (na(supHitRate) ? "" : " · " + str.tostring(supHitRate, "#") + "% (n=" + str.tostring(supHitN) + ")")
    table.cell(st, 1, 9, supCellTxt, text_color = colBOS, text_size = size.tiny, bgcolor = cellBg)

// =============================================================================
// ALERTS
// =============================================================================
alertcondition(fireUp and bias <= 0,  title = "CHoCH Bullish", message = "CHoCH Bullish — structure reversal up on {{ticker}} @ {{close}}")
alertcondition(fireUp and bias > 0,   title = "BOS Bullish",   message = "BOS Bullish — continuation up on {{ticker}} @ {{close}}")
alertcondition(fireDown and bias >= 0, title = "CHoCH Bearish", message = "CHoCH Bearish — structure reversal down on {{ticker}} @ {{close}}")
alertcondition(fireDown and bias < 0,  title = "BOS Bearish",   message = "BOS Bearish — continuation down on {{ticker}} @ {{close}}")

// Retest alert: price returns to a recently broken level and holds it.
//
// A break that gets retested and holds is a higher-confidence event than the
// break itself, so these are worth more than the BOS/CHoCH alerts above.
var array<float> retestLevels = array.new_float(0)
var array<int>   retestBars   = array.new_int(0)
var array<bool>  retestIsHigh = array.new_bool(0)
var array<float> retestScores = array.new_float(0)
var array<bool>  retestUsed   = array.new_bool(0)

if fireUp and not na(fireLevel)
    array.push(retestLevels, fireLevel)
    array.push(retestBars, bar_index)
    array.push(retestIsHigh, true)
    array.push(retestScores, fireScore)
    array.push(retestUsed, false)
if fireDown and not na(fireLevel)
    array.push(retestLevels, fireLevel)
    array.push(retestBars, bar_index)
    array.push(retestIsHigh, false)
    array.push(retestScores, fireScore)
    array.push(retestUsed, false)

// Drop levels older than the retest window. A `while` here, not an `if`: the
// original single shift per bar could not keep up with bursts of breaks, so the
// arrays grew without bound on long histories.
// Size check and the age check are split across `while`/`if` rather than joined
// with `and` on one line: Pine's `and` evaluates both sides unconditionally, so
// array.get(retestBars, 0) would still run (and error) on an empty array even
// with array.size(retestBars) > 0 false on the same line.
while array.size(retestBars) > 0
    if bar_index - array.get(retestBars, 0) > effRetestWindow
        array.shift(retestLevels)
        array.shift(retestBars)
        array.shift(retestIsHigh)
        array.shift(retestScores)
        array.shift(retestUsed)
    else
        break

bool retestUp = false
bool retestDown = false
if barstate.isconfirmed and array.size(retestLevels) > 0
    for i = 0 to array.size(retestLevels) - 1
        int bBar = array.get(retestBars, i)
        // Skip levels already retested once, otherwise a level that price sits
        // on re-fires the alert every single bar.
        if not array.get(retestUsed, i) and bar_index - bBar > effRetestMinAge and bar_index - bBar < effRetestMaxAge
            float lvl  = array.get(retestLevels, i)
            bool  isHi = array.get(retestIsHigh, i)
            bool  scoreOk = not useScore or minScore == 0 or array.get(retestScores, i) >= minScore
            if scoreOk and atrVal > 0 and math.abs(close - lvl) < atrVal * 0.2
                if isHi and low <= lvl and close >= lvl
                    retestUp := true
                    array.set(retestUsed, i, true)
                if not isHi and high >= lvl and close <= lvl
                    retestDown := true
                    array.set(retestUsed, i, true)

alertcondition(retestUp,   title = "Retest Support",   message = "Price retesting broken support level on {{ticker}} @ {{close}}")
alertcondition(retestDown, title = "Retest Resistance", message = "Price retesting broken resistance level on {{ticker}} @ {{close}}")
